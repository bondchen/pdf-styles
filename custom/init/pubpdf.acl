#-----------------------shao-----------------------------------
function getNumber(s){
  local i;
  for(i=1;i<=length(s);i++){
  	local a = substr(s,i,1);
  	if( a<0 || a>9){
  		break;
  	}
  }
  return substr(s,1,i-1)*1;
}

function Azelea_Code_128_C(yourData){
  local temp;
  local checkDigitSubtotal;
  local i;
  local fontString;
  local chunk;
  fontString = chr(183);
  checkDigitSubtotal = 105;
  temp = yourData;
  for(i=1;i<=length(yourData)/2;i++){
  	 chunk = substr(temp, 1,2);
  	 local intChunk = getNumber(chunk);
    checkDigitSubtotal = checkDigitSubtotal +  intChunk * i
    if( intChunk ==0){
    	fontString = fontString . chr(206)
    } 
    if( 1<=intChunk && intChunk <=93){
    	fontString = fontString . chr(intChunk + 32)
    } 
    if( intChunk >93){
    	fontString = fontString . chr(intChunk + 103)
    } 
    
    temp = substr(temp, 3, length(temp) - 2)
  }

  checkDigitSubtotal = checkDigitSubtotal%103
	if( checkDigitSubtotal == 0){
		return fontString . chr(206) . chr(196)
	}
  if( checkDigitSubtotal <= 93 && checkDigitSubtotal >= 1 ){
		return fontString . chr(checkDigitSubtotal + 32) . chr(196)
	}
	if( checkDigitSubtotal > 93){
		return fontString . chr(checkDigitSubtotal + 103) . chr(196)
	}

}
