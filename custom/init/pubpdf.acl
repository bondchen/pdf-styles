# ---------------------------------------------------------------------
# Global storage
# ---------------------------------------------------------------------

# empty array used in place of batch_params[] for interactive calls:
global dummy[];

# global array used by recorded macro
global macroParams[];

# hardcoded array of supported encodings
global default_encodings[];

# used for changing the chunk control file used by the chunker.
global chunkerControlFile = "";

# Name of the java class/method used to configure ccf parsing
global ComposerProperties_CLASS =					\
  "com.arbortext.epic.internal.compose.ComposerProperties";

global setEntityResolver_METHOD = "setEntityResolver";

# change tracking hook:
#
# set at command line using "$compose::changetracking="[value]"
# where [value] is one of:
#  "nothighlighted"	- the default setting:  parse the document using the
#			  view specified by the viewchangetracking option,
#			  unless it is changeshighlighted, in which case use
#			  changesapplied;
#
#  "original"		- use the "original" view traversal
#  "changesapplied"	- use "changesapplied" traversal (latest version)
#  "changeshighlighted" - show all changetracking markup
#  "active"		- parse according to viewchangetracking option.
#
global changetracking="";

# verbose flag:
#
# When non-zero turns on diagnostics in the composer.  These will appear
# in the composer log window if the user enables the display of "info"
# level messages (View -> Display -> Messages) from the menu bar.
#
global verbose=0;

# debug flag:
#
# When non-zero turns on debug code (e.g. assertion checks, extra validation,
# etc.) in some filters.  Passed to all the filters as the parameter "debug"
# whose value is "true".  May or may not cause visible diagnostics to appear
# in the composer log.
#
# In addition this varaible controls tracing output in the compose modules
# via the function debug_out().
#
# Values:
# 0 - ignore
# 1 - add a warning to the event log
# 2 - show via dialog and add a warning to the event log
#
if ( !defined( compose::debug ) ) {
global debug=0;
}

# "big document" flag:
#
# Normally when we run a document through a content pipeline, either to
# apply profiling or to apply an XSL stylesheet, we build the output
# document in memory.
#
# For very large documents this uses too much memory.  So we sometimes
# need to write the output document to disk as we build it.
#
# The decision of whether to use small-document (build in memory) or
# large-document (build on disk) is controlled by this global and
# by the 'compose.serializePipelineOutput' parameter.
#
# Values:
#
# 0:  default behavior (consult 'compose.serializePipelineOutput')
# 1:  small-job        (build in memory)
# 2:  big-job          (build on disk)
global serializePipelineOutput=0;

# "DITA Map Big Job Multiplier" global variable
# Multiply the number of doc frags in a DITA map by this amount
# before comparing it with the bigjobthreshold value

if ( ! defined( ditaMapBigJobMultiplier ) ) {
    global ditaMapBigJobMultiplier = 80;
}

# Save area for value returned by postprocessing function when E3
# composition is used.
global e3PostprocessorRc=0;
# Global debug flag.  Set to 1 to force display of the composer log.
global alwaysShowLog = 0;

# Global debug flag.  Set to 1 to force vdoc to be written to disk.
global saveVdoc = 0;

# Debug flag for DITA.  Set to 1 for filter-global tracing, set to 2 for
# per-event tracing.
global ditaTraceLevel = 0;

# Debug flag for Replaceable References.
# Set to 0 for no tracing.
# Set to 1 for filter-global tracing.
# Set to 2 for per-event tracing.
global replRefTraceLevel = 0;

# Save area for 'compose.interactive' parameter value during pipeline
# run.  Suppresses information messages from the pipeline for non-interactive
# uses.
global pipelineInteractive = 0;

# In 6.0 M010 (2011 April 26) we corrected the default valign for
# theads in CALS/OASIS tables to be bottom instead of top.  However,
# if compose::cals_thead_default_top_align is set to 1, we revert
# to the old behavior of valign=top for theads.
global cals_thead_default_top_align=0;

