# ---------------------------------------------------------------------
# Function:	compose :: init
#
# Purpose:	called from ACL open code when this file is sourced.
#		initializes global variables
#
# Parameters:	none
#
# Result:	none
# ---------------------------------------------------------------------
function init() {
  # set up encodings array:
  default_encodings[ 1 ] = "UTF-8"
  default_encodings[ 2 ] = "ISO-8859-1";
  default_encodings[ 3 ] = "ISO-8859-2";
  default_encodings[ 4 ] = "ISO-8859-5";
  default_encodings[ 5 ] = "ISO-8859-7";
  default_encodings[ 6 ] = "ISO-8859-9";
  default_encodings[ 7 ] = "Windows-1252";
}

# ---------------------------------------------------------------------
# Function:	compose :: composer_set_catalog_path
#
# Purpose:	passes the name of an Epic option to the composer
#		properties resolver
#
# Parameters:	path option name (e.g., 'catalogpath')
#
# Result:	none
# ---------------------------------------------------------------------
function composer_set_catalog_path(path) {
  local result = java_static( ComposerProperties_CLASS,			\
			      setEntityResolver_METHOD,			\
			      path					\
			    );
}

# ---------------------------------------------------------------------
# Function:	compose :: copy_array
#
# Purpose:	copies the content of one associative array to another
#
# Parameters:	source:		array from which to copy
#		destination:	array to which to copy
#		doClear:	delete content of destination array
#
# Result:	none
# ---------------------------------------------------------------------
function copy_array( source[], destination[], doClear=1 ) {

  local item;

  if ( doClear ) {
    empty_array(destination);
  }

  for ( item in source ) {
    destination[ item ] = source[ item ];
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: param_init
#
# Purpose:	Initializes the global array that is used to collect
#		batch parameters to a composition function called during
#		executiong of a recorded macro.
#
# Parameters:	none
#
# Result:	none
# ---------------------------------------------------------------------
function param_init()
{
  # start of playback of a recorded composition
  mouse_set_waiting();
  empty_array(macroParams);
}

# ---------------------------------------------------------------------
# Function:	compose :: param
#
# Purpose:	sets one parameter in the global macroParams array.
#		This global array is used to collect batch parameters
#		to a composition function called during executiong of
#		a recorded macro.
#
# Parameters:	key:		key to set
#		value:		value for key
#
# Result:	none
# ---------------------------------------------------------------------
function param(key, value)
{
  macroParams[key] = value;
}

# ---------------------------------------------------------------------
# Function:	compose :: record_compose_cmd
#
# Purpose:	generate the commands needed to record the composition
#		command which just completed.
#
# Parameters:
#		doc:		document being composed
#		type:		compose type to derive function name to call
#		params:		associative array of parameters to record
#
# Result:	none
# ---------------------------------------------------------------------
function record_compose_cmd(doc, type, params[])
{
  # initialize array
  macro_record_cmd("compose::param_init()", doc);

  #copy_array(params, main::PARARR);	# debug

  local key;
  local installDir = universal_file_name(main::aptpath);
  local compRoot = main::comproot;

  for (key in params) {
    if (!(key in recordedParams)) {
      # ignore internal parameters that are derived at run time
      continue;
    }

    local value = params[key];
    # do not record key with no value
    if (value != "") {
      local cmd = 'compose::param("' . key . '", ';
      if (match(value, '^[0-9]+$')) {#'
	# value is integer
	if (key == "interactive") {
	  value = 0;	# turn off interactive flag
	}
	cmd .= value;
      }
      else {
	# value is a string which must be quoted
	if (key == "stylesheet" && "originalStylesheet" in params) {
	  # use stylesheet value entered on dialog
	  value = params["originalStylesheet"];
	}
 	else if (key == "outputDir") {
	  # some composition types use outputDir for intermediate files
 	  if (type != "dmp" && type != "dmpupd" && type != "web") {
 	    continue;	# ignore
 	  }
	}

	# try to use variable for some directory references
	local vardir;
	if (compRoot == substr(value, 1, length(compRoot))) {
	  # maybe a path on the PE server; paths_equal() is not used
	  # since the path will start with e3: if PE path name
	  vardir = '${main::comproot}';
	  value = substr(value, length(compRoot) + 1);
	}
	else if (paths_equal(main::aptpath, substr(value, 1, length(main::aptpath)))) {
	  # use variable for APTPATH for portability
	  vardir = '$main::aptpath';
	  value = substr(value, length(main::aptpath) + 1);
	}
	else if (paths_equal(installDir, substr(value, 1, length(installDir)))) {
	  # some code paths generate unc name for main::aptpath
	  vardir = compRoot == main::aptpath ? '$main::comproot' : '$main::aptpath';
	  value = substr(value, length(installDir) + 1);
	}

	else if (main::dirname && paths_equal(main::dirname, substr(value, 1, length(main::dirname)))) {
	  # path starts with document directory
	  vardir = '${main::dirname}';
	  value = substr(value, length(main::dirname) + 1);
	}
	else if (paths_equal(main::home, substr(value, 1, length(main::home)))) {
	  # path starts with home directory (which may include a trailing \)
	  vardir = '${main::home}';
	  value = substr(value, length(main::home) + 1);
	}
	if (main::PCS == "\\" && index(value, "\\")) {
	  # convert windows separators to unix style for portability
	  # [assumes any recorded parameter with a backslash is a path name]
	  gsub('[\\]', '/', value);
	}
	if (vardir && substr(value, 1, 1) != '/') {
	  local vpath = varsub(vardir);
	  if (substr(vpath, length(vpath), 1) == main::PCS) {
	    # variable ends with separator but value doesn't start with
	    # one so include in value in case vardir variable doesn't
	    # when run in another context/platform.
	    value = "/" . value;
	  }
	}

	# quote value parameter
	if (vardir || match(value, "[\\']")) {
	  # string contains \ or ' so must use double quotes, escaping
	  # special characters.
	  gsub('[$"\\]', '\\&', value);
	  cmd .= '"' . vardir . value . '"';
	}
	else {
	  # can quote with single quotes
	  cmd .= "'" . value . "'";
	}
      }

      cmd .= ")";
      macro_record_cmd(cmd, doc);
    }
  }

  # finally call the macro function
  macro_record_cmd("compose::compose_" . type . "_macro()", doc);
}

function create_array_from_logical_string( arr[], logicExpr="",         \
  doc=current_doc() )
{
  empty_array(arr);

  if (logicExpr == "") {
	   return 0;
	 }

	 # create scratch XML doc
	 local tempdoc = -1;
	 tempdoc = doc_open("", 0x40, "", "-//ArborText//DTD freeform//EN");

	 if (!doc_valid(tempdoc)) {
	   return 0;
	 }

	 current_doc(tempdoc);
	 insert(logicExpr, tempdoc);

	 local oids_arr[], i;

	 oid_find_children(oid_null(), oids_arr, "ProfileRef");

	 for (i in oids_arr) {
	   local alias_name = oid_attr(oids_arr[i], "alias");
	   local value =  oid_attr(oids_arr[i], "value");
	   local attr = profile_attr(alias_name, doc);
	   local sep = profile_value_separator(alias_name, doc);

	   if (attr != "" && value != "")
	   {
	     if (!defined(arr[ attr ]))
	     {
	       arr[ attr ] = value;
	     }
	     else
	     {
	       arr[ attr ] = arr[ attr ] . sep . value ;
	     }
	   }
	 }

	 doc_close(tempdoc);
	 current_doc(doc);
         debug_params( "After creating arr from logical string.", arr );
	 return 1;
}

# ---------------------------------------------------------------------
# Function:	get_doctype_id
#
# Purpose:	Gets the "doctype id" of the given doc.  This is the
#		public id OR the root namespace URI.
#
# Parameters:	doc:  document to query
#
# Result:	public id, root namespace URI, or empty string
# ---------------------------------------------------------------------
function get_doctype_id( doc ) {

  # First get the public id of this doc.
  local dtId = public_id( doc );
  if (dtId != "") {
    return dtId;
  }

  dtId = system_id( doc );
  if (dtId != "") {
    return dtId;
  }

  # No public ID; see if we have a namespace URI
  local oidRoot = oid_first_tag( doc );
  if ( oidRoot != oid_null() ) {

    # Can't easily use oid_namespace_uri() to get access to the uri of a
    # given oid.  oid_namespapce_info() does this however.
    local ns_uri;
    local ns_prefix;
    local ns_localname;
    oid_namespace_info(oidRoot, ns_uri, ns_prefix, ns_localname);

    dtId = ns_uri;
  }

  # If no namespace URI, look for 'no namespace schema location' attr
  if ( !dtId ) {
    local oidRoot = oid_first_tag( doc );

    if ( oidRoot != oid_null() ) {
      local prefix = oid_namespace_prefix( oidRoot,			\
			     'http://www.w3.org/2001/XMLSchema-instance' \
			   );

      if ( prefix ) {
        local attrName  = prefix . ':noNamespaceSchemaLocation';
	    local attrValue = oid_attr( oidRoot, attrName );

	    if ( attrValue ) {
	      dtId = attrValue;
	    }
      }
    }
  }

  # If still nothing and we have a freeform document, use the freeform
  # doctype
  if ( !dtId && doc_freeform( doc ) ) {
    dtId = "-//ArborText//DTD freeform//EN";
  }

  # If still nothing, try to use the system ID (there may be mappings
  # that'll translate a client system ID to a server system ID).
  if ( !dtId ) {
    dtId = system_id( doc );
  }

  return dtId;
}

# ======================================================================
# Function:             main::uses_dita_composition
#
# Returns 1 (true) if this doc uses any part of the dita composition
# pipeline, i.e., a dita map or topic (or specialization) or the
# hybrid resolved document for styling.
#
# Result:               1 uses some dita composition features
# ======================================================================

function main::uses_dita_composition(doc = 0)
{
  return doc_type_dita(doc) != 0 || doc_is_dita_rdstyle(doc);
}

# ======================================================================
# Function:             compose::is_rdstyle_doc
#
# Returns 1 (true) if this doc is an RDS, 0 otherwise. NOTE: This function
#         is called from core.
#
# Result:               1 if the document is an RDS.
# ======================================================================

function is_rdstyle_doc(doc=current_doc()) {
	return doc_is_dita_rdstyle(doc);
}


############################################################################
#
# code to support error and warning reporting:
#
############################################################################

# ======================================================================
# Function:             compose :: info
#			compose :: warning
#			compose :: error
#			compose :: fatal
#
# Purpose:              Log an message of a given severity to the
#			composer event log.
#
# Parameters:           msg - The message to add to the log.  This
#			should be localized already by the caller.
#
#			parse - a boolean: false (0) means do not parse the message
#					for markup; true (!=0) means do parse it
#
# Result:               none.
# ======================================================================

function info(msg, parse=0)
{
  _composerlog::add_record(eventlog::SEVERITY_INFO, msg, 0, -1, parse);
}

function warning(msg, parse=0)
{
  _composerlog::add_record(eventlog::SEVERITY_WARNING, msg, 0, -1, parse);
}

function error(msg, parse=0)
{
  _composerlog::add_record(eventlog::SEVERITY_ERROR, msg, 0, -1, parse);
}

function fatal(msg, parse=0)
{
  _composerlog::add_record(eventlog::SEVERITY_FATAL, msg, 0, -1, parse);
}

function internal_error(msg, parse=0)
{
  _composerlog::add_record(eventlog::SEVERITY_FATAL, msg, 2, -1, parse);
}

# ======================================================================
# Function:             compose::add_warning()
#
# Called by external processes to add a compose warning message to the
# composer log, and to pop up a panel with the warning in interactive
# mode.  Use this funtion only when the user must be alerted that the
# process may yield incorrect results.
#
# Result:               none.
# ======================================================================

function add_warning(msg, interactive=0)
{
    # put the warning message in the composer log
    warning(msg);

    # display the warning in a response panel
    if (interactive) {
	response(msg);
    }
}

# ======================================================================
# Function:             compose::set_errmessage()
#
# Called by external processes to set a compose error message
#
# Result:               none.
# ======================================================================

function set_errmessage(mess, interactive=0, parse=0)
{
    main::ERROR = mess;
    error(mess, parse);
    if (interactive) {
	response(mess);
    }
}

# ======================================================================
# Function:             compose::message(mess, [doc])
#
# Display a progress message without raising a popup dialog for
# messages that are too long.  This method will be used by the java
# layer to report status.
#
# Result:               none.
# ======================================================================

function message(mess, doc = -1)
  {
  local win;

  if (doc != -1) {
    win = doc_window(doc);
    }

  if (win == -1) {
    win = current_window();
    }

  epicutil::msg(mess, win);
  }

# ---------------------------------------------------------------------
# Function:	compose :: messageFromPipeline
#
# Purpose:	calls compose::message IF the global variable
#		pipelineInteractive allows doing so.
#
# Parameters:	mess:	message to display
#		doc:	document being formatted
#
# Result:	none
# ---------------------------------------------------------------------
function compose::messageFromPipeline( mess, doc = -1 ) {
  if ( pipelineInteractive ) {
    message( mess, doc );
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: msg
#
# Purpose:	displays a progress message without raising a popup
#		dialog for messages that are too long.
#
#		only displays a message if performing an interactive
#		composition operation OR a batch operation on behalf
#		of a publishing rule or rule set that was itself
#		invoked interactively.

#		this method is used by the ACL layer.
#
# Parameters:	msgText:	message to display
#		params[]:	composition parameters
#
# Result:	none
# ---------------------------------------------------------------------
function compose::msg( msgText, params[] ) {

  if ( params[ P_COMP_INTERACTIVE ] || params[ P_COMP_RULE_INTERACTIVE ] ) {
    epicutil::msg( msgText );
  }

}

# ---------------------------------------------------------------------
# Function:	compose::trace
#
# Purpose:	adds a message to the application trace and echoes
#		to the ATITrace window (Window) or standard output (Unix)
#
# Parameters:	traceObject:  object that is collecting information (ignored
#			      if this is the server side of a PE composition
#			      operation; may be null)
#		msg:	      message to write
#		addCaller:    1 to prepend calling routine to message
#
# Result:	none
# ---------------------------------------------------------------------
function compose::trace( traceObject, msg, addCaller=1 ) {

  # Construct complete message
  local ourMessage = msg;

  if ( addCaller == 1 ) {
    ourMessage = caller( 1 ) . ":  " . msg;
  }

  # If we're running on the PE server in response to a client pe-tie
  # request:
  if ( traceObject == -1 ) {
    PEAppConfig::info( ourMessage );
  }

  # If we're running on the client side or standalone, only save if
  # 'debugcomposition' was on (which will have given us a non-null
  # trace object)
  # if we started tracing when the operation began.
  else if ( traceObject != "" ) {
    java_instance( traceObject,						\
		   "trace",						\
		   ourMessage						\
		 );
  }
}

# ---------------------------------------------------------------------
# Function:	compose::traceArray
#
# Purpose:	writes deugging output that includes the value of an
#		associative array.
#
#		if we're running as the server side of a PE Composition
#		operation, writes to the application trace.
#
#		Otherwise, if 'debugcomposition' is on, we retrieve the
#		trace object from the array itself.
#
# Parameters:	traceObject:	object that generates output
#		msg:		message to write
#		array:		array to display
#
# Result:	none
# ------------------------------------------------ ---------------------
function compose::traceArray( traceObject, msg, array[] ) {

  # Echo the message
  compose::trace( traceObject, msg );

  # Construct a series of messages containing the array

  # First, build a string of blanks so we'll line up under the 'caller:  '
  # sequence already written
  local heading = caller( 1 ) . ":  ";

  local lspace = "";

  while ( length( lspace ) < length( heading ) ) {
    lspace .= " ";
  }

  # Obtain all of the keys in 'array'
  local keys[ count( array ) ];
  local next = 1;
  local k;

  for ( k in array ) {
    keys[ next ] = k;
    next += 1;
  }

  # Sort keys into ascending order, ignoring case
  qsort( keys, 1 );

  # Now display values for each key.
  local i;
  local keyLen = 20;

  for ( i = 1; i < next; i += 1 ) {
    local key   = keys[ i ];
    local value = array[ key ];

    while ( length( key ) < keyLen ) {
      key .= " ";
    }

    compose::trace( traceObject,					\
		    lspace . key . " ='" . value . "'",			\
		    0							\
		  );
  }
}

# ======================================================================
# Function:             compose::load_file(fileName, chopIt=0)
#
# Read contents of file into a string and return it.
#
#   			If chopIt is non-zero, chop() newlines.
#
# Result:               Contents of file
#			or "" if file not found.
# ======================================================================

function load_file(fileName, chopIt=0)
  {
  local file_contents = "";
  local fid = open( fileName, "r" );
  if ( fid >= 0 ) {
    local line;

    while ( getline( fid, line) ) {
      if (chopIt) { chop(line); }
      file_contents .= line;
    }

    close( fid );
    }

  return file_contents;
  }

############################################################################
#
# debugging support:
#
# Call compose::debug(val), where val is
#  0:  no debug output
#  1:  add as "warn" item to composer log
#  2:  prompt and add as "warn" item to composer log
#
# Note: by default, the composerlog will not "pop up" if it is only
# full of info items.  The user will need to call show_composer_log().
#
############################################################################

# ---------------------------------------------------------------------
# Function:	compose :: verbose
#
# Purpose:	sets the 'verbose' flag.
#
#		This adds the parameter param[ "verbose" ] = "true"
#		to every content pipeline just before execution, which
#		makes the framework emit "info" messages as it starts
#		and as it initializes each filter.
#
#		This also make some debugging output display more detail.
#
# Parameters:	val:	new value (defaults to 1)
#
# Result:	none
# ---------------------------------------------------------------------
function compose::verbose( val = 1 ) {
  verbose = val;
}

# ---------------------------------------------------------------------
# Function:	compose :: debug
#
# Purpose:	sets the 'debug' flag.  Legal values are:
#
#		0:  discard debug output
#		1:  add debug output as 'warn' items to the composer log
#		2:  also display debug output as response() panels
#
#		This also adds the paramter params[ "debug" ] = "true"
#		to every content pipeline just before execution, which
#		may make some filters execute extra code to check
#		validity.
#
# Parameters:	val:	new value (defaults to 1)
#
# Result:	none
# ---------------------------------------------------------------------
function compose::debug( val = 1 ) {
  debug = val;
}

# ---------------------------------------------------------------------
# Function:	compose :: debug_out
#
# Purpose:	displays a message as directed by the 'debug' flag
#
# Parameters:	msg:	message to display
#
# Result:	none
# ---------------------------------------------------------------------
function compose::debug_out( msg ) {
  switch (debug) {
    case 0:
    return;

    case 1:
    info(msg);
    break;

    case 2:
    response(msg);
    info(msg);
    break;
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: show_params
#
# Purpose:	formats an associative array one one of several
#		formats:
#
#		fmt	appearance
#		0:	\t\nname = value\t\nname = value...
#		1:	name = value\nname=value\n...
#
# Parameters:	params:		array to display
#		doSuppress:	if 1, omit array elements with null values
#				unless 'verbose' is non-zero.
#		format:		format to apply
#
# Result:	formatted array string
# ---------------------------------------------------------------------
function compose::show_params( params[],				\
			       doSuppress=0,				\
			       format=0					\
			     ) {

  # Exit if array is empty
  if ( count( params ) == 0 ) {
    return "";
  }

  # Obtain all of the keys in 'params'
  local keys[ count( params ) ];
  local next = 1;
  local k;

  for ( k in params ) {
    keys[ next ] = k;
    next += 1;
  }

  # Sort keys into ascending order, ignoring case
  qsort( keys, 1 );

  # Iterate, building output string
  local i;
  local result;

  for ( i = 1;i < next; i += 1 ) {

    # Separate this entry from the previous with newline and tab.
    if ( format == 0 ) {
      result .= "\n\t";
    }

    # get key and value
    local key   = keys[ i ];
    local value = params[ key ];

    # Only include if it's non-null or we're supposed to include
    # null values
    if ( value != "" || !doSuppress || verbose > 0 ) {
      result .= key . " = " . value;

      # Separate this entry from the next one with newline
      if ( format == 1 ) {
	result .= "\n";
      }
    }

    # End of iteration; on to next key
  }

  return result;
}

# ---------------------------------------------------------------------
# Function:	compose :: debug_params
#
# Purpose:	Generate a composer log message displaying every
#		name/value pair in the params[] array.
#
# Parameters:	msg:	 header to include
#		params:	 associative parameter array
#
# Result:	none
# ---------------------------------------------------------------------
function compose::debug_params( msg, params[] ) {

  # Exit if debugging messages are being discarded
  if ( debug < 1 ) {
    return;
  }

  # Format the parameters.
  local parmString = show_params( params, 1, 1 );

  # Make parameters and message XML safe
  local xmlMsg = msg;
  local xmlPar = parmString;

  gsub( "&", "\\&amp;", xmlMsg );
  gsub( "&", "\\&amp;", xmlPar );

  gsub( "<", "\\&lt;", xmlMsg );
  gsub( "<", "\\&lt;", xmlPar );

  # show the result in the composerlog, parsing the string.
  # Use the subset of html markup defined in eventlog.dtd.
  info("<div>"								\
       . "<p>"   . xmlMsg . "</p>"					\
       . "<pre>" . xmlPar . "</pre>"					\
       . "</div>",							\
       1								\
      );

  # does the user want a response panel as well?
  if (debug > 1) {
    response( msg . "\n" . parmString );
  }
}

############################################################################
#
# core interface functions:
#
############################################################################

# ---------------------------------------------------------------------
# Function:	compose :: get_composer_path2
#
# Purpose:	Returns the absolute path to the CCF file to be used
#		in composing a document.
#
#		If a document is specified, the doctype-specific CCF
#		is returned.  This assumes that "type" is a composer type
#		defined in the Compose section of the DCF.
#
#		If no document is provided, or if the document has
#		no doctype-specific CCF definition for type, then we
#		return "type.ccf" from the composer path.
#
# Parameters:	type:		operation type ("html", "rtf", etc.)
#		doc:		document being composed
#		fromDoctype:	(result) 1 if the path was derived from
#				the document's doctype's DCF file, 0
#				if it's the generic value from the install tree
#
# Result:	The system ID (absolute path) for the appropiate <type>.ccf
#		or the empty string
# ---------------------------------------------------------------------
function compose::get_composer_path2( type, doc, &fromDoctype ) {
  # return value
  local path;

  # use the doctype specific ccf, if present
  if (doc > 0) {
    path = composer_sysid( type, doc );

    if ( path != "" ) {
      fromDoctype = 1;
      return path;
    }
  }

  # construct a doctype-independent file
  local file = type . ".ccf";
  local search_path = option( 'composerpath' );

  # Returns null string if not found.
  path = find_file_in_path( file, "e", search_path );

  # This value did not come from the DCF file.
  fromDoctype = 0;

  return path;
}

# ---------------------------------------------------------------------
# Function:	main :: get_composer_path
#
# Purpose:	wrapper that omits a parameter
#
# Parameters:	type:	composition operation type
#		doc:	document being composed or 0
#
# Result:	System ID (absolute path) to CCF file to be used
#		in composing 'doc' for 'type'.
# ---------------------------------------------------------------------
function main::get_composer_path( type, doc=0 ) {
  local unused;

  return compose::get_composer_path2( type, doc, unused );
}

# ---------------------------------------------------------------------
# Function:	main :: get_composer
#
# Purpose:	Finds and initializes a content pipeline
#
# Parameters:	params:		(result) filled with default parameter values
#		type:		operation type ("rtf", "html", etc.)
#		doc:		document to compose
#
# Result:	absolute path to the composer (CCF file)
# ---------------------------------------------------------------------
function main::get_composer( params[], type, doc=current_doc() ) {

  # Make sure search
  composer_set_catalog_path(option('catalogpath'));

  # Find the CCF file
  local fromDoctype;

  local path = compose::get_composer_path2( type, doc, fromDoctype );

  # If we found a doctype-specified or at least doctype-allowed composer
  if ( fromDoctype ) {
    composer_get_all_parameters( params, type, doc );
  }

  # Otherwise load parameters from the CCF file
  else {
    composer_get_ccf_parameters( params, path );

    # composer_get_all_parameters does this; composer_get_ccf_parameters
    # does not.
    params[ P_DOCUMENT ] = doc;
  }

  return path;
}

# run_composer(comp, params[])
#
# causes execution of the composer pipeline referenced by comp
# with the parameters in params
#
function main::run_composer( comp, params[] ) {

  # Copy debug flags into composition parameter array
  if ( verbose > 0 ){
    params[ "verbose" ] = "true";
  }

  if ( debug > 0 ) {
    params[ "debug" ] = "true";
  }

  if ( ditaTraceLevel > 0 ) {
    params[ "ditaTraceLevel" ] = ditaTraceLevel;
  }

  # Save interactive flag so that pipeline won't clutter the
  # message line if this is a batch run.
  pipelineInteractive = params[ P_COMP_INTERACTIVE ];

  # Set up the alternate PCF, if any
  setupPcf( params );

  local rc = composer_run( comp, params );

  # Undo the alternate PCF setup
  teardownPcf( );

  return rc;
}

# flush_composer(doc, type)
#
# Flush the composer configuration for composition <type> and <doc>
# from the pipeline cache.
#
# If <type> is not specified then all pipeline configurations for
#    doc are flushed;
# If the document is not specified, all pipelines are flushed.
#
function main::flush_composer(doc=-1, type="all")
  {
  if (doc == -1)
    {
    composer_flush();
    }
  else
    {
    local dotype, types[];

    if (type == "all")
      {
      composer_types(types, doc);
      }
    else
      {
      types[1] = type;
      }
    for (dotype in types)
      {
      composer_flush(get_composer_path(dotype, doc));
      }
    }
  }

############################################################################
#
# compose framework functions
#
############################################################################

# ---------------------------------------------------------------------
# Function:	compose :: start_log
#
# Purpose:	initializes tracing and the composer log for a composition
#		operation
#
# Parameters:	heading:	string to insert into composer log
#		params:		composition parameters
#
# Result:	none
# ---------------------------------------------------------------------
function start_log( heading, params[] ) {

  # Assume we're not debugging.
  local doDelete = 1;

  # If we're debugging, invoke the trace manager to enable java-layer logging
  # and the preservation of intermediate files.
  #
  # Don't do this if we're a PE sub-process and we're processing a transaction;
  # in that case, getTraceObject() will return -1, and we'll save intermediate
  # files to the transaction directory.
  if ( option( "debugcomposition" ) == "on"				\
       && ( !main::is_e3 || option( "petransactiondirectory" ) == "" )	\
     ) {

    local traceManager							\
      = java_static( "com.arbortext.e3.subprocess.CompositionTraceManager",\
		     "getManager"					\
		   );

    if ( traceManager != 0 ) {
      local traceObject							\
	= java_instance( traceManager,					\
			 "createTracer"					\
		       );

      if ( traceObject != 0 ) {
	local traceId = java_instance( traceObject, "getId" );

	params[ "compose.traceObject"   ] = traceObject;
	params[ "compose.traceObjectId" ] = traceId;
	doDelete = 0;
      }
    }
  }

  # If we're not debugging or we failed to get a trace object, delete
  # the relevant composition parameters.
  if ( doDelete ) {
    delete( params[ "compose.traceObject"   ] );
    delete( params[ "compose.traceObjectId" ] );
  }

  # start the eventlog job
  _composerlog::start_job( heading );
}

# ---------------------------------------------------------------------
# Function:	finish_log
#
# Purpose:	terminates tracing and logging after a composition operation
#
# Parameters:	params:		associative array of composition parameters
#
# Result:	none
# ---------------------------------------------------------------------
function finish_log( params[] ) {

  # These parameters will cause the composer log to be displayed if
  # current policy says to do so (logFlag=0) OR if any error is
  # more serious than a warning.
  local logFlag  = 0;
  local severity = _eventlog::SEVERITY_WARNING;
  local suppress = 0;

  # If this global debugging symbol is on, always show the log with
  # full detail.
  if ( alwaysShowLog ) {
    logFlag  = 1;
    severity = _eventlog::SEVERITY_INFO;
    suppress = 0;
  }

  # If our caller wants the log suppressed, don't display unless we got
  # a FATAL error.
  else if ( params[ "compose.suppressLogDisplay" ] ) {
    logFlag  = -1;
    severity = _eventlog::SEVERITY_FATAL;
    suppress = 1;
  }

  _composerlog::end_job( logFlag, severity, suppress );

  # If we're debugging, terminate this operation
  if ( params[ "compose.traceObject" ] ) {
    java_instance( params[ "compose.traceObject" ],			\
		   "endOperation"					\
		 );
  }

  # If caller wants us to do so, save composer log to disk
  if ( params[ "composerLogDestination" ] ) {
    composerlog::save( params[ "composerLogDestination" ] );
  }
}

# Function augment_xsl_transform_params takes an array of parameters,
# one of which is (or could be) "transformerParams", and a
# parameter string.  The global xsl_transform_params string defaults
# to null, but if it is set to a non-null valid parameter string, its
# values will augment the "transformerParams" passed to the XSLT
# run that uses the styler2xsl-generated XSLT.
#
# The format of the xsl_transform_params parameter string is
# "name1=value1||name2=value2" etc.
#
global xsl_transform_params=''

function augment_xsl_transform_params(P[], xsl_transform_params)
{
    if (xsl_transform_params != '') {
      if ( P[ "transformerParams" ] != "" ) {
        # If we already have transformer parameters, insert a separator
          P[ "transformerParams" ] .= "||";
      }
      P[ "transformerParams" ] .= xsl_transform_params
    }
}

# ---------------------------------------------------------------------
# Function:	compose :: compose_for_type
#
# Purpose:	basic structure for composing a document, either
#		locally or via E3.
#
# Parameters:	doc:		document to compose
#		comp_type:	type label from DCF compose section
#				(e.g., 'html', 'web', 'pdf', etc.)
#		interactive:	1 if called from the interactive GUI
#		inParams[]:	associative name/value array of parameters
#				that overrides the default composer parameters
#
#		prefn:		ACL function or "";
#
#				prototype:  function x( doc, params, interactive )
#
#				called before the content pipeline is loaded
#				returns -2 (error, message already displayed),
#				-1 (user abort), 0 (error), or 1 (ok)
#
#		dialogfn:	ACL function or "";
#
#				prototype:  function x( doc, params )
#
#				called to display a publish dialog
#				returns -1, 0, 1 for user abort, error, OK
#
#		paramfn:	ACL function or "";
#
#				prototype:  function x( doc, params )
#
#				called just before the content pipeline is
#				run (local composition) or E3 is called;
#				returns -1, 0, 1, 2 for user abort, error, OK,
#				or "OK but skip running the pipeline;
#
#		postfn:		ACL function or "";
#
#				prototype:  function x( doc, params, interactive )
#
#				called after the content pipeline or E3 returns
#				returns -1, 0, 1 for user abort, failure,
#				or success
#
# Result:	-1:	user abort
#		 0:	failure
#		 1:	success
# ---------------------------------------------------------------------
function compose::compose_for_type( doc,				\
				    comp_type,				\
				    interactive,			\
				    inParams[],				\
				    prefn="",				\
				    dialogfn="",			\
				    paramfn="",				\
				    postfn=""				\
				  ) {
  local doc_name = doc_name(doc);
  local heading;
  local result;

  if (comp_type == "xsl") {
    heading = varsub(agettext('Publish $doc_name using xsl.'));
  }
  else {
    if ( P_COMP_LOG_HEADER in inParams ) {
      local comp_type = inParams[ P_COMP_LOG_HEADER ];

      heading = varsub(agettext('Publish $doc_name for $comp_type.'));
    }
    else {
      heading = varsub(agettext('Publish $doc_name for $comp_type.'));
    }
  }

  # Set the transformerParam table.border.thickness for XSL outputs.
  # (We assume this parameter would just be ignored for non-XSL outputs.)
  if ( inParams[ "transformerParams" ] != "" ) {
    # If we already have transformer parameters, insert a separator
      inParams[ "transformerParams" ] .= "||";
  }
  inParams[ "transformerParams" ] .= "table.border.thickness=" . \
				option('tabledefaultrulethickness')

  # Set the transformerParam default-thead-valign for XSL outputs.
  # (We assume this parameter would just be ignored for non-XSL outputs.)
  if ( inParams[ "transformerParams" ] != "" ) {
    # If we already have transformer parameters, insert a separator
      inParams[ "transformerParams" ] .= "||";
  }
  inParams[ "transformerParams" ] .= "default-thead-valign=" . \
		(compose::cals_thead_default_top_align==1 ? 'top' : 'bottom');

  # Possibly set some more XSLT parameters from xsl_transform_params
  augment_xsl_transform_params(inParams, xsl_transform_params)

  # start tracing and logging
  start_log( heading, inParams );

  # If we're running on the server side of a PE composition operation,
  # log the transaction ID and subprocess PID.
  if ( inParams[ P_E3_SERVER_COMPOSITION ] == 1 ) {
    local transactionId = inParams[ P_E3_SERVER_TRANSACTION_ID ];
    local subprocessId = getpid();
    local msg = agettext( "Publishing engine process ID = "		\
			  . "'$subprocessId'; transaction ID = "	\
			  . "'$transactionId'."				\
			);
    info( varsub( msg ) );
  }

  # do the actual compose operation (XXX - consider catch)
  result = compose_for_type_int( doc,					\
				 comp_type,				\
				 interactive,				\
				 inParams,				\
				 prefn,					\
				 dialogfn,				\
				 paramfn,				\
				 postfn					\
			       );

  switch (result) {

    case -2:
	# error already called to report message.  Do not display message.
	result = -1;
    break;

    case -1:
    info(agettext("Operation canceled by user."));
    message(agettext("Operation canceled by user."));
    break;

    case 0:
    fatal(agettext("Operation terminated."));
    break;

    case 2:
    info( agettext( "Asynchronous operation started using PTC Arbortext Publishing Engine server." ) );
    result = 1;
    break;

    default:
    case 1:
      info(agettext("Operation succeeded."));
      break;
    }

  # terminate logging and tracing
  finish_log( inParams );

  return result;
}

# ---------------------------------------------------------------------
# Function:	compose :: callFrameworkHook
#
# Purpose:	calls  any registered caller code at interesting
#		points during the execution of the composition framework.
#
#		each (user-defined) hook function should have the following
#		signature:
#
#		framework_hook_func( doc, type, location, params[] )
#
#		doc:		document being composed
#		type:		type of output being produced (pdf, html, etc.)
#		location:	location from which hook was called
#		params:		composition parameter array
#
#		The hook function may change anything in the parameter array
#		to influence the future operation of the composition framework.
#
#		The hook function should return -1 to abort the hook sequence.
#
# Parameters:	doc:		document being composed
#		location:	location from which this is called
#		params:		parameter array that controls everything
#
# Result:	-1:	failure
#		0:	success
# ---------------------------------------------------------------------
function compose::callFrameworkHook( doc, location, params[] ) {

  local hookResult = hook_call( "compositionframeworkhook",		\
				doc,					\
				params[ P_COMP_TYPE ],			\
				location,				\
				params					\
			      );
  if ( hookResult < -1 ) {
    set_errmessage( "Internal error calling composition framework hooks." );
    return -1;
  }

  debug_params( "Composition framework parameters after '"		\
		. location						\
		. "' hook (doc = '"					\
		. doc							\
		. "' type = '"						\
		. params[ P_COMP_TYPE ]					\
		. "').",						\
		params							\
	      );

  return hookResult;
}

# ---------------------------------------------------------------------
# Function:	compose :: compose_for_type_int
#
# Purpose:	Does the work for compose_for_type
#
# Parameters:	see compose_for_type
#
# Result:	-2:	error already displayed to user
#		-1:	user abort
#		 0:	failure
#		 1:	success
#		 2:	async operation started with PE server.
# ---------------------------------------------------------------------
function compose_for_type_int( doc,					\
			       comp_type,				\
			       interactive,				\
			       inParams[],				\
			       preprocessing_function="",		\
			       dialog_function="",			\
			       param_fixup_function="",			\
			       postprocessing_function=""		\
			     ) {
  local result = 1;
  local gotcachedparams = count(inParams);
  local msg;

  # Current doc could fluctuate during all this; store it so we can
  # put it back.
  local origCurDoc = current_doc();

  # If global "write vdoc" flag is on, add it to our parameters
  if ( saveVdoc ) {
    inParams[ "compose.saveVdoc" ] = 1;
  }

  # Ensure "document" isn't in the caller's array.  get_composer() sets
  # the "document" key from the incoming doc argument but if inParams[]
  # already has a "document" key, the value won't be copied below from
  # params[] into inParams[].  You can get an empty value for the "document"
  # key of an E3 composition if the first type done on a document.  If you
  # then switch to a non-E3 compose, you'll hit this scenario.
  delete( inParams[ "document" ] );

  # Set global flags: is this an interactive operation, are we using E3?
  # Force E3 composition off if we're actually running as an E3 subprocess.
  local e3Composition = ( ( option( "e3composition" ) == "on" )	\
			  && !main::is_e3				\
			);

  # Check to see whether our caller has commanded that we not compose
  # using E3.
  if ( P_COMP_SUPPRESS_PE_COMPOSITION in inParams ) {
    e3Composition = 0;
    delete( inParams[ P_COMP_SUPPRESS_PE_COMPOSITION ] );
  }

  # Do not use E3 for internal styler calls:
  if (comp_type == 'styler') {
    e3Composition = 0;
  }

  # Make sure we have a connection to E3 if we need one
  if ( e3Composition ) {
    local rc = compconfig::checkDataAvailability();

    if ( rc != "ok" ) {
      set_errmessage( rc, interactive );
      return 0;
    }

    rc = compconfig::checkVersion();

    if ( rc != "ok" ) {
      set_errmessage( rc, interactive );
      return 0;
    }
  }

  # See whether we should use "old" or "new" DITA processing.  If it's not
  # explicitly specified by our parameters, look to the ACL set option.
  if ( ! ( P_DITA_USE_NEW_RDS in inParams ) ) {
    local opt = option( "ditausenewrds" );

    inParams[ P_DITA_USE_NEW_RDS ] = ( opt == "on" );
  }

  # Set parameter values reflecting the above
  inParams[ P_COMP_DOCUMENT		] = doc;
  inParams[ P_COMP_INTERACTIVE		] = interactive;
  inParams[ P_COMP_E3COMPOSITION	] = e3Composition;
  inParams[ P_COMP_TYPE			] = comp_type;

  # Do not override if empty parameter
  if ( preprocessing_function ) {
     inParams[ P_COMP_PREPROC_CB		] = preprocessing_function;
  }

  inParams[ P_COMP_DIALOG_CB		] = dialog_function;

  # Do not override if empty parameter
  if ( param_fixup_function ) {
	  inParams[ P_COMP_PARAMETER_CB		] = param_fixup_function;
  }

  # Do not override if empty parameter
  if ( postprocessing_function ) {
  	inParams[ P_COMP_POSTPROC_CB		] = postprocessing_function;
  }

  # Log the start of this operation
  local headerType = comp_type;

  if ( P_COMP_LOG_HEADER in inParams ) {
    headerType = inParams[ P_COMP_LOG_HEADER ];
  }

  msg = "Starting compose for <code>" . headerType . "</code>" \
      . ( e3Composition ? " using e3" : "" ) \
      . ( interactive ? " interactively" : "" ) \
      . ( (interactive && gotcachedparams) ? " with cached parameters" : "" ) \
      . ".  ";

  # Call the framework hook to allow user code to initialize and tinker
  # with our destiny.
  local hookRc = callFrameworkHook( doc, HK_CFTI_INITIAL, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # Allow the "initial" hook to change the current document.  This is needed by
  # SIS where the hook needs to transform the document itself into a new doc.
  # Note that the document entry was just deleted above.
  if ( inParams[ "document" ] != "" && doc_valid( inParams[ "document" ] ) ) {
    doc = inParams[ "document" ];
    delete( inParams[ "document" ] );
    inParams[ P_COMP_DOCUMENT ] = doc;
  }

  # Call the composition preprocessing function, if any.
  if ( inParams[ P_COMP_PREPROC_CB ] != "" ) {
    inParams[ P_COMP_PREPROC_RC ] =					\
      (*inParams[ P_COMP_PREPROC_CB ])( doc, inParams, interactive );
  }
  else {
    inParams[ P_COMP_PREPROC_RC ] = 1;
  }

  # Call framework hook to mark completion of preprocessing callback.
  hookRc = callFrameworkHook( doc, HK_CFTI_PREPROC_CB, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # If the preprocessing function returned error, we're done.
  if ( inParams[ P_COMP_PREPROC_RC ] <= 0 ) {

    # If RC == 0, we have an error, and no message has been displayed.
    if ( inParams[ P_COMP_PREPROC_RC ] == 0 ) {
      local comp_type = inParams[ P_COMP_TYPE ];
      set_errmessage( varsub( agettext( 'Failure pre-processing '	   \
					. 'parameters of composer type '   \
					. '$comp_type.'			   \
				      )					   \
			    )						   \
		    );
    }

    # If RC == -2, a message has been displayed.  Edit the RC to our
    # own return code.
    else if ( inParams[ P_COMP_PREPROC_RC ] == -2 ) {
      inParams[ P_COMP_PREPROC_RC ] = 0;
    }

    # If RC == -1, take no action; we'll return as if the user cancelled.
    # Note that this allows a way for the framework hook to signal a
    # user cancellation.

    return inParams[ P_COMP_PREPROC_RC ];
  }

  # If result == 2, remember to suppress pipeline initialization.
  inParams[ "compose.suppressPipelineInitialization" ] =		\
    ( inParams[ P_COMP_PREPROC_RC ] == 2 ) ? 1 : 0;

  # If not suppressed by preprocessing function return code,
  # (non-E3) create pipeline and initialize parameters or
  # (e3-tie) initialize E3 composition parameters
  local composer;

  if ( inParams[ "compose.suppressPipelineInitialization" ] ) {
    debug_out( "Skipping composer/e3 initialization at request of preproc." );
    composer = "suppressed";
  }
  else {
    local params[];

    # SPR 5331321:  if we're the server side of a PE composition operation,
    # initialize the composer specified by  the client.  The document we're
    # composing might be an RDS derived from a DITA map.  In that case, the
    # composer.ccf file specified by the DITA map's DCF file is the proper
    # file to use, but the RDS's DCF file won't specify it.
    if ( inParams[ P_E3_SERVER_COMPOSITION ]				\
	 && inParams[ P_E3_COMPOSER_PATH ] != ""			\
       ) {

      # Remember the path to the composer
      composer = inParams[ P_E3_COMPOSER_PATH ];

      # Load parameters from the .ccf file.
      # We don't need to worry about whether there's an alternate composer
      # specified in the DCF file, or about composer parameters overrides
      # in the DCF file; those checks have been handled on the client side,
      # any the parameters are already in inParams[].
      composer_get_ccf_parameters( params, composer );

      # Make sure we know what document to compose.
      params[ P_DOCUMENT ] = doc;
    }

    # If not composing with E3, create a composer and get its parameters.
    else if ( !inParams[ P_COMP_E3COMPOSITION ] ) {
      composer = get_composer( params,					\
			       inParams[ P_COMP_TYPE ],			\
			       doc					\
			     );

      if ( composer == "" ) {
	set_errmessage( varsub( agettext('Failed to create composer of '\
					 . 'type $comp_type.'		\
					)				\
			      )						\
		      );
	return 0;
      }
    }

    # If composing using E3, verify that this composer is installed on
    # E3 server and get its default parameters for this doctype
    else {
      composer = "e3";

      local msg = initialize_e3_composition( params, comp_type, doc );

      if ( msg != "" ) {
	set_errmessage( msg );
	return 0;
      }
    }

    # Copy any parameters not supplied by our caller and/or the composition
    # preprocssing function into 'inParams'.
    #
    # CR 56296:  override any parameters whose name begins with 'e3.'.  Those
    # aren't derived from the GUI, and any values cached by our caller from the
    # last composition operation may be invalid.
    #
    # CR 57910:  don't override the value of "e3.asynchronous", which might
    # have been set by the caller to compose_for_type.

    local item;
    for ( item in params ) {
      if ( !( item in inParams )					\
	   || ( substr( item, 1, 3 ) == "e3."				\
		&& item != "e3.asynchronous"				\
	      )								\
	 ) {
	inParams[ item ] = params[ item ];
      }
    }
  }

  # Save composer so that hook routines can query it for parameter
  # information.
  inParams[ P_COMP_COMPOSER ] = composer;

  # Call framework to mark completion of pipeline creation.
  hookRc = callFrameworkHook( doc, HK_CFTI_PIPE_INIT, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # If we're running interactively and we have a dialog function,
  # and if we're not running under control of a publishing rule,
  # display the dialog and retrieve parameters from the user
  if ( inParams[ P_COMP_INTERACTIVE ]					\
       && inParams[ P_COMP_DIALOG_CB ] != ""				\
       && !inParams[ P_COMP_USING_RULE ]				\
     ) {

    setupPcf( inParams );

    inParams[ P_COMP_DIALOG_RC ] =					\
	      (*inParams[ P_COMP_DIALOG_CB ])( doc, inParams );

    teardownPcf();
  }
  else {
    inParams[ P_COMP_DIALOG_RC ] = 1;
  }

  # Call the framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_DIALOG_CB, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # User abort, with or without message
  if ( inParams[ P_COMP_DIALOG_RC ] < 0) {
    return inParams[ P_COMP_DIALOG_RC ];
  }

  if ( inParams[ P_COMP_DIALOG_RC ] == 0) {
    local comp_type = inParams[ P_COMP_TYPE ];
    set_errmessage( varsub( agettext( 'Failure in dialog of composer ' \
				      . 'type $comp_type.'		 \
				    )					 \
			  )						 \
		  );
    return result;
  }

  # update all queries with updateOnCompose value set to
  # yes or lock_yes and the datamerge is enabled
  if ( !inParams[ P_COMP_SUPPRESS_DATA_MERGE ] ) {
    _datamerge::update_queries_on_compose( doc );
  }
  else {
    debug_out( "Suppressed datamerge update." );
  }

  # Copy value of change tracking kludge variable into composition parameters.
  if ( changetracking != "" ) {
    inParams["changetracking"] = changetracking;
  }

  # DR - Added check for new "convenience" parameters for profiling.
  # The parameter "setprofiles" can be used by a
  # batch/lights-out function to specify all the profiles in a single
  # string and avoid having to set up the "prof.logicalExpression" param.
  #
  # This replaces the deprecated "profiles"  param.
  #
  # The string should look something like:
  # $profile_str = $alias1.chr(1).$value1.chr(1).$value2.chr(1).$alias2

  # Note that the only difference between the contents of "profiles" and
  # "setprofiles", is that "setprofiles" uses chr(1) as the separator.
  # This is allow the use of a custom delimiter for separating profile values,
  # which is now user-defined and configurable.
  # The only requirement is that this delimiter should not be chr(1).
  #
  # The other new parameter is "setprofilegroup" which allows a batch function
  # to pass in the name of the set profile group (or profile resolution group).

  # Note that only one of "setprofiles", "setprofilegroup" and
  # "profiles", should be specified. If more than one is specified,
  # our logic here will accept the first in the following order
  # of preference:
  # (i)		"setprofiles"
  # (ii)	"setprofilegroup"
  # (iii)	"profiles"

  # Dhruv Raheja (050504) -- moved profiling code before the fixup function
  # The fixup function for PDF checks if profiling is "on" to decide if
  # the pipeline needs to be run. This is a problem if we haven't
  # set up prof.logicalExpression until then.

  if ( "setprofiles" in inParams ) {
    local profiles_array[];

    #response("found setprofiles");
    epicutil::UnserializeKeyed( inParams["setprofiles"],		\
				profiles_array,				\
				chr(1)					\
			      );

    inParams[ "prof.logicalExpression" ] =				\
      audience::create_logical_string( profiles_array, doc );
  }

  # check if "setprofilegroup" has been set
  else if ( "setprofilegroup" in inParams ) {

    groupName = inParams[ "setprofilegroup" ];

    # get logical expression for this group
    local logicExpr = set_profile_group( groupName, doc);

    if ( logicExpr != "") {
      inParams[ "prof.logicalExpression" ] = logicExpr;
    }
  }

  # Finally, check for the "profiles" parameter, for
  # backwards compatibility.
  # Here we burst the profile parameters from 'profiles' to separate
  # parameter entries if the parameter exists.
  else if ( "profiles" in inParams ) {

    local profiles_array[];

    # Un-serialize params["profiles"] and create the logical expression string.
    # This is being done for backwards compatibility
    # Specifying "|" as the separator.

    epicutil::UnserializeKeyed( inParams["profiles"], profiles_array, "|" );

    inParams["prof.logicalExpression"] =				\
      audience::create_logical_string( profiles_array, doc );
  }

  # Flag to indicate that a DITA topic has been wrapped in a
  # temporary map for composition.  Only set to 1 for DITA topics.
  # Otherwise, value stays at 0.
  inParams[ P_TOPIC_ALREADY_WRAPPED ] = 0;

  # If DITA topic is wrapped in map, this is the map ID.
  inParams[ P_TEMP_MAP ] = -1;

  # Save the stylesheet parameter.  The parameter fixup callback may
  # make changes, and we need the original stylesheet name for DITA processing.
  inParams[ "originalStylesheet" ] = inParams[ "stylesheet" ];

  # Call the framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_PROFILE, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  if ( !inParams[ P_DITA_BYPASS ]					\
       && !inParams[ P_COMP_SUPPRESS_DITA_TOPIC_SETUP ]			\
     ) {
    # If we're composing a DITA topic (not a DITA map, that's handled below)
    # and we're not importing a non-XML document, set some parameters.
    if ( doc_valid( doc )						\
	 && ( ( doc_type_dita( doc ) == 1				\
		&& dita::_composeTopicAsMap() != 1				\
	      )								\
	      || doc_is_dita_rdstyle( doc )					\
	    )								\
	 && inParams[ P_COMP_TYPE ] != "import"				\
       ) {

      if ( doc_type_dita( doc ) == 1 ) {
         # these parameters apply only to topics or specializations
         inParams[ "resolveDitaConref" ] = "true";
         inParams[ P_DITA_DOCTYPE      ] = "topic";

         # Make sure the DITA postprocess filter gets applied.
         inParams[ P_DITA_PROCESSING ] = "true";
      }

      # if the caller didn't specify the parameter, turn on unstyled
      # element generalization
      if ( inParams[ P_DITA_GENERALIZE_UNSTYLED ] == "" ) {
         inParams[ P_DITA_GENERALIZE_UNSTYLED ] = "yes";
      }

      # If the caller didn't specify the parameter, use the stylesheet
      # as the styled elements file.

      # SPR 1814219:  don't do this with PE composition enabled; the
      # stylesheet is on the PE server, and the styled elements file
      # is needed on the client.

      # This isn't quite right:  if the styled elements file is blank,
      # DITA processing will use the default stylesheet for the doctype
      # as the styled elements file.  If certain settings (white space,
      # table markup, others) differ between the default stylesheet and
      # the stylesheet that's used for composition, results could be strange.
	  if ( inParams[ P_DITA_STYLED_ELEMENTS_FILE ] == "" ) {
	     if ( inParams[ P_COMP_E3COMPOSITION ] != 1 ) {
			inParams[ P_DITA_STYLED_ELEMENTS_FILE ] =			\
	              inParams[ "originalStylesheet" ];
	     }
      }
    }
    else {
      # See if we're going to compose a DITA topic wrapped in a temporary map.
      if ( doc_valid( doc )						\
	   && dita::_composeTopicAsMap() == 1				\
	   && doc_type_dita( doc ) == 1					\
	   && !inParams[ P_COMP_SUPPRESS_DITA_MAP_CHECK ]		\
	   && ( inParams[ P_COMP_E3COMPOSITION ]			\
		|| inParams[ P_COMP_TYPE ] != "import"			\
	      )								\
	 ) {
	# We are going to compose the DITA topic wrapped in a temporary map.
	# Wrap the topic in the temporary map (as a topic ref) here so we can
	# use the temporary map ID in the parameter fixup callback which is
	# called next.
	inParams[ P_TEMP_MAP ] = dita::wrap_topic( doc );

	# Set to 1 so we can inform the preprocessForDita function.
	if ( inParams[ P_TEMP_MAP ] != -1 ) {
	  inParams[ P_TOPIC_ALREADY_WRAPPED ] = 1;
	}
      }
    }
  }

  # Run the composition framework hook.
  hookRc = callFrameworkHook( doc, HK_CFTI_DITA_TOPIC, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # Call the parameter fixup callback, if any.
  if ( inParams[ P_COMP_PARAMETER_CB ] != "" ) {

    if ( inParams[ P_TOPIC_ALREADY_WRAPPED ] == 1) {
      # Use the temporary DITA map.
      inParams[ P_COMP_PARAMETER_RC ] =								\
	( *inParams[ P_COMP_PARAMETER_CB ]				\
	)( inParams[ P_TEMP_MAP ],				\
	   inParams							\
	 );
    }
    else {
      inParams[ P_COMP_PARAMETER_RC ] = ( *inParams[ P_COMP_PARAMETER_CB ] )( doc, inParams );
    }
  }

  else {
    inParams[ P_COMP_PARAMETER_RC ] = 1;
  }

  # Run the composition framework hook.
  hookRc = callFrameworkHook( doc, HK_CFTI_PARAMETER_CB, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # User abort, message displayed by parameter fixup callback
  if ( inParams[ P_COMP_PARAMETER_RC ] < 0 ) {
    return inParams[ P_COMP_PARAMETER_RC ];
  }

  if ( inParams[ P_COMP_PARAMETER_RC ] <= 0 ) {
    local comp_type = inParams[ P_COMP_TYPE ];
    local msg = agettext( 'Failure post-processing parameters '		\
			  . 'of composer type $comp_type.'		\
			);
    set_errmessage( varsub( msg  ) );
    return inParams[ P_COMP_PARAMETER_RC ];
  }

  # See if we're composing a DITA map or topic document.  Even if we are,
  # pretend we're not if the 'suppress' flag is set to prevent indefinite
  # recursion.
  # If we're Importing, we skip DITA preprocessing
  local gotDitaMapOrTopic =						\
    ( !inParams[ P_COMP_SUPPRESS_DITA_MAP_CHECK ]			\
      && doc_valid( doc )						\
      && ( doc_type_dita(doc) == 2					\
	   || ( dita::_composeTopicAsMap() == 1				\
		&& doc_type_dita( doc ) == 1				\
	      )								\
	 )								\
      && inParams[ P_COMP_TYPE ] != "import"				\
      && !inParams[ P_DITA_BYPASS ]					\
    );

  # We're not processing a DITA map or topic document.  However, we may be
  # composing a resolved DITA map, if we're running the PE server side
  # of a distributed composition operation.  In the latter case,
  # force the content pipeline to run.
  local forcePipeline = gotDitaMapOrTopic				\
			|| ( inParams["e3.serverComposition"]		\
			     && inParams[P_DITA_PROCESSING] == "true"	\
			   );

  # If inParams[ P_COMP_PARAMETER_RC ] == 2, suppress pipeline run
  inParams[ P_COMP_SUPPRESS_PIPELINE_RUN ] =				\
    (!forcePipeline && inParams[ P_COMP_PARAMETER_RC ] == 2 ) ? 1 : 0;

  # Run the preprocess hooks, if any
  if ( !inParams[ P_COMP_SUPPRESS_PREPROC_HOOK ] ) {
    local hookresult = hook_call( "composepreprocesshook",		\
				  doc,					\
				  inParams[ P_COMP_TYPE ],		\
				  inParams[ P_COMP_INTERACTIVE ],	\
				  inParams				\
				);

    if ( hookresult < 0 ) {
      return hookresult;
    }
  }

  # Run the composition framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_PREPROC_HOOK, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # We're composing a DITA map or topic document.  Run the DITA preprocessor
  # to convert to a resolved map, and force the pipeline to run.
  if (gotDitaMapOrTopic) {
    debug_out( ">> Calling DITA preprocesor." );

    local ditaRc;

    if ( !inParams[ P_DITA_USE_NEW_RDS ] ) {
      ditaRc =								\
      preprocessForDita( doc,						\
			 inParams,					\
			 inParams[ P_TOPIC_ALREADY_WRAPPED ],	\
			 inParams[ P_TEMP_MAP ]		\
		       );
    }
    else {
      ditaRc = preprocessForNewRDS( doc, inParams );
    }

    if ( ditaRc != 1 ) {
      debug_out( ">>preprocessForDita returned '" . ditaRc . "'." );
      return ditaRc;
    }

    # Since we're no longer composing the map we once had, we must ensure that
    # the PCF used for 'final' composition is the same as that for the source
    # map.
    if (!inParams[P_PROFILE_CONFIG_FILE] && !e3Composition) {
	    local pdoc = profile_config(doc);
	    if (doc_valid(pdoc)) {
	    	local pfile = doc_path(pdoc);
	    	if (pfile) {
		    	inParams[P_PROFILE_CONFIG_FILE] = pfile;
		    }
	    }
    }
  }
  else {
    debug_out( ">>Skipping DITA preprocessing; not a DITA map or DITA processing bypassed." );
  }

  # Call the postrds callback, if present.
  if ( inParams[ P_COMP_POSTRDS_CB ] ) {
    inParams[ P_COMP_POSTRDS_RC ] = ( *inParams[ P_COMP_POSTRDS_CB ] )( doc, inParams );
  } else {
    inParams[ P_COMP_POSTRDS_RC ] = 1;
  }

  # Run the composition framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_DITA_MAP, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # User abort, message displayed by postrds callback.
  if ( inParams[ P_COMP_POSTRDS_RC ] < 0 ) {
    return inParams[ P_COMP_POSTRDS_RC ];
  }

  # If we were asked to create a VDOC for output, create it.
  if ( inParams[ P_CREATE_VDOC ] ) {
    # If we're composing a map and the doc type has a pre-configured RDS, or
    # if we generated one on-the-fly, either way the identifying information
    # will be in the params.
    local rdsPublicId = "", rdsSystemId = "", rdsURI = "";
    local rdsKeyword = inParams[P_DITA_RDS_KEYWORD];
    if (rdsKeyword) {
      if (inParams[P_DITA_RDS_KEYWORD] == "URI") {
        rdsURI = inParams[ "ditaRDSIdentifier" ];
      }
      else if (inParams[P_DITA_RDS_KEYWORD] == "PUBLIC") {
        rdsPublicId = inParams[ "ditaRDSIdentifier" ];
        rdsSystemId = inParams[ "ditaRDSStorage" ];
      }
      else if (inParams[P_DITA_RDS_KEYWORD] == "SYSTEM") {
        rdsSystemId = inParams[ "ditaRDSStorage" ];
      }
    }

    local vdocType = inParams[ P_VDOC_TYPE ];
    local vdocSrcDoc = inParams[ P_VDOC_SRCDOC ];
    local vdocFlags = inParams[ P_VDOC_FLAGS ];
    local paramName = inParams[ P_VDOC_PARAM_NAME ];
    if (!paramName) {
      paramName = P_DOC_ID;
    }

    inParams[ paramName ] = compose::createVdoc( vdocType, vdocSrcDoc, vdocFlags, "", rdsPublicId, rdsSystemId, rdsURI );

    if ( inParams[ paramName ] == -1 ) {
      error( "Failed to create virtual document." );
      return 0;
    }

    compose::debug_out( "compose::compose_for_type_int:  created vdoc '"		\
			. inParams[ paramName ]				\
			. "'."						\
		      );

  }

  # Call framework hook
  hookRc = callFrameworkHook(doc, HK_CFTI_VDOC_CREATED, inParams);

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # If composing with E3, go do it.
  if ( inParams[ P_COMP_E3COMPOSITION ] ) {
    local e3Rc = e3_compose( inParams );

    # If we opened a temporary map, close it.
    if ( inParams[ P_TEMP_MAP ]					\
	 && doc_valid( inParams[ P_TEMP_MAP ] )			\
       ) {
      closeTempWrapMap(origCurDoc, inParams[P_TEMP_MAP]);
    }

    # If we opened any stylesheets, close them
    closeQueuedStylesheets( inParams );

    return e3Rc;
  }
    
####---------------xpan-----------------------##

local arr[];
#doc_set_path(inParams[ "document" ],"c:/a.xml");
#doc_save(inParams[ "document" ]);

local docp=doc_clone(inParams[ "document" ]);
doc_read_only(docp,0);

xpath_nodeset(arr, "//bookmeta/bookid/bookpartno",docp);

if(high_bound(arr)>=1){
	local codeType = oid_attr(arr[1],"type");
	if( codeType == "128"){
		local pno=oid_content(arr[1]);
		oid_modify_attr(arr[1],"value",Azelea_Code_128_C(pno));
	}
}
inParams[ "document" ]=docp;

####---------------xpan-----------------------##


  # We're composing locally.  We may be running on the PE server
  # as the server-side of a pe-tie operation, though.

  # If we're supposed to warn about CreoView not being installed,
  # see if it's not installed and generate a warning if so.  This is
  # only required because CreoView isn't in the install tree yet.
  # (kbosley 6.0 M020 14 July 2011)
  if ( inParams[ P_WARN_ON_MISSING_CREOVIEW ]				\
       && !g_suppressCreoViewCheck					\
       && !inParams[ P_COMP_SUPPRESS_CREOVIEW_CHECK ]			\
     ) {
    warnOnMissingCreoView( doc, inParams[ P_E3_SERVER_COMPOSITION ] );
  }

  # Accumulate time information here.
  local t1[1], t2[1];

  # If we haven't been instructed not to run the pipeline, run it.
  if ( !inParams[ P_COMP_SUPPRESS_PIPELINE_RUN ]			\
       && inParams[ P_COMP_COMPOSER ] != 'suppressed'			\
     ) {

      if (_debug_flag('9.1')) {
          times(t1);
          eval "Starting run_composer type=$inParams[$P_COMP_TYPE]" output=*debug;
      }

    inParams[ P_COMP_COMPOSER_RC ] =					\
      run_composer( inParams[ P_COMP_COMPOSER ], inParams );


      if (_debug_flag('9.1')) {
          times(t2);
          local tdiff = t2[1] - t1[1];
          eval "<***>\t\t\trun_composer complete - elapased time: ",  tdiff/100 . '.' . tdiff%100 output=*debug;
      }
  }
  else {
    debug_out( ">>skipped run_composer by request" );
    inParams[ P_COMP_COMPOSER_RC ] = 1;
  }

  # Run the composition hook
  hookRc = callFrameworkHook( doc, HK_CFTI_PIPE_DONE, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }
  # Exit if composer failed.
  if ( inParams[ P_COMP_COMPOSER_RC ] <= 0 ) {
    debug_out( ">>run_composer returned '"				\
	       . inParams[ P_COMP_COMPOSER_RC ]				\
	       . "'."							\
	     );

    return inParams[ P_COMP_COMPOSER_RC ];
  }

  # If we ran the DITA preprocessor, run the postprocessor.
  if ( inParams[ P_DITA_PROCESSING ] || inParams[ P_DITA_SETUP_RDS ] ) {
    if ( !inParams[ P_DITA_USE_NEW_RDS ] ) {
    debug_out( ">> Calling DITA postprocessor." );

    postprocessForDita( doc, inParams );
  }
  else {
      debug_out( ">> Calling new DITA postprocessor." );

      postprocessForNewRDS( doc, inParams );
    }
  }
  else {
    debug_out( ">> Skipping DITA postprocessor." );
  }

  # Run the composition framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_DITA_POST, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }
  # If we have a post-processing function, run that.
  if ( inParams[ P_COMP_POSTPROC_CB ] != "" ) {
    inParams[ P_COMP_POSTPROC_RC ] =					\
      (*inParams[ P_COMP_POSTPROC_CB ])( doc,				\
					 inParams,			\
					 inParams[ P_COMP_INTERACTIVE ] \
				       );
  }
  else {
    inParams[ P_COMP_POSTPROC_RC ] = 1;
  }

  # Run the composition framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_POSTPROC, inParams );

  if ( hookRc < 0 ) {
   return hookRc;
  }

  # If we opened any stylesheets that we should close, do so
  closeQueuedStylesheets( inParams );

  # Final run of composition framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_FINAL, inParams );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # If we opened a temporary map, close it.
  if (inParams[P_TEMP_MAP] && doc_valid(inParams[P_TEMP_MAP])) {
	closeTempWrapMap(origCurDoc, inParams[P_TEMP_MAP]);
  }

  # if rc == -3 do not throw error message
  if ( inParams[ P_COMP_POSTPROC_RC ] <= 0				\
       && inParams[ P_COMP_POSTPROC_RC ] != 3				\
     ) {
    local comp_type = inParams[ P_COMP_TYPE ];
    set_errmessage( varsub( agettext( 'Failure post-processing '	\
				      . 'for composer type $comp_type.'	\
				    )					\
			  )						\
		  );
  }

  return inParams[ P_COMP_POSTPROC_RC ];
}

# ---------------------------------------------------------------------
# Function:	encoding_setup
#
# Purpose:	fills an array with the encodings supported by a
#		composer.
#
#		If the composer doesn't specify an encoding list,
#		fills the array with a default set of encodings.
#
#		If we're composing using E3, derives the list
#		from the composer installed on the E3 server.
#
# Parameters:	encodings:	result array
#		type:		composition type
#		doc:		document to be composed
#		e3Composition:	1 if using E3 rather than local engine
#
# Result:	none
# ---------------------------------------------------------------------
function encoding_setup(encodings[], type, doc, e3Composition )
{
  local param_info[];

  # If not composing with E3, use local values
  if ( ! e3Composition ) {
    local comppath = get_composer_path(type, doc);

    if (comppath) {
	composer_get_parameter_info(param_info, comppath, "encoding");
    }
  }

  # If composing with E3, use data from server
  else {
    compconfig::getCompositionParameterInfo( param_info,		\
					     type,			\
					     doc,			\
					     "encoding"			\
					   );
  }

  # If array contains enumeration of legal encodings, split into separate words
  if ( "enumeration" in param_info ) {
    epicutil::Unserialize(param_info["enumeration"], encodings, '|');
  }
  # else copy default values to output array
  else {
    copy_array(default_encodings, encodings);
  }
}

####################################################################
#                                                                  #
# Functions for handling compiled stylesheets:                     #
#                                                                  #
####################################################################

function main::clear_stylesheets()
  {
  java_static("com.arbortext.epic.saxfilter.XSLTransformer", \
		"clearAllStyleSheet");
  }

function main::clear_stylesheet(path="")
  {
  if (path == "") {
    clear_stylesheets();
    }
  else {
    java_static("com.arbortext.epic.saxfilter.XSLTransformer", \
		"clearStyleSheet", path);
    }
  }

function main::list_stylesheets()
  {
  return java_static("com.arbortext.epic.saxfilter.XSLTransformer", \
			"listStyleSheets");
  }

####################################################################
#                                                                  #
# These are common functions for the comp_xxx.acl modules to call: #
#                                                                  #
####################################################################

# ---------------------------------------------------------------------
# Function:	compose :: resolve_path_parameters
#
# Purpose:	translates relative file names in a parameter list
#		to absolute file names by searching for each file
#		in a 'path', a list of directories.
#
#		We don't bother resolving files that are directly
#		accessible; as long as the current directory doesn't
#		change, the composer will be able to read them.
#
#		This routine should not be called for E3 composition.
#		Use "resolve_e3_path_parameters" instead.
#
# Parameters:	paths_keys:	associative array whose keys identify
#				the parameters to be translated
#		params:		associative array.  each value whose
#				key is in 'paths_keys' is translated
#				from a relative to an absolute path name
#		searchpath:	path to search (as returned by, e.g.,
#				options("composerpath")
#
# Result:	none
# ---------------------------------------------------------------------
function resolve_path_parameters( path_keys[], params[], search_path ) {
  local path_key;

  # Iterate over each keys
  for (path_key in path_keys) {

    # If there is no value for this key, skip it
    if ( ! ( path_key in params ) ) {
      continue;
    }

    # If the parameter exists but has a null value, complain.  This
    # can't be right.
    if ( params[ path_key ] == "" ) {
      error( "Can't resolve composition parameter '"			\
	     . path_key							\
	     . "'; value is null."					\
	   );
    }

    # Get the value associated with this parameter.
    local path_value = params[ path_key ];

    # If the parameter refers to a readable file, don't resolve
    if ( access( path_value, "r" ) ) {
      continue;
    }

    # Scan paths on local machine
    local resolved_path = find_file_in_path( path_value, "r", search_path );

    # If we found the file somewhere, store the absolute path as the
    # parameter value
    if ( resolved_path ) {
      params[ path_key ] = resolved_path;
    }

    # End of iteration:  on to next key
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: resolve_e3_path_parameters
#
# Purpose:	translates relative file names in a parameter list
#		to absolute file names by searching for each file
#		in a 'path', a list of directories.
#
#		Since we're composing using E3, we search directories
#		on the E3 server, rather than on the local machine.
#
#		We leave absolute paths alone;
#		the files involved will be transmitted to E3.
#
#		We prepend "e3:" to the absolute
#		path; later stages of the composition process will use
#		that to avoid transmitting the file to E3.
#
# Parameters:	paths_keys:	associative array whose keys identify
#				the parameters to be translated
#		params:		associative array.  each value whose
#				key is in 'paths_keys' is translated
#				from a relative to an absolute path name
#		path_name:	name of path list to search; e.g.,
#				composerpath
#
# Result:	none
# ---------------------------------------------------------------------
function resolve_e3_path_parameters( path_keys[], params[], path_name ) {
  local path_key;

  # Iterate over each keys
  for ( path_key in path_keys ) {

    # If there is no value for this key, skip it
    if ( ! ( path_key in params ) ) {
      continue;
    }

    # If the parameter exists but has a null value, complain.  This
    # can't be right.
    if ( params[ path_key ] == "" ) {
      error( "Can't resolve composition parameter '"			\
	     . path_key							\
	     . "'; value is null."					\
	   );
    }

    # Get the value associated with this parameter.
    local path_value = params[ path_key ];

    # If the parameter refers to an absolute pathname, don't resolve
    if ( is_absolute_path( path_value ) ) {
      continue;
    }

    # Find file on E3 paths
    local resolved_path =						\
	compconfig::findFileInPath( path_value,  path_name );

    # If we found the file somewhere, store the absolute path as the
    # parameter value
    if ( resolved_path ) {
      params[ path_key ] = "e3:" . resolved_path;
    }

    # End of iteration:  on to next key
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: expand_frameset_loc
#
# Purpose:	searches 'framesetpath' to translate a relative
#		frameset name to an absolute path.
#
# Parameters:	name:	name to search for
#
# Result:	absolute path or an empty string if no such directory
#		can be found on the frameset path.
# ---------------------------------------------------------------------
function expand_frameset_loc( name ) {

  # Assume 'name' is absolute.
  local result = name;

  # If absolute path, make sure frameset directory exists
  if ( is_absolute_path( name ) ) {

    # If directory doesn't exist or isn't a directory, return null
    if ( !access( name, "e" ) || !file_directory( name ) ) {
      result = "";
    }
  }

  # Not absolute path
  else {

    # look for name on the path list; this will return an empty
    # string if the name isn't found.
    result  = find_file_in_path( name, "e", option( 'framesetpath' ) );
  }

  return result;
}

# set_output_file()
# called from the dialog function to set a default output file
#
function set_output_file(doc, default, output_file_ext)
  {
  local output_file;
  local sourcepath = dirname(absolute_file_name(doc_path(doc)));
  if (sourcepath == '')
  {
      sourcepath = pwd();
      if (substr(sourcepath, length(sourcepath), 1) != main::PCS)
      {
	  sourcepath .= main::PCS;
      }

      if ( !access( sourcepath, "rw"))
      {
         sourcepath = epicutil::temporary_directory() . main::PCS;
      }
  }

  sourcepath = epicutil::canonical_pathname(sourcepath);
  chop(sourcepath); # ditch the trailing backslash

  local fileref = doc_path(doc);
  local dobj = dobj_construct(fileref, 0, 0);
  # If the session is zero, it's a file (-1 on error).
  local sess = dobj_session(dobj);
  if (sess > 0)
  {
    fileref = dobj_get_attr(dobj, "IO_ATTR_NAME");
  }
  # Dispose docobj handle
  dobj_close(dobj);

  local sourcefile = epicutil::file_name(fileref);
  if ( sourcefile == '')
  {
      sourcefile = default;
  }
  local sourcename = basename( sourcefile, ".*");

  if (sess > 0)
    {
      output_file =  epicutil::temporary_directory() . main::PCS . sourcename;
    }
  else
    {
      output_file =  sourcepath . main::PCS . sourcename;
    }
  output_file .= output_file_ext;

  return output_file;
  }

# setViewResult()
#
# This is called if parameter "viewResult" is not set by the ccf
# or by a previous call to the dialog.
#
# It returns "0" if option browserpreview is set to "off", "no", or "0"
# otherwise 1.
#
function setViewResult()
  {
  local setting=tolower(option("browserpreview"));
  if (setting == "off" | setting == "no" | setting == "0") {
	return "0";
    }
  else {
	return "1";
    }
  }

# check_viewfile()
#
# this function also creates the output directory if necessary
# called from the dialog function
#
# If dir != 0, we are just creating the output dir
#
function check_viewfile(&viewhtml, &viewfile, createdir, dir=0)
  {
  if (!dir)
    {
    if (epicutil::is_directory(viewfile)) {
      local errorStr = varsub(agettext('$viewfile is not a valid filename, it is the name of a directory that already exists.'));
      response(errorStr);
      return 0;
      }
    }

  if (viewhtml > 0 && (index(viewfile, "&") > 0)) {
    # It's difficult to call the browser with & in the name because
    # of the vagaries of what it means to the shell, the browser, etc.
    #
    local msg1 = "Cannot launch viewer if filename contains \"&\".";
    local msg2 = "Proceed with publish, disabling viewer?";
    if (response(msg1 . "\n" . msg2, agettext("Yes"), agettext("No")) == 2)
      {
      return -1;
      }
    else
      {
      viewhtml = 0;
      }
    }

  local outdir = dirname(viewfile);
  chop(outdir); # ditch the trailing backslash

  if (!access(outdir, "e"))
    {
    if (createdir) {
      execute("mkdir " . outdir);
      if (!access(outdir, "e")) {
	response(agettext( "Failure creating output directory" ));
        }
      }
    else {
      response(agettext( "output directory does not exist" ));
      }
    }

  return 1;
  }

# setViewRTFResult()
#
# This is called if parameter "viewRTFResult" is not set by the ccf
# or by a previous call to the dialog.
#
# It returns "0" if option rtfpreview is set to "off", "no", or "0"
# otherwise 1.
#
function setViewRTFResult()
  {
  local setting=tolower(option("rtfpreview"));
  if (setting == "off" | setting == "no" | setting == "0") {
	return "0";
    }
  else {
	return "1";
    }
  }

# burst_profile_parameters_from_array()
#
# Takes an array of profile parameters
# and bursts it into parameters for separate filters.
#
# The filters are assumed to be named prof1, prof2, ...
#
# If the filter chain doesn't have enough filters,
# excess parameters will be ignored.
#
function burst_profile_parameters_from_array(profiles[], param_array[])
  {
  if (count(profiles) > 0)
    {
    local item, filter_number=1;

    for (item in profiles)
      {
      local filter_name='prof' . filter_number . '.';

      filter_number++;

      param_array[filter_name . 'targetAttribute'] = item;
      param_array[filter_name . 'targetValue'] = profiles[item];
      }
    }
  }

# burst_profile_parameters_from_string()
# converts a string representation of profile parameters to an array
# and calls burst_profile_parameters_from_array()
#
function burst_profile_parameters_from_string(profiles_string, param_array[], keychar='|')
  {
  local profiles_array[];

  epicutil::UnserializeKeyed(profiles_string, profiles_array, keychar);
  burst_profile_parameters_from_array(profiles_array, param_array);
  }

# ---------------------------------------------------------------------
# Function:	compose :: queueVdocCreation
#
# Purpose:	Sets up parameters in the given array that will cause
#		compose_for_type_int() to set up a virtual document before
#		executing a pipeline whose output is a virtual document.
#		The virtual document is not actually created because the actual
#		document type of the output document may not be known,
#		or might not even exist yet (e.g. composing a DITA map with a
#		dynamically-generated RDStyle document type).
#
# Parameters:	type:	0:	output document should be of the same type
#				as the input document.
#			1:	output document should be an XSLFO
#				document;
#			2:	output document should be an DITA RDS
#				of a type appropriate to the input document;
#			3:	output document should be a clone of the
#				input document;
#		doc:	document being composed (ignored if op == 1)
#		flags:	flag bits, opcode dependent.
#			0x01:	if op == 3, 1 to insert location PIs, 0 to omit
#			0x02:	if op == 0 or 3,
#					0 to force the VDOC to be XML
#					1 to allow the VDOC to be SGML
#					  if the source document is SGML
#		params:	associative array of parameters to populate with new
#				settings for creating the vdoc.
#		paramName:	The param name to use when the vdoc is actually created
#				and added to the parameter array. Defaults to 'docID'.
# Result:	params[ "compose.createVdoc" ] = 1
#		params[ "compose.vdocType" ] = $type
#		params[ "compose.vdocSrcDoc" ] = $doc
#		params[ "compose.vdocFlags" ] = $flags
#		params[ "compose.vdocParamName" ] = $paramName
# ---------------------------------------------------------------------
function queueVdocCreation(type, doc, flags, params[], paramName=P_DOC_ID ) {
  params[ P_CREATE_VDOC ] = 1;
  params[ P_VDOC_TYPE ] = type;
  params[ P_VDOC_SRCDOC ] = doc;
  params[ P_VDOC_FLAGS ] = flags;
  params[ P_VDOC_PARAM_NAME ] = paramName;
}

# ---------------------------------------------------------------------
# Function:	compose :: createVdoc
#
# Purpose:	creates a virtual document ("vdoc") to contain the
#		output of a content pipeline run.
#
#		A vdoc might be an empty document OR it might be an exact
#		clone of the input document (one we can modify) if we want
#		to pretend that we ran the content pipeline when we didn't
#		really need to.
#
# Parameters:	op:	0:	output document should be of the same type
#				as the input document.
#			1:	output document should be an XSLFO
#				document;
#			2:	output document should be an DITA RDS
#				of a type appropriate to the input document;
#			3:	output document should be a clone of the
#				input document;
#		doc:	document being composed (ignored if op == 1)
#		param:	flag bits, opcode dependent.
#			0x01:	if op == 3, 1 to insert location PIs, 0 to omit
#			0x02:	if op == 0 or 3,
#					0 to force the VDOC to be XML
#					1 to allow the VDOC to be SGML
#					  if the source document is SGML
#		ctview:	if not empty the change tracking view to resolve
#			the clone doc to (independent of original view)
#		rdsPublicID: The public ID to use, for RDStyle doctypes.
#		rdsSystemID: The system ID to use, for RDStyle doctypes.
#		rdsURI: The namespace URI to use, for RDStyle doctypes.
#
# Result:	-1 or a valid document ID.
# ---------------------------------------------------------------------
function compose::createVdoc( op, doc, param, ctview="", rdsPublicId="", rdsSystemId="", rdsURI="" ) {
  local result = -1;

  # Exit if we need the input document and it's invalid.
  if ( op != 1 && !doc_valid( doc ) ) {
    compose::error( "Internal error:  invalid document ID '"		\
		    . doc						\
		    . "' passed to compose::createVdoc."		\
		  );
    return -1;
  }

  # If we should clone original document, do so
  if ( op == 3 ) {
    # CR 66858:	(these comments no longer apply)
    #			don't set the '0x02' (observe change tracking) flag
    #			allow the user to control using compose::changetracking
    #
    # SPR 1259006:	DO use '0x02' but allow compose::changetracking
    #			to override.

    # 0x02:  change tracking
    # 0x08:  make XML document
    # 0x20:  insert location PIs
    # 0x40:  clone document name
    local cloneFlags	 = 0x02 | 0x40;

    # If we're not forbidden to force the VDOC to be XML, do so
    if ( !( param & CVD_ALLOW_SGML ) ) {
      cloneFlags |= 0x08;
    }

    # If we're supposed to insert PIs pointing back to original document
    if ( param & CVD_INSERT_LOCN_PIS ) {
      cloneFlags |= 0x20;
    }

    # Clone document
    result = doc_clone( doc, cloneFlags, ctview );

    # SPR 1973704:  flatten the clone so that changes made aren't reflected
    # back to the original document or to the entities/xincludes that the
    # original document references.
    if ( doc_valid( result ) ) {
      doc_flatten( "file+include", 0, result );
    }

    return result;
  }

  # If the new document should be an empty version of the old, create it.
  # The new document WILL inherit entity declarations from the source document.
  if ( op == 0 ) {
    # 0x01:  don't clone content;
    # 0x08:  make XML document;
    # 0x40: clone name
    local cloneFlags = 0x01 | 0x40;

    # If we're not forbidden to force the VDOC to be XML, do so
    if ( !( param & CVD_ALLOW_SGML ) ) {
      cloneFlags |= 0x08;
    }

    result = doc_clone( doc, cloneFlags );

    return result;
  }

  # 0x200 (no stylesheet) 0x100 (xml) 0x40 (forcedt) 0x020 (quiet)
  local openFlags = 0x200 | 0x100 | 0x40 | 0x20;

  # If we should create an xsl-fo VDOC
  if ( op == 1 ) {
    local foPublicId = "-//Arbortext//DTD XSL fo-result//EN";

    result = doc_open( "", openFlags, "", foPublicId );

    return result;
  }

  # We're supposed to generate an RDS.  Determine its doctype.
  local publicId = "", systemId = "", rds = 0;
  if (rdsURI) {
    openFlags |= 0x40000;
    publicId = rdsURI;
    rds = 1;
  }
  else if (rdsPublicId || rdsSystemId) {
    publicId = rdsPublicId;
    systemId = rdsSystemId;
    rds = 1;
  }
  else {
    if ( public_id_path( publicId ) == ""				\
 		&& doc_type_dir( doc ) != ""					\
 		&& system_id( doc ) != ""					\
    ) {
      systemId = doc_type_dir( doc ) . main::PCS . system_id( doc );
    }
  }

  local name = "*" . doc_name( doc );

  result = doc_open( "", openFlags, name, publicId, systemId );

  # If we opened an RDStyle document with a dynamic DTD, we need to associate
  # the correct DCF file with it.
  if (rds && doc_valid(result)) {
    local dcf = find_dita_rd_dcf("ditaRDStyle", doc);
    if (dcf) {
      doc_set(result, "dcffile", dcf);
    }
  }

  return result;
}

# ---------------------------------------------------------------------
# Function:	create_empty_clone
#
# Purpose:	Clones the given document. The cloned document will contain
#			the same root element as the source document but no other
#			content.
#
# Parameters:	p_doc:          doc to clone
# ---------------------------------------------------------------------
function create_empty_clone( p_doc ) {
  if ( !doc_valid( p_doc ) ) {
    return 0;
  }

  local l_clone = doc_clone(p_doc, 1);
  if (doc_valid(l_clone)) {
    local l_rootTag = oid_name( oid_root( p_doc ) );
    local old_doc = current_doc( l_clone );

    it "$l_rootTag";
    current_doc(old_doc);
    return l_clone;
  }
  return 0;
}

# ======================================================================
# Function:	compose::stylesheetAvailable()
#
# Purpose: 	Test if a stylesheet file can be accessed and optionally
#		warn it fit can't.
#
# Parameters:
#               stylesheet: 	path to stylesheet to test
#               doc:		document to reference in warning message
#               quiet:		if true, don't warn on failure
#
# Result:       1 on success (stylesheet available), or 0 on failure
# ======================================================================

function stylesheetAvailable(stylesheet, doc, quiet=0)
{
    local rc;
    if (stylesheet != "" && access(stylesheet,"er")) {
        rc = 1;
    } else {
        rc = 0;

        if (!quiet) {
            local msg = agettext( "The stylesheet '%s' for document '%s' does not exist or cannot be read." );
            sub('\%1\$s',stylesheet, msg);
            sub('\%2\$s',doc_name(doc),msg);
            warning( msg );
        }
    }
    return rc;
}

# ======================================================================
# Function:	compose::openPipelineDoc()
#
# Purpose: 	Open the serialized pipeline "bigjob" document with the
#		appropriate doctype.
#
#		NOTE:  much of the same logic appears in
#		appsnapx::executeDir().  Make changes in both places.
#
# Parameters:	doc:			original document being composed
#		pipelineOutputFile:	path to serialized intermediate result
#		params[]:		current composition parameters
#		interactive:		1 if running interactively
#
# Result:       doc identifier on success, or 0 on failure
# ======================================================================
function openPipelineDoc( doc,						\
			  pipelineOutputFile,				\
			  params[],					\
			  interactive					\
			)
{
  # make sure file exists
  if ( !access( pipelineOutputFile, "r" ) ) {
    local x   = pipelineOutputFile;
    local msg = agettext( "Pipeline output document '$x' does not "	\
			  . "exist or is not accessible."		\
			    );
    local msg1= varsub( msg );
    set_errmessage( msg1, interactive );
    return 0;
  }

  # make sure file is not empty
  if (file_size( pipelineOutputFile ) == 0) {
    local x   = pipelineOutputFile;
    local msg = agettext( "Pipeline output document '$x' is empty." );
    local msg1= varsub( msg );
    set_errmessage( msg1, interactive );
    return 0;
  }

  # 0x0002:  force read/write capability
  # 0x0004:  suppress locking
  # 0x0010:  suppress completeness check
  # 0x0020:  suppress parser messages
  # 0x0040:  use the publicid and systemid
  # 0x0100:  open as XML (not SGML)
  # 0x0200:  suppress stylesheet load
  # 0x0400:  suppress missing doctype prompt
  # 0x800000:  don't convert PUB PIs to elements

  # SPR 2141440:  don't use 0x0200 ("suppress stylesheet load"); that'll keep
  # us from learning useful things from the stylesheet, like what elements
  # are "as-is".

  local flags = 0x0002 | 0x0004 | 0x010 | 0x020 | 0x040 | 0x0400;

  # This will only be set if we're composing using APP.
  if ( params[ "convertPI" ] == "false" ) {
    flags |= 0x800000;
  }

  # SPR 2162858:  if we're not loading an XSL-FO document, then the document
  # we're reading is either of the same doctype as the source document or
  # an RDS.  In either case, the document might contain a stylesheet
  # association naming a relative path.  Specify the edit stylesheet
  # explicitly to avoid a window popping up with a warning.

  # If the document HAS no edit stylesheet, don't complain. It might be an
  # in-memory DITA map.
  local editStylesheet = "";

  if ( params[ "stylesheetType" ] != "xsl" ) {
    editStylesheet = doc_get( doc, "stylesheet" );

    # Make sure the Stylesheet is available
    if ( !stylesheetAvailable( editStylesheet, doc ) ) {
      editStylesheet = "";
    }
  }

  local publicId = "", storageId = "";

  # If the pipeline output document is XSL-FO
  if (params["stylesheetType"] == 'xsl') {
    # now have xslfo doc
    publicId = "-//Arbortext//DTD XSL fo-result//EN";
    flags |= 0x0100;  # XML
  }

  # If the input document was DITA
  else if (doc_type_dita(doc)) {

    # original doc was a dita doc so the serialized file is always an rdstyle
    # doc so use rdstyle doctype specified in the .dcf file of the map

    publicId = params['ditaRDSIdentifier'];
    storageId = params['ditaRDSStorage'];
    local keywordType = params['ditaRDSKeyword'];

    # If this is an old RDS then need to get the correct values if Dynamic
	if ( !params[ P_DITA_USE_NEW_RDS ] ) {
		if (keywordType == 'SYSTEM') {
			storageId = publicId;
			publicId = "";
		}
	}

	# Special case for Old / New RDS
	if (keywordType == 'URI') {
   		flags |= 0x40000; # the identifier is a URI and not a PUBLIC ID
   		storageId = "";
   	}

    # Old PRDS or new RDS, it's an XML document
    flags |= 0x0100;  # XML

  }

  # Input document wasn't DITA
  else {
    # use original doc's .dtd/.xsd
    storageId = doc_type_file(doc);
    # force XML if print engine is APP
    if (doc_kind(doc) != "sgml" || params["stylesheetPrintEngine"] == "app") {
      flags |= 0x0100;  # XML
    }
  }

  # convention for name is to use original docname prefixed by '*'
  local name = "*" . doc_name(doc);

  local vdocID = doc_open( pipelineOutputFile, \
			   flags, \
			   name, \
			   publicId, \
			   storageId, \
			   editStylesheet \
			 );

#        doc_set(vdocID, "stylesheet", editStylesheet);


  # If read fails, echo a message and return failure.
  if ( !doc_valid( vdocID ) ) {
    local x   = pipelineOutputFile;
    local err = main::ERROR;

    if ( err == "" ) {
      err = agettext( "no specific error message" );
    }

    local msg = agettext( "Unable to read pipeline output document '$x' ($$err)." );

    local msg1= varsub( msg );
    set_errmessage( msg1, interactive );
    return 0;
  }

  # note success
  compose::debug_out( caller(1) . ": opened file '" . pipelineOutputFile \
		      . "' as vdoc '" . vdocID . "' using doctype '"	\
		      . doc_type_file(vdocID) . "' and stylesheet '"	\
		      . editStylesheet . "'."				\
		    );

  # make sure document isn't HTML or ASCII
  local pofKind = doc_kind( vdocID );
  if ( pofKind != "xml" && pofKind != "sgml" ) {
    local x   = pipelineOutputFile;
    local y   =  pofKind;
    local msg = agettext( "Pipeline output document '$x' is of " \
		        . "type '$y'; expected type 'xml' or 'sgml'." );
    local msg1= varsub( msg );
    set_errmessage( msg1, interactive );
    doc_close( vdocID );
    return 0;
  }

  return vdocID;
}

# compose_viewhtml()
# Bring up the browser on the given output file
#
function compose_viewhtml(htmlfile, interactive=0 ) {
  local browser = pub_util::getBrowser();

  if ( browser == "" ) {
    browser = get_browserpath( 1 );
  }

  if ( browser != "" ) {
    htmlfile = epicutil::canonical_pathname( htmlfile );

    if ( interactive ) {
      epicutil::msg(agettext("Running browser..."), current_window());
    }

    pub_common::launchPubViewer( browser, htmlfile );
  }
}

# compose_viewrtf()
# Bring up the RTF viewer (typically MS Word)
# on the given RTF output file
#
function compose_viewrtf(rtffile)
{
  local rtf_viewer = _import_export::view_rtf_file( rtffile);

  if (rtf_viewer != "")
  {
    rtffile = epicutil::canonical_pathname(rtffile);
    epicutil::msg(agettext("Running RTF viewer ..."), current_window());
  }
}

# Returns the value of the 'pdfviewer' set option.
# Optionally prompts the user for one if needed and
# performs some verification of the value.
#
function get_pdf_viewer(prompt=0)
{
  local pdfViewer = option('pdfviewer');
  if ( epicutil::is_pc() ) {
    # get from file association
    pdfViewer = main::_find_exe("${main::aptpath}\\lib\\testpdf.pdf");
    return pdfViewer;
  }
  if (!pdfViewer) {
    pdfViewer = "acroread";  # unix default
  }

  for (;;) {
    local fullPath = pdfViewer;
    local was_found = 0;
    if (!index(pdfViewer, main::PCS)) {
      # no path components, search PATH list
      fullPath = find_file_in_path(pdfViewer, "x");
      if (fullPath) {
	was_found = 1;
      }
      else {
	fullPath = pdfViewer;
      }
    }
    if (access(fullPath, "x")) {
      # Looks like a good value!

      # If we changed something, ensure it is written out!
      if (pdfViewer != option('pdfviewer')) {
	set -preference pdfviewer="$pdfViewer";
	write_preferences();
      }

      return fullPath;
    }

    if (!prompt) {
      return "";
    }

    if (!was_found) {
      # Complain about bad value.
      local message = varsub(agettext("The specified PDF viewer path (\$pdfViewer) does not exist or is not executable."));
      response(message);
    }

    local title = agettext("PDF Viewer Path");
    local prompt = agettext("Please enter the name of your PDF viewer program.\nYou must specify a full path name if the executable is not\nin your path.\n\nPDF Viewer Program Path");

    readvar -title $title -prompt $prompt pdfViewer;
    if (main::status != 0) {
      pdfViewer = "";
      break;			# user cancelled
    }
  }

  return pdfViewer;
}

# This is tied to the SE_ERR_NOASSOC windows error constant as returned
# by the ShellExecute() function.
global VPF_NO_ASSOC_ERR = 31;

# Returns 0 on success and non-zero on an error.
function main::view_pdf( outfile, msgwin=0 )
{
  outfile = epicutil::canonical_pathname(outfile);

  if (!access(outfile, "r")) {
    local err = varsub(agettext("The PDF document \"$outfile\" does not exist or is not accessible."));
    main::error(err);
    return 1;
  }

  if (msgwin != -1) {
    epicutil::msg( agettext("Launching PDF viewer..."), msgwin );
    }

  if ( epicutil::is_pc() ) {
      local rc = _view_pdf_file( outfile );
      if ( rc != 0 && msgwin != -1) {
        epicutil::msg( agettext("Unable to launch PDF viewer."), msgwin );
      }

      if (msgwin != -1 && rc == VPF_NO_ASSOC_ERR) {

        # This is a very specific error that happens where there is
        # no associated viewer for the .pdf extension.  In this case,
        # on Windows, we'll display a message that will be more useful
        # than the generic status bar message output above.

        # This link is sanctioned by adobe.com as one of the links to put
        # on your website for users to go get Adobe Reader.  Thus, I think
        # it is OK to bake this in since it is inlikely Adobe would break
        # this link.
        local site = 'http://www.adobe.com/products/acrobat/readstep2.html';

        local msg = varsub(agettext("There is no PDF viewer program installed.  Adobe Reader can be downloaded for free from\n\n\$site\n\nWould you like to visit this web page now?"));
        local ans = response(msg, agettext('Yes'), agettext('No'));

        if (1 == ans) {
          www::www_open_browser_url(site);
        }
      }

      return rc;
    }

  local ret_val = 1;

  # get viewer path from "set" option
  local viewerPath = get_pdf_viewer(msgwin != -1);
  if ( !viewerPath ) {
    if (msgwin != -1) {
      response( agettext("PDF viewer not specified.") );
    }
  } else {
    local cmdline = viewerPath .  " '" . outfile . "' &";

    # Zero on success.
    ret_val = system( $cmdline );
  }

  return ret_val;
}



function array_to_param_string(arr[])
# takes 1 arg which is an associative array
# and returns a string in the form
#   "name1=value1||name2=value2" etc.
# where the nameI values are the subscripts of the array and the
# valueI values are the corresponding array value.
#  Escaping is done using the \ character.
# All = characters and any || strings are escaped
# in the param_string form.
#
# Revised 2002 November 26 (pbg) -- created
#
{
	local name, value
	local str=''

	for (name in arr)
		{
		value = arr[name]
		gsub('=','\=',name)
		gsub('\|\|','\||',name)
		gsub('=','\=',value)
		gsub('\|\|','\||',value)
		str .= name . '=' . value . '||'
		}

	chop(str,2)

	return str
}

function param_string_to_array(str,arr[])
# takes 2 args, the first of which is a string of the form
#   "name1=value1||name2=value2" etc.
# and the second of which is
# an array variable used to return an associative array
# where the nameI values are the subscripts of the array and the
# valueI values are the corresponding array value.
# The function returns as its value the number of array elements
#
# Revised 2002 November 26 (pbg) -- created
#
{
	local match_pat1='([^=\]*)(.?)(.*)'
	local match_pat2='([^|\]*)(.?)(.*)'

	local count=0

	while (str != '')
		{
		local name='', value=''
		while ((str != '') && (match(str,match_pat1) != 0))
			{
			name .= match_result(1)
			local mr2 = match_result(2)
			str = match_result(3)
			if (mr2 == '=') { break }
			# move first char of str (which was escaped) to name
			name .= substr(str,1,1)
			str = substr(str,2)
			}

		while ((str != '') && (match(str,match_pat2) != 0))
			{
			value .= match_result(1)
			local mr2 = match_result(2)
			str = match_result(3)
			if (mr2 == '|')
				{
				if (substr(str,1,1) == '|')
					{
					# || found, remove second | from str and exit loop
					str = substr(str,2)
					break
					}
				else
					{
					# just add this unpaired | to value
					value .= mr2
					}
				}
			else
				{
				# move first char of str (which was escaped) to value
				value .= substr(str,1,1)
				str = substr(str,2)
				}
			}

		# We trim non-embedded whitespace from the name
		name = trim(name)
		# entries with null names are ignored
		if (name == "") { continue }
		if (arr[name] == "")
			{
			count++
			}
		arr[name]=value
		}

	return count
}


# ----------------------------------------------------------
# Function:	compose :: set_xsl_parameters
#
# Purpose:	Adds a bunch of parameters to a parameter string
#		in an associative array
#
# Parameters:	xsl_params:	associative name/value array of XSL parameters
#		ccf_params:	associative name/value array of parameters
#		param_name:	name of XSL parameter string in 'ccf_params';
#				this name is 'transformerParams' in all
#				distributed CCFs
#
# result:	none
#
# Revised 2003 January 16 (afang) -- add doc and change the last line of code
# it was ccf_params[param_name] = array_to_param_string(xsl_params);
# -------------------------------------------------------------
function set_xsl_parameters( xsl_params[],				\
			     ccf_params[],				\
			     param_name="transformerParams"		\
			   ) {

  # Extract existing XSL parameter string
  local params = ccf_params[ param_name ];

  # If there is no existing XSL parameter string, just transform
  # the array we were given into a string and stow it
  if ( params == "" ) {
    ccf_params[ param_name ] = array_to_param_string(xsl_params);
    return;
  }

  local new_params[];
  local item;

  # Copy existing XSL parameters into associative array new_params
  param_string_to_array( params, new_params );

  # Copy new XSL parameters into array with old parameters
  for ( item in xsl_params ) {
    new_params[ item ] = xsl_params[ item ];
  }

  # Encode all parameters as a string and stow back in ccf_params
  ccf_params[ param_name ] = array_to_param_string( new_params );
}

# ---------------------------------------------------------------------
# Function:	compose::initialize_e3_composition
#
# Purpose:	a) determines whether the required composer is installed
#		   on the E3 server;
#		b) determines whether the required doctype is installed
#		   on the E3 server;
#		c) sets up the parameter array with the default values
#		   for the composer and doctype
#
# Parameters:	params:		array to be filled with parameters
#		comp_type:	composition type
#		doc:		document to be composed
#
# Result:	"":		success
#		error message:	failure
# ---------------------------------------------------------------------
function compose::initialize_e3_composition( params[], comp_type, doc ) {

  # Get default composition parameters
  local rc = compconfig::getDefaultCompositionParameters( params,	\
							  comp_type,	\
							  doc		\
							);

  params[ "e3.sourceDocument"  ] = doc;
  params[ "e3.compositionType" ] = comp_type;
  params[ "e3.asynchronous"    ] = 0;

  return rc;
}

# ---------------------------------------------------------------------
# Function:	compose::e3_compose
#
# Purpose:	creates an E3 composition request based upon the
#		parameter array, transmits it to E3 for processing,
#		and returns the result
#
#		For a synchronous operation, the Java layer won't return
#		until E3 returns a response and the post-processing routine
#		has run.
#
#		For an asynchronous operation, the Java layer will return
#		at once; the response from E3 and the post-processing routine
#		will run on a background thread at some future time.
#
# Parameters:	inParams:	associative array of name/value pairs
#				to be transmitted to E3.
#
#		The array element with key 'e3.parameterTypes' is
#		first split into a name/value 'type' array.
#
#		The name of each 'type' array entry corresponds to
#		a name in 'inParams'.
#
#		The value of eacy 'type' array entry specifies the
#		type of each parameter in 'inParams'.
#
#		If a parameter in 'inParams' does not have a corresponding
#		'type' array entry, its type is taken to be 'string'.
#
#		A parameter's type determines how it is incorporated
#		into the request sent to E3.  The following types are valid:
#
#		'string':	parameter is passed to E3 unchanged.
#
#		'file':		parameter is passed to E3 unchanged.  It's
#				taken to specify the absolute path name to
#				a file on the E3 server.
#
#		'entry':	parameter is assumed to contain
#				the absolute path name of a file on the client
#				machine.  The file is copied into the JAR
#				that is built and transmitted to E3.
#
#		'document':	parameter is assumed to contain the absolute
#				path name of a file on the client machine, but
#				the file is assumed to be an SGML or XML
#				document.  It is opened and run through an
#				Epic pipeline that flattens entities and
#				copies graphics into the JAR file as well.
#
#		'opendoc':	parameter value is interpreted as the Epic ID
#				of an already-open document; the document
#				is processed as described for the 'document'
#				parameter above.
#
#		'local':	parameter is assumed to be of interest only
#				to the client.  It is not transmitted to E3
#				at all, but passed to the composition client
#				extension classes.
#
# Result:	-2:	error already displayed to user
#		-1:	user abort
#		 0:	failure
#		 1:	success
#		 2:	async operation started with PE server.
# ---------------------------------------------------------------------
function compose::e3_compose( inParams[] ) {

  # Inform the user that we're composing with PE.
  msg( agettext( "Preparing for transmission to PTC Arbortext "		\
		 . "Publishing Engine..."				\
	       ),							\
       inParams								\
     );

  # Extract parameter type information so we can modify it.
  local parameterTypes[];

  if ( "e3.parameterTypes" in inParams ) {
    epicutil::UnserializeKeyed( inParams[ "e3.parameterTypes" ],	\
				parameterTypes,				\
				"|"					\
			      );
  }

  # Don't pass these parameters to the PE server:
  parameterTypes[ "compose.postProcessor" ] = "local";
  parameterTypes[ "compose.traceObject"   ] = "local";
  parameterTypes[ "compose.traceObjectId" ] = "local";
  parameterTypes[ "interactive" ]           = "local";
  parameterTypes[ P_DITA_SETUP_RDS	  ] = "local";
  parameterTypes[ P_DITA_RDS_TEMPDIR	  ] = "local";

  # Make sure the server knows what version we are
  inParams[ "e3.clientProductName"   ] = _custom::get_running_product();
  inParams[ "e3.clientVersionBuild"  ] = main::version_build;
  inParams[ "e3.clientVersionDate"   ] = main::version_date;
  inParams[ "e3.clientVersionNumber" ] = main::version_number;

  parameterTypes[ "e3.clientProductName"   ] = "string";
  parameterTypes[ "e3.clientVersionBuild"  ] = "string";
  parameterTypes[ "e3.clientVersionDate"   ] = "string";
  parameterTypes[ "e3.clientVersionNumber" ] = "string";

  # Send our screen DPI setting so that the server will process graphics
  # just as we would if the operation were running locally.
  inParams[	  "e3.defaultScreenDpi" ] = option( "defaultscreendpi" );
  parameterTypes[ "e3.defaultScreenDpi" ] = "string";

  # Send our 'debugcomposition' option so that the server will return
  # extra information if we want it.
  inParams[	  "e3.clientDebugComposition"	] = option("debugcomposition");
  parameterTypes[ "e3.clientDebugComposition"   ] = "string";

  # If we're composing a DITA map, send the PRDS, not the map itself,
  # to PE for processing.
  if ( inParams[ P_DITA_DOCTYPE ] == "map" ) {
    if ( inParams[ P_DITA_USE_NEW_RDS ] ) {
      inParams[ "e3.sourceDocument" ] = inParams[ P_DITA_RDS_ID ];
    }
    else {
      inParams[ "e3.sourceDocument" ] = inParams[ P_DITA_PRDS_ID ];
    }
  }

  # If we're using a dynamic RDS, include the RDS DTD in the JAR
  if ( rdgen::is_dynamic_rd_doc( inParams[ "e3.sourceDocument" ] ) ) {
  	inParams[ "compose.dita_dynamic_rds_dtd" ] = doc_type_file( inParams[ "e3.sourceDocument" ] );
  	parameterTypes[ "compose.dita_dynamic_rds_dtd" ] = "entry";
  }

  # Re-encode parameter type data so the hook can access it
  inParams[ "e3.parameterTypes" ] =					\
    epicutil::SerializeKeyed( parameterTypes, '|' );

  # Invoke the composition framework callback
  local hookRc = callFrameworkHook( inParams[ P_COMP_DOCUMENT ],	\
				    HK_CFTI_PE_INIT,			\
				    inParams				\
				  );

  if ( hookRc < 0 ) {
    return hookRc;
  }

  # Extract the parameter types again, in case the hook changed them
  epicutil::UnserializeKeyed( inParams[ "e3.parameterTypes" ],		\
			      parameterTypes,				\
			      '|'					\
			    );

  # Send the request to E3
  inParams[ P_COMP_E3RESULT ] = compclient::compose( inParams,		\
						     parameterTypes	\
						   );

  # Call the composition hook
  hookRc = callFrameworkHook( inParams[ P_COMP_DOCUMENT ],		\
			      HK_CFTI_PE_SENT,				\
			      inParams					\
			    );

  if ( hookRc < 0 ) {
    return hookRc;
  }


  if ( inParams[ P_COMP_E3RESULT ] == "async" ) {
    return 2;
  }

  if ( inParams[ P_COMP_E3RESULT ] != "ok" ) {
    set_errmessage( inParams[ P_COMP_E3RESULT ], 0, 1 );
    return 0;
  }

  # The Java layer ran the postprocessor (or will run it later if the
  # transaction was queued.)

  # If this was a queued transaction, launch the queued transaction viewer
  # if interactive, then return '1'.
  if ( inParams[ P_COMP_QUEUE ] == "yes"				\
       && inParams[ P_COMP_E3COMPOSITION ]				\
     ) {

    # If interactive
    if ( inParams[ P_COMP_INTERACTIVE ] 				\
	 || inParams[ P_COMP_RULE_INTERACTIVE ]				\
       ) {
      local viewTransaction = preference( "pequeuedisplay" );

      if ( viewTransaction == "on" ) {
	queuetransview::viewQueuedTransactions( 1 );
      }
    }

    return 1;
  }

  # For an immediate transaction, the postprocessor result is stored
  # in global storage.
  return e3PostprocessorRc;
}

# ---------------------------------------------------------------------
# Function:	compose :: callPostProcessorForE3
#
# Purpose:	calls a composition pipeline postprocessor for E3
#		(because Java can't pass an associative array directly
#		to ACL)
#
# Parameters:	doc:		document ID to pass
#		warnKey:	key identifying the (possibly empty)
#				list of 'missing graphic' warning messages
#				associated with this operation
#
# Result:	return code from postprocessor, as follows:
#		-1:		user abort
#		0:		error
#		1:		success
# ---------------------------------------------------------------------
function compose::callPostProcessorForE3( doc, warnKey ) {

  debug_out( "compose::callPostProcessorForE3:  doc = '"		\
	     . doc							\
	     . "'."							\
	   );

  # Copy any deferred warning messages into our queue
  while ( 1 ) {
    local warningMsg = java_static( "com.arbortext.e3c.ClientComposer",	\
				    "popMissingGraphicWarning",		\
				    warnKey				\
				  );

    if ( warningMsg == "" ) {
      break;
    }

    warning( warningMsg );
  }

  # Find the Java object (actually a Map<String,String>) that contains
  # our name/value parameter array.
  local mapObject = java_static( "com.arbortext.e3c.ClientComposer",	\
				 "getPostProcessorParameters"		\
			       );

  local paramArray[];

  java_array_to_acl( mapObject, paramArray );

  java_delete( mapObject );

  mapObject = "";

  # Call the composition framework hook
  local hookRc =							\
    callFrameworkHook( doc, HK_CFTI_PE_POSTPROC, paramArray );

  if ( hookRc < 0 ) {
    window_update();
    return hookRc;
  }

  # SPR 1673895:  we used to call compose::postprocessForDita
  # from this point.  That would close the PRDS vdoc.
  # Unfortunately, control never reaches this routine if PE returned
  # an error.  So we call compose::postprocessForDita just before
  # transmitting our request to PE instead.

  # Retrieve postprocessor function name, flag
  local postProcessor = paramArray[ P_COMP_POSTPROC_CB ];
  local interactive   = paramArray[ P_COMP_INTERACTIVE ];

  # If no postprocessor, assume success
  if ( postProcessor == "" ) {
    debug_out( "No ACL postprocessor specified; skipping call." );
    paramArray[ P_COMP_POSTPROC_RC ] = 1;
  }

  # Call postprocessor.  Save RC so hook can access it.
  else {
    # Run the postprocessor.
    paramArray[ P_COMP_POSTPROC_RC ] = ( *postProcessor )( doc,		\
							   paramArray,	\
							   interactive	\
							 );
  }

  # Final call to the framework hook
  hookRc = callFrameworkHook( doc, HK_CFTI_PE_DONE, paramArray );

  if ( hookRc < 0 ) {
    rc = hookRc;
  }

  # Eliminate the hourglass cursor
  window_update();

  # Save postprocessor RC for return from compose_for_type_int.
  e3PostprocessorRc = paramArray[ P_COMP_POSTPROC_RC ];

  # Finish the composer log entry.  It was started by ClientComposer.
  if ( !paramArray[ P_COMP_RULE_INTERACTIVE ] ) {
    finish_log( paramArray );
  }

  return paramArray[ P_COMP_POSTPROC_RC ];
}

# ---------------------------------------------------------------------
# Function:	compose :: getXslFromStylerPath
#
# Purpose:	compiles a .style file into an XSL stylesheet or FOSI
#
# Parameters:	stylerPath:	absolute path to .style file
#		type:		composition type being performed OR
#				a type code for a special stylesheet
#				(see _style.acl)
#		doc:		document being composed
#               printPdfEngine:	if type is print or pdf, this is the engine
#				to use ('fosi', 'app', or 'xsl'/'xsl-fo')
#		useFosiExpr:	if type is 'tablefixXSL', indicates
#				whether which flavor of reordering
#				stylesheet to produce
#		params:		composition parameter array
#
# Result:	path to .xsl file
#		path to .style file (if the .style file indicates a FOSI
#		                     for this composition type)
#		"" (error)
# ---------------------------------------------------------------------
function getXslFromStylerPath( stylerPath,				\
			       type,					\
			       doc,					\
			       printPdfEngine,				\
			       useFosiExpr,				\
			       params[]					\
			     )
{
  debug_out( "compose::getXslFromStylerPath:  stylerPath = '"		\
	     . stylerPath						\
	     . "', type = '"						\
	     . type							\
	     . "', doc = '"						\
	     . doc							\
	     . "', printPdfEngine = '"					\
             . printPdfEngine						\
	     . "' useFosiExpr = '"					\
	     . useFosiExpr						\
             . "'."                                                     \
	   );

  if ( stylerPath == '' ) {
    debug_out( "compose::getXslFromStylerPath:  path is null." );
    return ''
  }

  local closeDoc = 0;

  # Find the open document corresponding to the .style file.  If not,
  # try to open one.
  local sDoc = path_doc( stylerPath );

  if ( doc_valid( sDoc ) ) {
    debug_out( "compose::getXslFromStylerPath:  sDoc = '" . sDoc . "'." );
  }
  else {
    local flags = 0x2 | 0x010 | 0x020 | 0x100 | 0x200 | 0x400;

    sDoc = doc_open( stylerPath, flags );

    # We opened it, so we need to close it!
    closeDoc = 1;

    if ( !doc_valid( sDoc ) ) {
      debug_out( "compose::getXslFromStylerPath:  doc_open failed." );
      return '';
    }

    debug_out( "compose::getXslFromStylerPath:  opened doc '" . sDoc . "'." );

    # Check to make sure that the stylesheet is the latest version.  If we're
    # running as the PE server, don't warn the user about saving anything.
    local emitMustSaveMsg = !main::is_e3;
    local rc              = main::styler_update( sDoc,			\
						 emitMustSaveMsg,	\
						 1,			\
                                                 doc                    \
					       );

    debug_out( "compose::getXslFromStylerPath:  styler_update "		\
	       . "returned '"						\
	       . rc							\
	       . "'."							\
	     );

    # -1 = user cancel, 0 = error, 1 = update succeeded, 2 = no update needed
    if ( rc < 1 ) {
      doc_close( sDoc );
      return "";
    }

    # SPR 2034751:  if an update was needed, don't close the document;
    # if we're composing a DITA document, we'll be back through here
    # many times, and we don't want to prompt each time.
    if ( rc == 1 ) {
      closeDoc = 0;
    }
  }

  # If the stylesheet is to be used for printing or PDF generation
  if ( type == 'print' || type == 'pdf' ) {

    if ( printPdfEngine == 'fosi' || printPdfEngine == 'app' ) {
      if ( printPdfEngine == 'fosi' ) {
	# Use FOSI for preview. If no FOSI has been
	# created, the composition process will create it.
	local fDoc = xsltdoc_fosidoc( sDoc );

	if ( doc_valid( fDoc ) ) {
	  # Make sure FOSI is up to date.
	  # First get appropriate flags value for "all outputs"
	  # (keeps fosi caching happy).
	  # Then add in other flags.
	  local flags = _styleexportfosi::getOutputFlag();

	  # We always want to link the FOSI doc to the style doc
	  flags |= _styleexportfosi::getOutputFlag("linkstylesheets");

	  fDoc = styler_update_fosi_doc( fDoc, -1, flags );

	  if ( doc_valid( fDoc ) && fosi_needs_compile( fDoc ) ) {
	    fosi_compile(fDoc, doc);
	  }
	}
      }

      # Return name of the .style file; 'print composed', 'format', or
      # 'preview' will convert it into the name of a FOSI.
      debug_out( "compose::getXslFromStylerPath:  returning '"		\
		 . stylerPath						\
		 . "'."							\
	       );
      return stylerPath;
    }

    # Make sure the printPdfEngine argument is set by all
    # the callers doing print or pdf composition
    else if ( printPdfEngine != "xsl" && printPdfEngine != "xsl-fo" ) {
      eval caller(0), "Unexpected value for "			\
	. "printPdfEngine: $printPdfEngine" output=*debug;
      _ssutils::show_callers(10);
    }

    # .style file should generate an XSL stylesheet that will yield an
    # XSL-FO document.  Proceed as if that's what the user requested.
    type = 'fo';
  }

  # Translate .style file into .xsl file
  local result = _styler::genXslStylesheet( type,			\
					    '',				\
					    sDoc,			\
					    '',				\
					    0x2,			\
					    0,				\
					    doc,			\
					    useFosiExpr			\
					  );
  if ( closeDoc ) {
    queueStylesheetClose( params, sDoc );
  }

  debug_out( "compose::getXslFromStylerPath:  returning '"		\
	     . result							\
	     . "'."							\
	   );

  return result;
}

# ---------------------------------------------------------------------
# Function:	compose::get_doc_stylesheet
#
# Purpose:	Get the indicated stylesheet type for the doc;
#		if none set, get the doc stylesheet if it is valid
#		for indicated use; otherwise return ""
#
# Parameters:	doc:		document to be composed
#		comp_type:	composition type
#		stylesheet_ype: "htmlstylesheet", "htmlhelpstylesheet",
#				"webstylesheet","printstylesheet". "rtfstylesheet",
#				"dmpstylesheet"
#
#
# Result:	stylesheet name or "" if no appropriate stylesheet found
#
# ---------------------------------------------------------------------
function compose::get_doc_stylesheet( doc, stylesheet_type, comp_type )
{
  local stylesheet = doc_get( doc, stylesheet_type );
  if (stylesheet == "") {
    stylesheet = doc_get( doc, "stylesheet");
    local label, version;
    if (!stylesheet_valid_for_use(stylesheet, comp_type, \
					label, version)) {
      stylesheet = "";
    }
  }

  return stylesheet;
}

# ---------------------------------------------------------------------
# Function:	compose :: removeTemporaryFile
#
# Purpose:	Either deletes a temporary file or leaves it alone
#		(for debugging) and notes the fact.
#
# Parameters:	name	absolute path to file to be deleted
#
# Result:	none
# ---------------------------------------------------------------------
function compose::removeTemporaryFile( name ) {

  if ( compose::debug == 0 ) {
    remove_file(name);
  }
  else {
    compose::debug_out( "compose::removeTemporaryFile:  file '"		\
			. name						\
			. "' not deleted."				\
		      );
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: doSerializePipelineOutput
#
# Purpose:	Normally when we run a document through a content pipeline,
#		either to apply profiling or to apply an XSL stylesheet,
#		we build the output document in memory.
#
#		For very large documents, this uses too much memory.  So
#		sometimes we need to write the output document to disk
#		as we build it.
#
#		This routine determines whether to use the build-in-memory
#		(small document) or build-on-disk (large document) behavior.
#
# Parameters:	doc:		document being formatted
#		params:		composition parameters
#
# Result:	0:	build in memory
#		1:	build on disk
# ---------------------------------------------------------------------
function compose::doSerializePipelineOutput( doc, params[] ) {

  # If our global variable tells us to take an explicit action,
  # do it
  if ( serializePipelineOutput == 0 ) {
    # do nothing; fall through
  }

  # Always use small-job (build in memory) approach.
  else if ( serializePipelineOutput == 1 ) {
    return 0;
  }

  # Always use large-job (build on disk) approach.
  else if ( serializePipelineOutput == 2 ) {
    return 1;
  }

  # Invalid value; build on disk; slower, but guaranteed to work.
  else {
    return 1;
  }

  # The global variable didn't provide any clues.  See if we have
  # a composition parameter that tells us what to do.
  local paramValue = params[ "compose.serializePipelineOutput" ];

  if ( paramValue == "" || paramValue == 0 ) {
    # do nothing; fall through
  }

  # Always use small-job (build in memory) approach.
  else if ( paramValue == 1 ) {
    return 0;
  }

  # Always use large-job (build on disk) approach.
  else if ( paramValue == 2 ) {
    return 1;
  }

  # Invalid value; build on disk; slower, but guaranteed to work.
  else {
    return 1;
  }

  # No global variable, no parameter.  See if the big job threshold
  # option provides clues.
  local threshold = doc_get( doc, "bigjobthreshold" );

  # If we're not supposed to consider any jobs "big", we're done
  if ( threshold == "off" || threshold == "-1" ) {
    return 0;
  }

  # If the value is less than zero, round to the maximum integer.
  if ( threshold < 0 ) {
    threshold = 0x7fffffff;
  }

  # Get the number of docfrags in this document
  local fragCount = doc_estimate_dfs( doc );

  # Make sure it's not negative.  But make it less than maxint.
  if ( fragCount < 0 ) {
    fragCount = 0x7ffffffe;
  } else if( doc_type_dita( doc ) == 2 ) {
    # for DITA composition what matters is the size of the RDS
    # rather than the size of the DITA map, so estimate that size
    # by multiplying the map size by a multiplier
    fragCount *= compose::ditaMapBigJobMultiplier;
    if ( fragCount < 0 ) {
      fragCount = 0x7ffffffe;
    }
  }

  # If there are more frags than the threshold, it's a big job.
  if ( fragCount > threshold ) {
    return 1;
  }

  # Use small job processing.
  return 0;
}

# ---------------------------------------------------------------------
# Function:	comp_dvi :: setupSerializerParameters
#
# Purpose:	sets content pipeline parameters to direct the
#		final serializer to build its output in memory
#		or on disk.
#
#		This routine supports any composer that has a _switch
#		filter that directs output to either an epic_serializer
#		or a file_serializer filter depending upon a parameter
#		named "processingType".
#
#		Note that this routine is only called when E3 composition
#		is off.  If a remote server is going to do the work,
#		then the local machine doesn't have enough data to
#		determine whether the remove server can safely build
#		the resulting document in memory.
#
# Parameters:	doc:	document being composed
#		params:	associative array of composer parametrs
#		type:	0:	output document should have same doctype as
#				the input document;
#
#				(may be modified for DITA maps; see below)
#
#			1:	if the output document should be an XSL-FO
#				document;
#
#			2:	if the output document should be a DITA
#				preliminary resolved dataset
#
# Result:	params[ "docID" ]:			"" or temporary
#							 output document
#
#		params[ "serializedOutputFile" ]:	temporary output
#							file
#
#		params[ "processingType" ]:		"smallDoc" or
#							"bigDoc"
#
#		params[ "compose.serializePipelineOutput" ]:
#							0 if nothing
#							will be written
#							to disk, 1 otherwise
#
# Returns:	1:	success
#		0:	failure
# ---------------------------------------------------------------------
function compose::setupSerializerParameters( doc,			\
					     params[],			\
					     type			\
					   ) {

  # Determine whether this is a "small" or "big" document.  For small
  # documents, we build the pipeline output in memory, for large documents
  # we build the pipeline output on disk.
  #
  # 0:  serialize to memory
  # 1:  serialize to disk
  local serializePipeline = compose::doSerializePipelineOutput( doc, params );

  # Set a parameter indicating what we're going to do.
  params[ "compose.serializePipelineOutput" ] = serializePipeline;

  # We must always allocate a temporary document; the file serializer will
  # complain otherwise.
  #
  # If we're running on behalf of the server side of E3 composition, generate
  # the temporary file in the directory that will contain the .dvi, .tex, and
  # other formatter output files, so we can return it to the client for
  # debugging purposes.
  local tempDir     = "";
  local e3OutputDir = params[ "e3.outputDirectory" ];

  if ( e3OutputDir != "" ) {
    tempDir = e3OutputDir;
  }

  params[ "serializedOutputFile" ] = epicutil::temporary_file( tempDir,	\
							       ".xml"	\
							     );

  compose::debug_out( "compose::setupSP:  created tempfile '"		\
		      . params[ "serializedOutputFile" ]		\
		      . "'."						\
		    );


  # if we're building in memory:
  if ( !serializePipeline ) {

    # If we're supposed to create an output document of the same type as the
    # input document and the input document is a DITA map, then create an
    # output document of type RDStyle.
    local vdocType = type;

    if ( vdocType == 0 && doc_type_dita( doc ) == 2 ) {
      vdocType = 2;
    }

    # If we're STILL supposed to create an output document of the same type
    # as the input document, and we're formatting with an old style (.fos)
    # stylesheet, allow the VDOC to be SGML if the input document its.
    local cvdFlags = 0;

    if ( vdocType == 0							\
	 && _ssutils::_IsFosiPath( params[ "stylesheet" ] )		\
       ) {
      cvdFlags |= CVD_ALLOW_SGML;
    }

    compose::queueVdocCreation(vdocType, doc, cvdFlags, params);

    params[ "processingType" ] = "smallDoc";

    # Delete these parameters; file serializer won't run, so it won't need them
    delete( params[ "html.entSubFname" ] );
    delete( params[ "text.entSubFname" ] );
    delete( params[ "xml.entSubFname"  ] );
  }

  # Not building in memory:  build on disk.
  else {

    params[ "processingType"	   ] = "bigDoc";

    # Resolve these parameters; the file serializer will need them.
    local path_keys[];

    path_keys[ "html.entSubFname" ] = 1;
    path_keys[ "xml.entSubFname"  ] = 1;
    path_keys[ "text.entSubFname" ] = 1;

    # Resolve on the local machine; e3 composition is disabled.
    compose::resolve_path_parameters( path_keys,			\
				      params,				\
				      option('composerpath')		\
				    );
  }

  # Fosi engine handles change tracking natively (better than pipeline).
  # However DITA processing always resolves change markup to latest so
  # for now the filter must continue to convert the atict markup.
  if ( params[ "stylesheetPrintEngine" ] == "fosi" && !uses_dita_composition( doc ) ) {
    params[ "atictFilter.disable" ] = "true";
  }

  return 1;
}

# ---------------------------------------------------------------------
# Function:	compose :: encodeNonasciiCharacters
#
# Purpose:	Replaces every character > 127 with xhhhh, where hhhh is the
#		hex representation of the character.
#
# Parameters:	inString:	string to encode
#
# Result:	encoded string
# ---------------------------------------------------------------------
function compose::encodeNonasciiCharacters( inString ) {

  # Encode filename, replacing blanks and characters greater than 127.
  # We escape characters as _hh, not %hh, to avoid having some downstream
  # parts of the code re-encode the % sign.
  local result = filename_encode( inString, "_", 1 );

  return result;
}

# ---------------------------------------------------------------------
# Function:	closeTempWrapMap
#
# Purpose: Close the document, docToProcess, if the parameter
#          closeWrappedDoc indicates it should.  If closeWrappedDoc
#          is > 0, then it contains the ID of the previous current doc
#          and needs to be restored.
#
# Parameters:  closeWrappedDoc: should the temp map be closed
#              docToProcess:    temp map doc id
# ---------------------------------------------------------------------
function closeTempWrapMap(closeWrappedDoc, docToProcess) {

  if (closeWrappedDoc > 0 && docToProcess != -1) {
    # Close wrapped map.
    doc_close(docToProcess);
    current_doc(closeWrappedDoc);
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: preprocessForDita
#
# Purpose:	Translates the document being composed into a DITA
#		Preliminary Resolved Data Set, adjusting the
#		composition pipeline parameters as appropriate.
#
#		Should only be called if doc_type_dita( doc ) == 1 or 2.
#
# Parameters:	doc:			document to be composed
#		params:			composition parameters
#		ditaTopicAlreadyWrapped: Indicates that the DITA topic has
#					already been wrapped as a topic ref
#					in a temporary map.
#		tempMap:		temporary map ID if
#					ditaTopicAlreadyWrapped is 1.
#
# Result:
#		-2:	error already displayed to user
#		-1:	user cancelled
#		0:	error, abort composition operation
#		1:	success
#
# Leaves traces in the content pipeline parameters so that
# compose :: postprocessForDita can clean up again.
# ---------------------------------------------------------------------
function compose::preprocessForDita( doc,				\
						params[],				\
						ditaTopicAlreadyWrapped,		\
						tempMap				\
						) {

	# SPR 2214078:  don't check for DITA application on the PE server.  It's
	# part of the Editor from 6.1 onwards.
	local e3Composition = params[ P_COMP_E3COMPOSITION ];

	# Construct parameters for transformation process here.
	local ditaParams[];

	if (params["changetracking"] == "") {
		params[ "changetracking" ] = compose::setupChangeTracking( doc );
	}
	ditaParams[ "dita.TopicChangeTracking" ] = params["changetracking"];

	# If the caller didn't specify otherwise, we'll ask the DITA preprocessor
	# to write its temporary files into the document's APTCACHE directory.
	# That means we won't need to delete them; the automatic cache deleter
	# will get them.
	if ( params[ P_DITA_FILE_PATH ] == "" ) {
		ditaParams[ "filePath" ] = doc_cache_dir( doc, 1 );
	}
	else {
		ditaParams[ "filePath" ] = params[ P_DITA_FILE_PATH ];
	}

	if (ditaTraceLevel > 0) {
		ditaParams['ditaTraceLevel'] = ditaTraceLevel;
	}

#  if (ditaTraceLevel > 0 && option('ditavaldebug') == 'on') {
#    ditaParams['debugMode'] = 'true';
#    ditaParams["ditavalDebugMode"] = ditaParams['debugMode'];
#  }

	# Copy the DITAVAL file parameter from the incoming set.
	if (params['ditavalFile']) {
		local ditavalFile = params['ditavalFile'];
		if (!is_cms_url(ditavalFile) && !is_absolute_path(ditavalFile)) {
			local resolved = find_file_in_path(ditavalFile, "er", option('ditapath'));
			if (resolved) {
				ditavalFile = resolved;
			}
		}
		ditaParams[ "ditavalFile" ] = ditavalFile;
	}

	if (params['ditavalDocId']) {
		ditaParams['ditavalDocId'] = params['ditavalDocId'];
	}

	if (params['ditavalDebugMode']) {
		ditaParams['ditavalDebugMode'] = params['ditavalDebugMode'];
	}

	if (params['debugMode']) {
		ditaParams['debugMode'] = params['debugMode'];
	}

	# At the beginning of each composition, clear the DITAVAL rule cache, set the RDS Policy

	java_static("com.arbortext.epic.saxfilter.dita.ditaval.DITAVALFilter", "initOldRDSPolicy");

	# If the caller specified a particular location for the dynmically-generated
	# doctype files, pass that along
	ditaParams[ P_DITA_DYNAMIC_DTD_FILE_PATH ] =				\
		params[ P_DITA_DYNAMIC_DTD_FILE_PATH ];

	# The DITA preprocessor uses the parameters 'outputDirectory' and
	# 'ditaLinksHref' to process files which are referenced by a DITA map
	# or topic but which can not be included directly in the ultimate output.
	# Most composition types specify values for these directly.
	ditaParams[ "outputDirectory" ] = params[ "dita.linksDirectory" ];
	ditaParams[ "ditaLinksHref" ] = params[ "dita.linksHref" ];

	# The DITA Preprocessor now sets profiles. Must pass in the profile parameters
	ditaParams["prof.logicalExpression"] = params["prof.logicalExpression"];
	ditaParams["prof.targetAttributes"] = params["prof.targetAttributes"];
	ditaParams["prof.ProfilePIName"] = params["prof.ProfilePIName"];
	ditaParams["prof.ProfileValuesPIName"] = params["prof.ProfileValuesPIName"];

	# Don't download graphics from CMS may be set
	ditaParams[ "dontDownloadGraphics" ] = params[ "dontDownloadGraphics" ];

	# If we don't have the values we need, see if we have an output file,
	# an output directory, or both.
	if ( ditaParams[ "outputDirectory" ] == "" ) {

		if ( params[ "outputFile" ] != "" ) {
			ditaParams[ "outputDirectory" ] = params[ "outputFile" ]		\
								.".ditaLinks";
			ditaParams[ "ditaLinksHref" ] = "." . main::PCS			\
	. basename( ditaParams[ "outputDirectory" ] );
			params[ "dita.deleteEmptyLinksDirectory" ] = 1;
		}
		else if ( params[ "outputDir" ] != "" ) {
			ditaParams[ "outputDirectory" ] = params[ "outputDir" ];
			ditaParams[ "ditaLinksHref" ] = "." . main::PCS;
			params[ "dita.deleteEmptyLinksDirectory" ] = 0;
		}
		else {
			ditaParams[ "outputDirectory" ] = ditaParams[ "filePath" ];
			ditaParams[ "ditaLinksHref"	 ] = "." . main::PCS;
			params[ "dita.deleteEmptyLinksDirectory" ] = 0;
		}
	}

	compose::info( "DITA links directory is '"				\
		 . ditaParams[ "outputDirectory" ]			\
		 . "'."							\
				 );

	compose::info( "DITA links href is '"					\
		 . ditaParams[ "ditaLinksHref" ]			\
		 . "'."							\
				 );

	# If the dita links directory doesn't exist, create it unless our
	# caller has suppressed doing so.
	if ( !access( ditaParams[ "outputDirectory" ], "e" )			\
			 && !params[ "dita.suppressLinksDirCreation" ]			\
			 && !epicutil::mkdir_recursive( ditaParams[ "outputDirectory" ] )	\
		 ) {
		error( "Failed to create output DITA link directory '"		\
		 . ditaParams[ "outputDirectory" ]						\
		 . "'."							\
	 );
		return 0;
	}

	msg( agettext( "Preprocessing DITA map document..." ),		\
			 params								\
		 );

	# Add parameters for the DITA Cascading Attribute Filter
	# Always a Map to start off (even when topic being composed)
	ditaParams["Dita.ProcessingType"] = "Map";
	# Get the chTocDisabled so won't always have to get it.
	ditaParams["Dita.ChTocDisabled"] = dita::getditaComposeChTocDisabled();

	# If we are composing a topic, then create a temporary map with
	# a topic ref to the topic and compose the map instead.
	local docToProcess = doc;
	local closeWrappedDoc = -1;
	ditaParams[ "ditaWrapTopic" ] = "false";
	if (dita::_composeTopicAsMap() == 1) {
		if (ditaTopicAlreadyWrapped == 1 || doc_type_dita(doc) == 1) {
			if (ditaTopicAlreadyWrapped == 1) {
				# The topic (doc) has already been wrapped.	Use the
				# temp map ID.
				docToProcess = tempMap;
				ditaParams[ "dita.wrappedTopic" ] = doc;
			}
			else {
				# This is a topic type.
				# Wrap it in a map as a topic reference and continue processing.
				docToProcess = dita::wrap_topic(doc);
			}
			if (docToProcess != -1) {
				# Make the temp map the current doc and remember
				# to close it at the end.
				closeWrappedDoc = current_doc(docToProcess);
				# Tell the dita PRDS preprocess filter that the map is
				# actually just a topic wrap.
				ditaParams[ "ditaWrapTopic" ] = "true";
			}
			else {
				error( agettext( "Failed to translate DITA topic document to PRDS." ));
				return 0;
			}
		}
	}

	ditaParams["Dita.DocumentCanonicalPath"] = doc_path(docToProcess);
	ditaParams["ditaSourceMap"] = docToProcess;

	if ("ditaCopyExternalResource" in params) {
		ditaParams["ditaCopyExternalResource"] = params["ditaCopyExternalResource"];
	}

	ditaParams[ "controlFile" ] = params['controlFile'];

	# "ditaIncludeTopicsNotInMap" is the parameter that is used
	# to traverse all links to all topics, whether they are
	# included in the map or not.
	# When set to "false" only the topics DIRECTLY referenced from
	# a topic included in the map will be included in the
	# ReferredTopics section of the RDS.
	# When set to "true" all topics referenced from any topics
	# will be included in the ReferredTopics section of th RDS.
	# This could cause potentially many extra topics to be included.
	if (params[ "ditaIncludeTopicsNotInMap" ] == "") {
			ditaParams[ "ditaIncludeTopicsNotInMap" ] = "false";
			params[ "ditaIncludeTopicsNotInMap" ] = "false";
	}
	else {
		ditaParams[ "ditaIncludeTopicsNotInMap"] = \
			params[ "ditaIncludeTopicsNotInMap" ]
	}

	# Specify a styled elements file for use by the create_prds pipeline.
	# If we're composing with PE

	# SPR 1814219:	don't do this with PE composition enabled; the
	# stylesheet is on the PE server, and the styled elements file
	# is needed on the client.

	# This isn't quite right:	if the styled elements file is blank,
	# DITA processing will use the default stylesheet for the doctype
	# as the styled elements file.	If certain settings (white space,
	# table markup, others) differ between the default stylesheet and
	# the stylesheet that's used for composition, results could be strange.
	if ( !e3Composition ) {
		ditaParams[ P_DITA_STYLED_ELEMENTS_FILE ] = params[ "originalStylesheet" ];
	}

	# Specify the styled elements file for use by the outer pipeline.
	if ( params[ P_DITA_STYLED_ELEMENTS_FILE ] == "" ) {
		params[ P_DITA_STYLED_ELEMENTS_FILE ] = params[ "originalStylesheet" ];
	}

	# Make sure that there's no 'e3:' prefix
	if ( substr( params[ P_DITA_STYLED_ELEMENTS_FILE ], 1, 3 ) == "e3:" ) {
		params[ P_DITA_STYLED_ELEMENTS_FILE ] = \
			substr( params[ P_DITA_STYLED_ELEMENTS_FILE ], 4 );
	}

	# Set the Default xml:lang to be used by PRDS processing.
	if (!defined(ditaParams["Dita.DefaultLanguage"])) {

		local defaultLang = dita::_getDefaultLanguageInComposition();
		if (!defaultLang || tolower(defaultLang) == "stylesheet") {
			local styleSheet = ditaParams[P_DITA_STYLED_ELEMENTS_FILE];
			if (styleSheet) {
				defaultLang = defaultLang::stylesheet_file_default_lang(styleSheet);
			}

			if (!styleSheet || !defaultLang) {
				styleSheet = doc_default_stylesheet_path(0, doc);
				if (styleSheet) {
					defaultLang = defaultLang::stylesheet_file_default_lang(styleSheet);
				}

				if (!styleSheet || !defaultLang) {
					defaultLang = defaultLang::get_language_default(doc);
				}
			}
		}

		defaultLang::_setDefaultAttrInComposition("",defaultLang);
		ditaParams["Dita.DefaultLanguage"] = defaultLang;
		params["Dita.DefaultLanguage"] = defaultLang;
	}

	# add composition type to ditaParams. (used to filter out elements based
	# on thier print attribute)
	ditaParams["prds.compose.compositionType"] = params[P_COMP_TYPE];
	ditaParams[P_DITA_USE_NEW_RDS] = 0;

	# Convert our document to a PRDS
	local rc = compose::compose_for_createprds( docToProcess, ditaParams );

	# If rc == -2, we do not want to clear the status message
	if ( rc != -2 ) {
		msg( agettext( "DITA map preprocessing complete." ),		\
	 params								\
			 );
	}

	# See if links directory is empty
	local files[];
	local linksDirectoryEmpty = 0;

	if ( 0 == glob( ditaParams[ "outputDirectory" ] . main::PCS . "*",	\
			files							\
		)							\
			 ) {
		linksDirectoryEmpty = 1;
	}

	# If the links directory is empty, delete it if we're allowed to do so
	if ( linksDirectoryEmpty ) {
		if ( params[ "dita.deleteEmptyLinksDirectory" ] ) {
			remove_file( ditaParams[ "outputDirectory" ] );
			compose::info( "Deleted empty dita links directory.", 0 );
		}
	}

	# If links directory is non-empty and we're composing with PE, make
	# directory location globally visible so we can pass it to PE.
	else {
		if ( e3Composition ) {
			params[ "ditaLinksClientDir"	] = ditaParams[ "outputDirectory" ];
			params[ "ditaLinksHrefPrefix" ] = ditaParams[ "ditaLinksHref"	 ];
		}
	}

	# Exit if conversion failed
	if ( rc == -2) {
		return -2;
	}
	else if ( rc != 1 ) {
		error( agettext( "Failed to translate DITA map document to PRDS." ) );
		return 0;
	}

	# Grab the ID of the PRDS.
	params[ P_DITA_PRDS_ID ] = ditaParams[ P_DOC_ID ];

	if ( !doc_valid( params[ P_DITA_PRDS_ID ] ) ) {

		error( "Translation to PRDS succeeded, but returned document ID '"	\
		 . params[ P_DITA_PRDS_ID ]					\
		 . "' is invalid."						\
	 );
		return 0;
	}

	# Copy the RDS doctype information from the DITA preprocessor parameters,
	# which are updated with the values. Handles both pre-configured RDS and
	# runtime-generated RDS.
	params[ P_DITA_RDS_KEYWORD ] = ditaParams[ P_DITA_RDS_KEYWORD ];
	params[ "ditaRDSStorage" ] = ditaParams[ "ditaRDSStorage" ];
	params[ "ditaRDSIdentifier" ] = ditaParams[ "ditaRDSIdentifier" ];
	params[ "ditaRDSRootElement" ] = ditaParams[ "ditaRDSRootElement" ];

	# Make sure this is available up the stack.
	if (ditaParams[ "dita.dynamicRDS" ] == "true") {
		params[ "dita.dynamicRDS" ] = "true";
	}

	# Save the original document ID and substitute the ID of the PRDS
	# as the document that the pipeline should handle.
	params[ "dita.mapID" ] = params[ "document" ];
	params[ "document"	 ] = params[ P_DITA_PRDS_ID ];

	# Enable the DITA processing filters in the content pipeline
	params[ P_DITA_PROCESSING ] = "true";

	# Specify the location of the directory containing the files associated
	# with the PRDS
	params[ "ditaFilePath" ] = ditaParams[ "filePath" ];

	# Remember what kind of DITA document this is
	params[ P_DITA_DOCTYPE ] = "map";

	# Resolve conrefs
	# Set to false 01/13/2012 DAH (Post Processing does not need this)
	params[ "resolveDitaConref" ] = "false";

	# if the caller didn't specify the parameter, turn on unstyled
	# element generalization
	if ( params[ P_DITA_GENERALIZE_UNSTYLED ] == "" ) {
		params[ P_DITA_GENERALIZE_UNSTYLED ] = "yes";
	}

	if ("ditaCloned" in ditaParams) {
		params[ "ditaCloned" ] = ditaParams[ "ditaCloned" ];
	}

	# Save the PRDS and its doctype for debugging.
	compose::saveIntermediateDocument( compose::getTraceObject( params ),	\
						 params[ P_DITA_PRDS_ID ],		\
						 "prds."				\
						 . doc_kind( params[ P_DITA_PRDS_ID ] ), \
						 "resolved doc for styling"		\
					 );

	if ( params[ "dita.dynamicRDS" ] == "true" ) {
		compose::saveIntermediateFile( compose::getTraceObject( params ),	\
					 params[ "ditaRDSStorage" ],		\
					 "text/xml",				\
					 "RDS doctype"			\
				 );
	}

	return 1;
}

# ---------------------------------------------------------------------
# Function:	compose :: postprocessForDita
#
# Purpose:	Cleans up the parameters and documents that preprocessForDita
#		may have created.
#
#		Note that this routine may be called from the Java layer
#		if we're composing with PE.	Any changes made to the
#		'params' array will not be propagated to the rest of the
#		composition process.
#
# Parameters:	doc:	document being composed
#		params:	composition parameters
#
# Result:	1:	success
# ---------------------------------------------------------------------
function compose::postprocessForDita( doc, params[] ) {

	# Exit if we're not composing a DITA map.
	if ( params[ P_DITA_DOCTYPE ] != "map" ) {
		return 1;
	}

	# Close the PRDS file.
	doc_close( params[ P_DITA_PRDS_ID ] );

	debug_out( "Closed DITA vdoc '" . params[ P_DITA_PRDS_ID ] . "'." );

	return 1;
}

# ---------------------------------------------------------------------
# Function:	compose :: preprocessForNewRDS
#
# Purpose:	translates the DITA map document being composed into
#		a DITA Reolved Document for Styling.
#
# Parameters:	doc:		document being composed
#		params:		associative parameter array
#
# Result:	-2:	error, message displayed/logged
#		-1:	user cancelled
#		0:	error, no message displayed/loged
#		1:	success, continue composition operation
# ---------------------------------------------------------------------
function compose::preprocessForNewRDS( doc, params[] ) {

	# Assume that 'doc' is the map to publish
	local docToProcess = doc;

	# E3 composition?
	local e3Composition = params[ P_COMP_E3COMPOSITION ];

	# Pass parameters to the RDS-producing content pipeline
	local ditaParams[];			# Parameter array for RDS pipeline
	local justCopy[];			# Copy these; no special processing

	# Set the ultimate compostion type so the print attribute filter can
	# be set appropriately
	ditaParams["RDS.compositionType"] = params[P_COMP_TYPE];

	# If there's no change tracking parameter, initialize it, then
	# (SPR 5221506) pass it for use on both the map and on every topic.
	if (params["changetracking"] == "") {
	  params[ "changetracking" ] = compose::setupChangeTracking( doc );
	}

	ditaParams[ "changetracking"		] = params[ "changetracking" ];
	ditaParams[ "dita.TopicChangeTracking"	] = params[ "changetracking" ];

	# If the caller didn't specify otherwise, we'll ask the DITA RDS processor
	# to write its temporary files into the document's APTCACHE directory.
	# That means we won't need to delete them; the automatic cache deleter
	# will get them.

	if ( params[ P_DITA_FILE_PATH ] == "" ) {
		ditaParams[ "filePath" ] = doc_cache_dir( doc, 1 );
	}
	else {
		ditaParams[ "filePath" ] = params[ P_DITA_FILE_PATH ];
	}

	if (ditaTraceLevel > 0) {
	 		ditaParams['ditaTraceLevel'] = ditaTraceLevel;
		}

	# If 'doc' is a topic, then we've wrapped the topic in a temporary map.
	# Process that instead.
	if ( params[ P_TOPIC_ALREADY_WRAPPED ] ) {
		docToProcess = params[ P_TEMP_MAP ];
		ditaParams["optionInfoParams.TopicAsMap"] = "on";
	}
	else {
		ditaParams["optionInfoParams.TopicAsMap"] = "off";
	}

	# Copy the DITAVAL file parameter
	if ( params[ P_DITAVAL_FILE ] ) {
		local ditavalFile = params[ P_DITAVAL_FILE ];

		if ( !is_cms_url( ditavalFile )					\
	 && !is_absolute_path( ditavalFile )				\
			 ) {
			local resolved = find_file_in_path( ditavalFile,			\
						"er",				\
						option( 'ditapath' )		\
					);
			if ( resolved ) {
	ditavalFile = resolved;
			}
		}

		ditaParams[ P_DITAVAL_FILE ] = ditavalFile;
	}

	justCopy[ P_DITAVAL_DOC_ID	 ] = 1;
	justCopy[ P_DITAVAL_DEBUG_MODE ] = 1;

	# Copy profiling
	justCopy[ P_PROFILE_LOGICAL_EXPRESSION ] = 1;

	# Graphic downloading
	justCopy[ P_DONT_DOWNLOAD_GRAPHICS ] = 1;

	# Pass our 'interactive' flag; if we're interactive, then, while
	# the RDS generation process has no dialog to display, it'll show
	# its progress monitor.
	justCopy[ P_COMP_INTERACTIVE ] = 1;

	# Copy the parameters that require no special handling
	local key;

	for ( key in justCopy ) {
		if ( defined( params[ key ] ) ) {
			ditaParams[ key ] = params[ key ];
		}
	}

	# COPIED FROM THE PRDS PREPROCESSOR as this needs to be sent along
	# to the outer pipeline

	# Specify a styled elements file for use by the create_prds pipeline.
	# If we're composing with PE

	# SPR 1814219: don't do this with PE composition enabled; the
	# stylesheet is on the PE server, and the styled elements file
	# is needed on the client.

	# This isn't quite right: if the styled elements file is blank,
	# DITA processing will use the default stylesheet for the doctype
	# as the styled elements file. If certain settings (white space,
	# table markup, others) differ between the default stylesheet and
	# the stylesheet that's used for composition, results could be strange.

	if ( !e3Composition ) {
		ditaParams[ P_DITA_STYLED_ELEMENTS_FILE ] = params[ "originalStylesheet" ];
	}

	local dflt = params["UseReferenceHook"];
	if ( dflt == "" ) {
		dflt = (dita::_getReferencePathCallbackActive(doc) == 0) ? "off" : "on";
	}
	ditaParams["optionInfoParams.UseReferencePathHook"] = dflt;
	ditaParams["UseReferencePathHook"] = dflt;

	dflt = ( params[ P_COMP_SUPPRESS_DATA_MERGE ] )			\
					? "off"							\
		: params[ "UseDataMerge" ];

	if (dflt == "" ) {
		dflt = ( is_datamerge_enabled(doc) == 0) ? "off" : "on";
	}
	ditaParams["optionInfoParams.UseDataMerge"] = dflt;
	ditaParams["UseDataMerge"] = dflt;
	ditaParams[ P_COMP_SUPPRESS_DATA_MERGE ]			\
		= params[ P_COMP_SUPPRESS_DATA_MERGE ];

	ditaParams[ "optionInfoParams.ditaTraceLevel" ] = ditaTraceLevel;

	# Set up the no merge attributes (and no override)
	local noMerge = dita::_getNoMergeAttributes();
	if (noMerge != "") {
		local attrs[];
		split(noMerge, attrs, ",");
		local attrList = "";
		local nattrs = 0;
		local attrs_index;
		for (attrs_index = 1; attrs_index <= count(attrs); attrs_index++) {
			if (attrs[attrs_index] == "") {
				continue;
			}

			if (index(attrList,";".attrs[attrs_index].";") > 0) {
				continue;
			}

			if (nattrs <= 0) {
				attrList = ";" . attrs[attrs_index] . ";";
				nattrs = 1000;
			}
			else {
				attrList .= attrs[attrs_index] . ";";
			}
		}
		if (attrList != "") {
			ditaParams["optionInfoParams.noMergeAttributes"] = attrList;
			ditaParams["noMergeAttributes"] = attrList;
		}
	}

	# Specify the styled elements file for use by the outer pipeline.
	if ( params[ P_DITA_STYLED_ELEMENTS_FILE ] == "" ) {
		params[ P_DITA_STYLED_ELEMENTS_FILE ] = params[ "originalStylesheet" ];
	}

	# Make sure that there's no 'e3:' prefix
	if ( substr( params[ P_DITA_STYLED_ELEMENTS_FILE ], 1, 3 ) == "e3:" ) {
		params[ P_DITA_STYLED_ELEMENTS_FILE ] = \
			substr( params[ P_DITA_STYLED_ELEMENTS_FILE ], 4 );
	}

	# Set the Default xml:lang to be used by RDS processing.
	if ( !defined(ditaParams["defaultLang"]) ) {
		if ( !defined(params["Dita.DefaultLanguage"]) ) {
			local defaultLang = dita::_getDefaultLanguageInComposition();
			if (!defaultLang || tolower(defaultLang) == "stylesheet") {
				local styleSheet = ditaParams[P_DITA_STYLED_ELEMENTS_FILE];
				if (styleSheet) {
					defaultLang = defaultLang::stylesheet_file_default_lang(styleSheet);
				}

				if (!styleSheet || !defaultLang) {
					styleSheet = doc_default_stylesheet_path(0, doc);
					if (styleSheet) {
						defaultLang = defaultLang::stylesheet_file_default_lang(styleSheet);
					}

					if (!styleSheet || !defaultLang) {
						defaultLang = defaultLang::get_language_default(doc);
					}
				}
			}
			ditaParams["defaultLang"] = defaultLang;
			params["Dita.DefaultLanguage"] = defaultLang;
		}
		else {
			ditaParams["defaultLang"] = params["Dita.DefaultLanguage"];
		}
	}

	# if the caller didn't specify the parameter, turn on unstyled
	# element generalization
	if ( params[ P_DITA_GENERALIZE_UNSTYLED ] == "" ) {
		params[ P_DITA_GENERALIZE_UNSTYLED ] = "yes";
	}

	# The DITA processing uses the parameters 'ditaLinksDirectory' and
	# 'ditaLinksHref' to process files which are referenced by a DITA map
	# or topic but which can not be included directly in the ultimate output.
	# Most composition types specify values for these directly.
	ditaParams[ "ditaLinksDirectory" ] = params[ "dita.linksDirectory" ];
	ditaParams[ "ditaLinksHref" ] = params[ "dita.linksHref" ];
	if (defined(params[ "dita.deleteEmptyLinksDirectory" ]) ) {
		ditaParams[ "ditaDeleteEmptyLinksDirectory" ] = (params[ "dita.deleteEmptyLinksDirectory" ] ? "true" : "false");
		ditaParams[ "copyManagerParams.Managed"] = "false";
	}

	# If we don't have the values we need, see if we have an output file,
	# an output directory, or both.

	if ( ditaParams[ "ditaLinksDirectory" ] == "" ) {

		if ( params[ "outputFile" ] != "" ) {
			ditaParams[ "ditaLinksDirectory" ] = params[ "outputFile" ] . ".ditaLinks";
			ditaParams[ "ditaLinksHref" ] = "." . main::PCS . basename( ditaParams[ "ditaLinksDirectory" ] );
			ditaParams[ "copyManagerParams.Managed"] = "false";
			params[ "dita.deleteEmptyLinksDirectory" ] = 1;
			ditaParams[ "ditaDeleteEmptyLinksDirectory" ] = "true";
		}
		else if ( params[ "outputDir" ] != "" ) {
			ditaParams[ "ditaLinksDirectory" ] = params[ "outputDir" ];
			ditaParams[ "ditaLinksHref" ] = "." . main::PCS;
			ditaParams[ "copyManagerParams.Managed"] = "false";
			params[ "dita.deleteEmptyLinksDirectory" ] = 0;
			ditaParams[ "ditaDeleteEmptyLinksDirectory" ] = "false";
		}
		else {
			ditaParams[ "ditaLinksDirectory" ] = ditaParams[ "filePath" ];
			ditaParams[ "ditaLinksHref" ] = "." . main::PCS;
			ditaParams[ "copyManagerParams.Managed"] = "false";
			params[ "dita.deleteEmptyLinksDirectory" ] = 0;
			ditaParams[ "ditaDeleteEmptyLinksDirectory" ] = "false";
		}
	}

	ditaParams["copyManagerParams.ditaLinksRefPrefix"] = ditaParams["ditaLinksHref"];
	ditaParams["copyManagerParams.ditaLinksDirectory"] = ditaParams["ditaLinksDirectory"];
	if ( defined(ditaParams[ "ditaDeleteEmptyLinksDirectory" ]) ) {
		ditaParams["copyManagerParams.deleteEmptyLinksDirectory"] = ditaParams[ "ditaDeleteEmptyLinksDirectory" ];
	}

	if ( params[ "dita.suppressLinksDirCreation" ] ) {
		ditaParams[ "copyManagerParams.NoDirCreation" ] = "true";
	}

	compose::info( "DITA links directory is '" . ditaParams[ "ditaLinksDirectory" ] . "'." );

	compose::info( "DITA links href is '" . ditaParams[ "ditaLinksHref" ] . "'." );

	# If the dita links directory doesn't exist, create it unless our
	# caller has suppressed doing so.
	if ( !access( ditaParams[ "ditaLinksDirectory" ], "e" )			\
			 && !params[ "dita.suppressLinksDirCreation" ]			\
			 && !epicutil::mkdir_recursive( ditaParams[ "ditaLinksDirectory" ] )	\
		 ) {
		error( "Failed to create output DITA link directory '"		\
		 . ditaParams[ "ditaLinksDirectory" ]						\
		 . "'."							\
	 );
		return 0;
	}


	# Allocate a work directory. Unless instructed otherwise, put it in
	# the document's APTCACHE directory so it'll be deleted automatically.
	local tempParent = params[ P_DITA_TEMP_PARENT ];

	if ( tempParent != ""							\
			 && file_directory( tempParent )					\
			 && access( tempParent, "rw" )					\
		 ) {
	}
	else {
		tempParent = doc_cache_dir( docToProcess, 1 );
	}

	# Allocate a work directory. We need a different directory for each
	# operation because we can't reuse the _Files subdir.
	local workDir = epicutil::temporary_file( tempParent, "" );

	if ( !epicutil::mkdir_recursive( workDir ) ) {
		local msg = agettext( 'Failed to create RDS work directory "$workDir".' );
		set_errmessage( varsub( msg ) );
		return -1;
	}

	compose::info( varsub( agettext( 'Allocated "$workDir" as RDS work directory.') ) );


	params[ P_DITA_RDS_TEMPDIR ] = workDir;
	ditaParams[ P_DITA_RDS_TEMPDIR ] = workDir;

	# Allocate an output file
	local outputFile = main::temp_name( "rds", ".xml", workDir );

	ditaParams[ P_OUTPUT_FILE ] = outputFile;

	# Execute the pipeline
	debug_params( "Calling compose_for_newrds", ditaParams );

	local rc = compose::compose_for_newrds( docToProcess, ditaParams );

	# See if links directory is empty
	local files[];
	local linksDirectoryEmpty = 0;

	if ( 0 == glob( ditaParams[ "ditaLinksDirectory" ] . main::PCS . "*", files ) ) {
		linksDirectoryEmpty = 1;
	}

	# If the links directory is empty, delete it if we're allowed to do so
	if ( linksDirectoryEmpty ) {
		if ( params[ "dita.deleteEmptyLinksDirectory" ] ) {
			remove_file( ditaParams[ "ditaLinksDirectory" ] );
			compose::info( "Deleted empty dita links directory.", 0 );
		}
	}

	# If links directory is non-empty and we're composing with PE, make
	# directory location globally visible so we can pass it to PE.
	else {
		if ( e3Composition ) {
			params[ "ditaLinksClientDir" ] = ditaParams[ "ditaLinksDirectory" ];
			params[ "ditaLinksHrefPrefix" ] = ditaParams[ "ditaLinksHref" ];
		}
	}

	if ( rc == -2 ) {
		return -2;
	}
	else if ( rc != 1 ) {
		set_errmessage( agettext( "Failed to translate DITA map document to RDS." ) );
		return 0;
	}

	# Get and check the document ID of the RDS that should have been created.
	params[ P_DITA_RDS_ID ] = ditaParams[ P_DOC_ID ];

	if ( !doc_valid( params[ P_DITA_RDS_ID ] ) ) {
		local rdsID = params[ P_DITA_RDS_ID ];
		set_errmessage( varsub( agettext('Translation to RDS succeeded, but returned document ID "$rdsID" is invalid.')));
		return 0;
	}

	if ( params[ "ditaRDSKeyword" ] == "") {
		params[ "ditaRDSRootElement"	] = ditaParams[ "ditaRDSRootElement"	];
		params[ "ditaRDSKeyword"	] = ditaParams[ "ditaRDSKeyword"	];
		params[ "ditaRDSIdentifier"	] = ditaParams[ "ditaRDSIdentifier"	];
		params[ "ditaRDSStorage"	] = ditaParams[ "ditaRDSStorage"	];
	}

	# Save the original document ID and substitute the ID of the RDS
	# as the document that the pipeline should handle.
	params[ P_DITA_MAP_ID ] = params[ P_DOCUMENT ];
	params[ P_DOCUMENT ] = params[ P_DITA_RDS_ID ];

	# Specify the location of the directory containing the files associated with the RDS
	params[ "ditaFilePath" ] = ditaParams[ P_DITA_RDS_TEMPDIR ];

	local rdsDoc = params[ P_DOCUMENT ];
	local rdsPath = doc_path( rdsDoc );

	compose::info( varsub( agettext( 'RDS document (id $rdsDoc) is "$rdsPath".' ) ) );

	# Remember to close the map and delete the temporary directory.
	params[ P_DITA_SETUP_RDS ] = 1;
	params[ P_DITA_DOCTYPE ] = "map";

	return 1;
}


# ---------------------------------------------------------------------
# Function:	compose :: postprocessForNewRDS
#
# Purpose:	cleans up the parameters, directories, and documents
#		created by 'preprocessForNewRDS'
#
# Parameters:	doc:		document being composed
#		params[]:	associative composition parameter array
#
# Result:	1:	success
# ---------------------------------------------------------------------
function compose::postprocessForNewRDS( doc, params[] ) {

	# If 'preprocessForNewRDS' didn't set up, don't delete anything
	if ( !params[ P_DITA_SETUP_RDS ] ) {
		return 1;
	}

	# Get the original document and the ID of the RDS
	local rdsId = params[ P_DOCUMENT ];
	local mapId = params[ P_DITA_MAP_ID ];

	# Restore parameters
	params[ P_DOCUMENT ] = mapId;

	# Close the RDS document
	if (rdsId && doc_valid(rdsId)) {
			local msg;
		if ( doc_close( rdsId ) ) {
			msg = agettext( 'Closed RDS document "$rdsId".' );
		}
		else {
			msg = agettext( 'Failed to close RDS document "$rdsId".' );
	}
		compose::info( varsub( msg ) );
	}
	else {
		return 1;
	}

	# Try to delete the RDS work directory. This will include the RDS
	# and everything we copied in that it references.
	local rdsDir = params[ P_DITA_RDS_TEMPDIR ];

	if ( compose::debug == 0 ) {
		if ( remove_file( rdsDir, 1, 1 ) ) {
			local msg = agettext( 'Deleted RDS temporary directory "$rdsDir".' );
			compose::info( varsub( msg ) );
		}
		else {
			local msg = agettext( 'Failed to delete RDS temporary directory "$rdsDir".' );
			compose::info( varsub( msg ) );
		}
	}
	else {
		local msg = agettext( 'Did not delete RDS temporary directory "$rdsDir" (debugging).' );
		compose::info( varsub( msg ) );
	}

	# If we failed to delete the RDS work directory, it shouldn't be a
	# problem. We allocated it in APTCACHE, which will be deleted when
	# the document closes.

	# If we're a PE sub-process, APTCACHE is allocated in the sub-process
	# temporary directory, which is deallocated when the sub-process terminates,
	# so there's an extra guard against leaking files.

	return 1;
}

# ---------------------------------------------------------------------
# Function:	compose :: postprocessForDitaJava
#
# Purpose:	calls compose :: postprocessForDita from the Java layer.
#
# Parameters:	doc:	document being composed
#
# Result:	"ok"
# ---------------------------------------------------------------------
function compose::postprocessForDitaJava( doc ) {

	local params[];

	local mapObject = java_static( "com.arbortext.e3c.ClientComposer",	\
				 "getPostProcessorParameters"		\
						 );

	java_array_to_acl( mapObject, params );

	java_delete( mapObject );

	if ( params[ P_DITA_USE_NEW_RDS ] ) {
		debug_params( "compose::postprocessForDitaJava: calling new postprocessor", params );

		postprocessForNewRDS( doc, params );
	}
	else {
		debug_params( "compose::postprocessForDitaJava: calling old postprocessor", params );

	postprocessForDita( doc, params );
	}

	return "ok";
}

# ---------------------------------------------------------------------
# Function:	compose :: saveVdoc
#
# Purpose:	writes a document to the APTCACHE directory or to the
#		E3 output directory for debugging
#
# Parameters:	doc:		document to write
#		name:		absolute path to write to
#		flag:           indicate where return string
#
# Result:	string
# ---------------------------------------------------------------------
function compose::saveVdoc( doc, name, flag=0) {
  local save_doc = current_doc( doc );

  local myFile = "'" . name . "'";

  write -ok -pi $myFile;

  current_doc( save_doc );

  if ( !access( name, "e" ) ) {
    if(flag == 0)
    {
    	compose::error( "Failed to write vdoc file '" . name . "'.", 0 );
    }
    else
    {
    	return "Failed to write vdoc file '" . name . "'.";
    }
  }
  else {
    if(flag ==0 )
    {
    	compose::info( "Wrote vdoc file '" . name . "'." , 0 );
    }
    else
    {
       return "ok";
    }
  }

  return "ok";
}

# ---------------------------------------------------------------------
# Function:	compose :: getTraceObject
#
# Purpose:	extract the trace object from a collection of parameters
#
# Parameters:	params:		associative array of composition parameters
#
# Result:	-1:	if we're a PE sub-process processing a transaction
#			(this will result in intermediate files being saved
#			to the transaction directory)
#
#		null:	if no tracing was set up (i.e., debugcompostion=0ff
#
#		otherwise: we return a reference to the Java trace object
#		that will collect intermediate files
# ---------------------------------------------------------------------
function compose::getTraceObject( params[] ) {

  # If we're running as the server side of a PE composition operation,
  # return -1
  if ( main::is_e3 && option( "petransactiondirectory" ) != "" ) {
    return -1;
  }

  # Return trace object or null.
  return params[ "compose.traceObject" ];
}

# ---------------------------------------------------------------------
# Function:	compose :: saveIntermediateFile
#
# Purpose:	copies an intermediate file to either the underlying
#		PE transaction directory (if this is the server side
#		of a PE composition operation) or to an area accessible
#		to appsave (if this is the client side of a PE composition
#		operation or a standalone operation)
#
# Parameters:	traceObject:	object that makes the entry (may be null)
#				or -1 if we're the server side of a
#				PE composition operation)
#		path:		absolute path to file
#		contentType:	MIME type of file content, or ""
#		description:	short description or ""
#
# Result:	none
# ---------------------------------------------------------------------
function compose::saveIntermediateFile( traceObject,			\
					path,				\
					contentType,			\
					description			\
				      ) {

  # If we're running on the PE server in response to a client pe-tie
  # request:
  if ( traceObject == -1 ) {
    PEAppConfig::addIntermediateFile( path, contentType, description );
  }

  # If we're running on the client side or standalone, only save files
  # if we started tracing when the operation began.
  else if ( traceObject != "" && traceObject != 0 ) {
    java_instance( traceObject,						\
		   "addIntermediateFile",				\
		   path,						\
		   contentType,						\
		   description						\
		 );
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: saveIntermediateDocument
#
# Purpose:	saves an intermediate document to disk in either
#		the underlying transaction directory (if this is the
#		server side of a PE composition operation) or to an area
#		accessible to appsave (if this is the client side of a
#		PE composition operation or a standalone operation).
#
# Parameters:	traceObject:	object that makes the entry, null, or -1
#		doc:		document to save
#		name:		filename to use (not absolute)
#		description:	description of file
#
# Result:	none
# ---------------------------------------------------------------------
function compose::saveIntermediateDocument( traceObject,		\
					    doc,			\
					    name,			\
					    description			\
					  ) {
  if ( traceObject == -1 ) {
    PEAppConfig::addIntermediateDocument( doc, name, description );
  }
  else if ( traceObject != "" && traceObject != 0 ) {
    java_instance( traceObject,						\
		   "addIntermediateDocument",				\
		   doc,							\
		   name,						\
		   description						\
		 );
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: clientOlderThan
#
# Purpose:	indicates whether (a) a pe-tie operation is in progress,
#		(b) this is the server side of the operation and (c)
#		whether the client is old enough to require special
#		processing.
#
# Parameters:	targetVersion:		oldest acceptable version
#		params:			composition parameter array
#
# Result:	1:  client is older than the target version
#		0:  client isn't older, or this isn't a server operation
# ---------------------------------------------------------------------
function compose::clientOlderThan( targetVersion, params[] ) {

  # If this is not the server side of a pe-tie operation, we're done
  if ( params[ "e3.serverComposition" ] != 1 ) {
    return 0;
  }

  # If the client didn't tell us its version, then we know it's older
  # than 5.3 F000.
  local clientVersion = params[ "e3.clientVersionNumber" ];

  if ( clientVersion == "" ) {
    clientVersion = "5.2 M999";
  }

  # See if the client version is older than our target
  local result = _custom::compare_versions( clientVersion,		\
					    targetVersion		\
					  );

  # return 1 if client is older
  if ( result == -1 ) {
    return 1;
  }

  return 0;
}

# ---------------------------------------------------------------------
# Function:	compose :: getLocales
#
# Purpose:	initializes the locale selection data for composition
#		types which allow the user to choose a locale.
#
# Parameters:	doc:		document being composed
#		params:		associative parameter array
#		localeIndex:	(result) index of initial selection
#		locales:	(result) array of allowed locales
#
# Result:	"ok" or error message
# ---------------------------------------------------------------------
function compose::getLocales( doc, params[], &localeIndex, locales[] ) {

  # Clear our result array
  empty_array( locales );

  local localeCount = 0;
  local paramData[];

  # If we're running locally, try to obtain the list of legal locales
  # from our composer
  if ( !params[ P_COMP_E3COMPOSITION ] ) {
    composer_get_parameter_info( paramData,				\
				 params[ "compose.composer" ],		\
				 "locale"				\
			       );
  }

  # If we're composing with PE, obtain the list of legal locales from
  # the compconfig document.
  else {
    local rc = compconfig::getCompositionParameterInfo(			\
		 paramData,						\
		 params[ P_COMP_TYPE ],					\
                 doc,							\
                 "locale"						\
  	       );

    if ( rc == 0 ) {
      compose::add_warning( "Composer does not define parameter 'locale'.", \
			    params[ "interactive" ]			\
			  );
    }
  }

  # If the parameter exists and is an enumeration, get its legal values
  if ( paramData[ "enumeration" ] != "" ) {
    localeCount = split( paramData[ "enumeration" ], locales, '|' );
  }
  else {
    compose::add_warning("Parameter 'locale' undefined or not an enumeration.",\
			 params[ "interactive" ]			\
			);
  }

  # If we have no locales, return a list of one locale, and start out
  # by selecting it.
  if ( localeCount == 0 ) {
    locales[ 1 ] = "en";
    localeIndex = 1;
    return "ok";
  }

  # Determine the locale specified by the document we're composing
  local docLocale = _ssutils::getDocLang(doc);

  # Define doc lang to UI locale mappings for a couple cases where the two aren't usually exact matches
  local locale_alias[];  # index is doc language; value is corresponding UI locale
  locale_alias['zh-Hans'] = 'zh';
  locale_alias['zh_CN'] = 'zh';
  locale_alias['zh-Hant'] = 'zh_TW';
  locale_alias['zh-tw'] = 'zh_TW';

  # Determine the locale we're running under.
  local ourLocale = java_static( "java.lang.System",			\
				 "getProperty",				\
				 "user.language"			\
			       );

  if ( ourLocale == "" ) {
    ourLocale = "en";
  }

  # Scan the list of allowable locales to find
  # (a) the index of the one specified in the document;
  # (b) the index of the one we're running under;
  # (c) the index of "en".
  local docIndex = -1;
  local ourIndex = -1;
  local enIndex  = -1;
  local i;

  for ( i = 1; i <= localeCount; i += 1 ) {

    if ( docLocale != "" && \
         (docLocale == locales[ i ] || \
          locale_alias[docLocale] != "" && locale_alias[docLocale] == locales[ i ] ) ) {
      docIndex = i;
    }

    if ( ourLocale == locales[ i ] ) {
      ourIndex = i;
    }

    if ( "en" == locales[ i ] ) {
      enIndex = i;
    }
  }

  # If we found the locale specified by the document, return it
  if ( docIndex != -1 ) {
    localeIndex = docIndex;
  }

  # No match for the document Locale.  If we found the system locale,
  # return that.
  else if ( ourIndex != -1 ) {
    localeIndex = ourIndex;
  }

  # No match for the system locale.  If we found 'en', use that.
  else if ( enIndex != -1 ) {
    localeIndex = enIndex;
  }

  # No match for "en", either.  Default to the first locale the composer
  # accepts.
  else {
    localeIndex = 1;
  }

  return "ok";
}


# ---------------------------------------------------------------------
# Function:	compose :: includeUserID
#
# Purpose:	Called by the operation-specific parameter callback function
#		when composing with PE.
#
#		Adds user ID information to queued transactions.
#
# Parameters:	params:		parameter array
#		paramsType:	parameter type array
#
# Result:	none
# ---------------------------------------------------------------------
function compose::includeUserID( params[], paramsType[] ) {

  # Get ID preference.  If there is none, use the current user ID.
  local userId = preference( "pecompositionid" );
  if ( userId == "" ) {
    userId = username();
  }

  # Get the server's identification policy.
  local idName =							\
    compconfig::getServerParameter( "com.arbortext.e3."			\
				    . "compositionIdentificationPolicy"	\
				  );

  # If we're supposed to specify the caller's ID as an HTTP header
  if ( idName=='' || idName == 'header' ) {
    paramsType[ "from" ] = 'http-header';
    params[     "from" ] = userId;
  }

  # Pass USER id as a query parameter.
  else {
    paramsType[ idName ] = 'http';
    params[     idName ] = userId;
  }

  # If we're not queuing this transaction, we're done.
  if ( params[ P_COMP_QUEUE ] != "yes" ) {
    return;
  }

  # We are queuing; add notification email if calle wants it.

  # Get server policy on how to supply email address.
  local queueEmailName =						\
    compconfig::getServerParameter( "com.arbortext.e3.compositionEmailPolicy");

  if ( queueEmailName != '' ) {
    local compositionEmail = preference( "pecompositionemail" );

    if ( compositionEmail != "" )   	{
      params[     queueEmailName ]= compositionEmail;
      paramsType[ queueEmailName ] = 'http';
    }
  }

  # Get the default transaction name and transaction type code appropriate
  # to this operation.  If there is none, don't supply a transaction name.
  local defaultTransactionName, transactionNameType;

  if ( queuedtransname::getNameData( params[ P_COMP_TYPE ],		\
				     params[ P_COMP_SUBTYPE ],		\
				     defaultTransactionName,		\
				     transactionNameType		\
				   )					\
     ) {

    # Include transaction name specification, if there is one
    if ( params[ P_TRANSACTION_NAME ] == "" ) {
      params[ P_TRANSACTION_NAME ] = defaultTransactionName;
    }

    # If we have a queued transaction name, substitute values into it.
    if ( params[ P_TRANSACTION_NAME ] != "" ) {

      # Iterate, substituting values for any wildcards.
      # Here are the wildcards we should look for and the values to substitute:
      local ourSubs[];

      ourSubs[ '$d' ] = doc_name( params[ P_COMP_DOCUMENT ] );
      ourSubs[ '$o' ] = transactionNameType;
      ourSubs[ '$u' ] = userId;

      # Iterate over the list of wildcards.
      local sub;

      for ( sub in ourSubs ) {

	# Iterate until the transaction name contains no substring matching
	# this wildcard.
	while ( 1 ) {

	  # Find an occurrence of this wildcard.  Exit if there are none.
	  local idx = index( params[ P_TRANSACTION_NAME ], sub );

	  if ( idx == 0 ) {
	    break;
	  }

	  # Replace wildcard with its value.
	  params[ P_TRANSACTION_NAME ] =				\
	    substr( params[ P_TRANSACTION_NAME ], 1, idx - 1 )		\
	    . ourSubs[ sub ]						\
	    . substr( params[ P_TRANSACTION_NAME ], idx + 2 )		\
    	    ;

	  # End of iteration; look for another occurrence of this wildcard.
	}

	# End of iteration; proceed with the next wildcard.
      }

      # Make sure that the transaction name is passed to the PE Request Manager
      # as an HTTP Query Parameter
      paramsType[ P_TRANSACTION_NAME ] = "http";
    }
  }

  # Include advanced transaction options, if any.
  local names[];
  local values[];
  local row;

  _transactionoptionsdlg::getCurrentOptions( names, values );

  for( row = 1; row <= count( names ); row++ ) {
    local name = names[ row ];
    params[     name ] = values[ row ];
    paramsType[ name ] = 'http';
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: setPrintParametersClient
#
# Purpose:	Called by compose :: setPrintParameters to do the first
#		stage of setting the composition parameters for printed
#		output types.
#
#		This code may is called when composing locally or on the
#		client side of a PE composition operation.  It is never
#		called when the PE server is executing the server side
#		of a PE composition operation.
#
#		This routine sets two composition parameters:
#
#		params[ "stylesheetPrintEngine" ]   and
#		params[ "stylesheetType" ]
#
# Parameters:	doc:		document being composed
#		params:		parameter array
#
# Result:	0:      error:  error message logged in composer log
#		1:	no error:  continue processing
#
# ---------------------------------------------------------------------
function compose::setPrintParametersClient( doc, params[] ) {
  local SHT = "stylesheet";
  local SPE = "stylesheetPrintEngine";
  local SST = "stylesheetType";

  local e3Composition = params[ P_COMP_E3COMPOSITION ];
  local interactive   = params[ P_COMP_INTERACTIVE   ];
  local suppressErrors= params[ "compose.suppressErrors" ];

  # If stylesheet ends in .xsl, use Ann Arbor engine, XSL pipeline path
  if ( _ssutils::_IsXslPath( params[ SHT ] ) ) {
    params[ SPE ] = "xsl-fo";
    params[ SST ] = "xsl";
    return 1;
  }

  # If stylesheet ends in .fos, use Ann Arbor engine, FOSI pipeline path
  if ( _ssutils::_IsFosiPath( params[ SHT ] ) ) {
    params[ SPE ] = "fosi";
    params[ SST ] = "fosi";
    return 1;
  }

  # If styleet ends in .3f, use APP engine and FOSI pipeline path.
  if ( _ssutils::_IsAppPath( params[ SHT ] ) ) {
    params[ SPE ] = "app";
    params[ SST ] = "fosi";
    return 1;
  }

  # Stylesheet name must end in .style; if not, we can't handle it.
  if ( !_ssutils::_IsStylerPath( params[ SHT ] ) ) {
    local x    = params[ SHT ];
    local msg  = agettext( "Stylesheet '$x' has an extension other "	\
			   . "than '.style', '.fos', '.xsl', or '.3f'. "\
			   . "Unknown stylesheet type."			\
			 );
    local msg1 = varsub( msg );
    if ( !suppressErrors ) {
      compose::set_errmessage( msg1, interactive );
    }
    return 0;
  }

  # At this point, we know the stylesheet has the extension '.style'.

  # Determine print engine override setting.  Even if we're composing
  # using PE, use the "override" value of the CLIENT machine.
  local engine = option( "printengineoverride" );

  if ( engine == "xslfo" ) {
    engine = "xsl-fo";
  }

  # If APP is installed, use APP engine and FOSI pipeline path
  if ( engine == "app" ) {
    params[ SPE ] = "app";
    params[ SST ] = "fosi";
    return 1;
  }

  # Override does not specify APP.  If it specifies FOSI or XSL-FO,
  # use them.
  if ( engine != "" && engine != "no" ) {
    params[ SPE ] = engine;
    params[ SST ] = ( engine == "fosi" ) ? "fosi" : "xsl";
    return 1;
  }

  # At this point, we know we have no override.

  # If we're in batch mode, the code that called compose_for_xxx() may have
  # specified an engine preference.  Since we're in batch mode, the dialog
  # callback didn't run, so that's the only way for the engine preference
  # to be set.
  if ( !interactive ) {
    if ( params[ SPE ] != "" ) {
      params[ SPE ] = tolower( params[ SPE ] );

      if ( params[ SPE ] == "xsfo" ) {
	params[ SPE ] = "xsl-fo";
      }

      if ( params[ SPE    ] != "default"				\
	   && params[ SPE ] != "app"					\
	   && params[ SPE ] != "fosi"					\
	   && params[ SPE ] != "xsl-fo"					\
	 ) {
	local x1   = params[ SPE ];
	local msg  = agettext( "Illegal value '$x1' passed for "	\
			       . "composition parameter "		\
			       . "'stylesheetPublishingEngine'.  "	\
			       . "Legal values are 'app', 'fosi', or "	\
			       . "'xsl-fo'."				\
			     );
	local msg1 = varsub( msg );

	if ( !suppressErrors ) {
	  compose::set_errmessage( msg1, interactive );
	}

	return 0;
      }

      # If caller wants APP, use it and specify the FOSI path through
      # the content pipeline.
      if ( params[ SPE ] == "app" ) {
	params[ SPE ] = "app";
	params[ SST ] = "fosi";
	return 1;
      }

      # Caller wants Ann Arbor engine.  Use it.
      if ( params[ SPE ] != "default" ) {
	params[ SST ] = ( params[ SPE ] == "fosi" ) ? "fosi" : "xsl";
	return 1;
      }
    }
  }

  # No override, no batch-mode parameter.  Check the stylesheet specification.

  # If we're composing with PE, then the dialog callback will have
  # supplied the stylesheet's 'print-engine' specification.

  # If we're the PE client or composing locally, then we need to read
  # the stylesheet and find the print engine specification.
  if ( params[ SPE ] == "" ) {
    if ( !e3Composition ) {
      local title;
      local desc;
      local uses;
      local version;
      local errmsg;

      local rc = main::stylesheet_path_get_id( params[ SHT ],		\
					       title,			\
					       desc,			\
					       uses,			\
					       version,			\
					       engine,			\
					       errmsg			\
					     );
      if ( rc == 0 ) {

	local x1    = params[ SHT ];
	local x2    = errmsg;
	local msg  = agettext( "Unexpected error reading print engine "	\
			       . "specification from stylesheet "	\
			       . "'$x1'.  Message = '$x2'."		\
			   );
	local msg1 = varsub( msg );
	if ( !suppressErrors ) {
	  compose::set_errmessage( msg1, interactive );
	}
	return 0 ;
      }
    }
    else {
      local ssName = compconfig::getStylesheetName( doc, params[ SHT ] );

      if ( ssName == "" ) {
	local x1    = params[ SHT ];
	local msg  = agettext( "Unexpected error getting name of "	\
			       . "PTC Arbortext Publishing Engine stylesheet with path '$x1' to "	\
			       . "determine print engine.  Assuming "	\
			       . "'default' for engine."		\
			     );
	local msg1 = varsub( msg );
	if ( !suppressErrors ) {
	  compose::add_warning( msg1, interactive );
	}

	engine = "default";
      }
      else {
	engine = compconfig::getStylesheetPrintEngine( doc, ssName );

	if ( engine == "" ) {
	  local x1    = params[ SHT ];
	  local msg  = agettext( "Unexpected error reading print "	\
			       . "engine specification from PTC Arbortext Publishing Engine "	\
			       . "stylesheet '$x1'.  Assuming "		\
			       . "'default'."				\
			     );
	  local msg1 = varsub( msg );
	  if ( !suppressErrors ) {
	    compose::add_warning( msg1, interactive );
	  }

	  engine = "default";
	}
      }
    }

    params[ SPE ] = engine;
  }

  # Clean the stylesheet's print-engine value up a bit.
  params[ SPE ] = tolower( params[ SPE ] );

  if ( params[ SPE ] == "xslfo" ) {
    params[ SPE ] = "xsl-fo";
  }

  if ( params[ SPE      ] != ""						\
       && params[ SPE ] != "default"					\
       && params[ SPE ] != "app"					\
       && params[ SPE ] != "fosi"					\
       && params[ SPE ] != "xsl-fo"					\
     ) {
    local x1   = params[ SHT ];
    local x2   = params[ SPE ];
    local msg  = varsub(agettext( "Stylesheet '$x1' specifies an illegal "\
                                  . "value ('$x2') for the print engine.  "\
                                  . "Assuming 'default'."		\
                                ));
    if ( !suppressErrors ) {
      compose::add_warning( msg, interactive );
    }

    params[ SPE ] = "default";
  }

  # If APP requested, use it and specify the FOSI path through the
  # content pipeline
  if ( params[ SPE ] == "app" ) {
    params[ SPE ] = "app";
    params[ SST ] = "fosi";
    return 1;
  }

  # If we have a specification, use it.
  if ( params[ SPE ] != "" && params[ SPE ] != "default" ) {
    params[ SST ] = ( params[ SPE ] == "fosi" ) ? "fosi" : "xsl";
    return 1;
  }

  # Engine not specified in stylesheet.  Default to APP if present,
  # else FOSI.
  # NOTE:  printenginedefault is gone in Pine
  params[ SPE ] = "app";
  params[ SST ] = "fosi";
  return 1;
}

# ---------------------------------------------------------------------
# Function:	compose :: setPrintParameters
#
# Purpose:	Sets composition parameters when composing to print
#		output types (compose for PDF, print composed, preview).
#
#		params[ "stylesheetPrintEngine" ]
#
#		will be set to "fosi" or "app" to choose using the Ann Arbor
#		or Swindon engine.
#
#		params[ "stylesheetType" ]
#
#		will be set to "fosi", "xsl", or "style".
#
#		This determines the path through the content pipeline that
#		will be used IF a content pipeline is needed at all.
#
#		Note that we use the "fosi" path through the content pipeline
#		if the pipeline output will be translated by the Swindon
#		engine.
#
#		This parameter will only be set to "style" when using
#		PE composition; the PE server will need to open
#		the .style file and determine whether it contains an XSL
#		stylesheet or a FOSI.
#
#		For local composition, this parameter will always be set
#		to either "fosi" or "xsl".
#
#		params[ "stylesheet" ]
#
#		will be set to a temporary file containing an XSL stylesheet
#		if params[ "stylesheet" ] indicates a .style file and
#		we determine that we need to extract an XSL stylesheet.
#
# Parameters:	doc:		document being composed
#		params:		parameter array
#
# Result:	0:      error:  error message logged in composer log
#		1:	no error:  continue processing
#
# ---------------------------------------------------------------------
function compose::setPrintParameters( doc, params[] ) {
  local SHT = "stylesheet";
  local SPE = "stylesheetPrintEngine";
  local SST = "stylesheetType";

  local e3Composition = params[ P_COMP_E3COMPOSITION	 ];
  local e3ServerSide  = params[ "pe.serverComposition"   ];
  local interactive   = params[ P_COMP_INTERACTIVE	 ];
  local suppressErrors= params[ "compose.suppressErrors" ];

  # First-stage processing.  Skip this if we're the server side
  # of a PE composition operation; this work was done on the client.
  if ( !e3ServerSide ) {
    local rc = compose::setPrintParametersClient( doc, params );

    if ( rc != 1 ) {
      return rc;
    }
  }

  # If we're composing using PE, we're done; the rest of the work
  # will be done on the server.
  if ( e3Composition ) {
    return 1;
  }

  # We're composing locally.  If don't have a .style file, we're done.
  if ( !_ssutils::_IsStylerPath( params[ SHT ] ) ) {
    return 1;
  }

  # If our stylesheet type is XSL, then we need to try to extract an XSL
  # stylesheet of the appropriate type from our .style file.
  local needXsl = ( params[ SST ] == "xsl" ) ? 0 : 1;

  # If we're using the FOSI engine and a FOSI (as opposed to XSL) stylesheet
  # then we need a special search pattern in determining whether to reorder
  # tables.
  local needFosiTableReorderingExpression =				\
    ( ( params[ SPE ] == "fosi" && params[ SST ] == "fosi" ) ) ? 1 : 0;

  # Open our stylesheet (if necessary) and determine:
  #   a) whether to scale graphics;
  #   b) whether table rearrangement is needed;
  #   c) whether an XSL stylesheet is needed
  # Note that this may result in the value of params[ 'stylesheet' ]
  # changing; the original value will be in params[ 'orignalStylesheet' ]
  local rc = compose::setupStylesheet( doc,				\
				       params,				\
				       needXsl,				\
				       needFosiTableReorderingExpression\
				     );
  if ( rc == 1 ) {
    return 1;
  }

  # If we needed an XSL stylesheet and were unable to extract it:
  if ( needXsl && rc == 0 ) {

    # In batch mode, warn the user that we'll proceed using a FOSI
    if ( !interactive ) {
      local x    = params[ SHT ];
      local msg  = agettext( "Unable to extract an XSL stylesheet from "\
			     . "'$x'.  Extracting FOSI stylesheet "	\
			     . "instead."				\
			   );
      local msg1 = varsub( msg );

      if ( !suppressErrors ) {
	compose::warning( msg1 );
      }

      params[ SST ] = "fosi";
      return 1;
    }

    # In interactive mode, prompt user for permission to use .style as .fos
    local x    = params[ SHT ];
    local msg  = agettext( "Unable to extract an XSL stylesheet from "	\
			   . "'$x'."					\
			 );
    local msg1 = varsub( msg );
    local msg2 = agettext( "OK to publish using the stylesheet as a "	\
			   . "FOSI instead?"				\
			 );

    if ( 1 != response( varsub( msg1 ) . "\n\n" . msg2,			\
			agettext( "Yes" ),				\
			agettext( "No"  )				\
		      )							\
       ) {
      if ( !suppressErrors ) {
	compose::set_errmessage( msg1, interactive );
      }

      return 0;
    }
  }

  params[ SST ] = "fosi";
  return 1;
}

# ---------------------------------------------------------------------
# Function:	compose :: isEffectiveFosi
#
# Purpose:	called from core (cmdflz.c); indicates whether a given
#		stylesheet will be treated as a FOSI.
#
#		to do this, we construct a FAKE parameter list and
#		pass it to setPrintParameters.
#
# Parameters:	doc:		document being composed
#		stylesheet:	absolute path to stylesheet to test
#
# Result:	0:  stylesheet will not be used as a FOSI
#		1:  stylesheet will be treated as a FOSI
# ---------------------------------------------------------------------
function compose::isEffectiveFosi( doc, stylesheet ) {

  # Construct fake parameter list.
  local params[];

  params[ P_COMP_TYPE			] = "print";
  params[ "compose.suppressErrors"	] = 1
  params[ "e3.composition"		] = ( option( "peservices" ) == "on" )\
					    ? 1 : 0;
  params[ "interactive"			] = 0;
  params[ "pe.serverComposition"	] = 0;
  params[ "stylesheet"			] = stylesheet;

  # Determine how stylesheet will be used.
  local rc = compose::setPrintParameters( doc, params );

  # An error return probably means that the stylesheet print engine
  # specification doesn't match our notion of what's installed.  Return
  # 0:  the stylesheet isn't clearly a FOSI.
  if ( rc == 0 ) {
    return 0;
  }

  # If we were able to determine how the stylesheet might be used,
  # indicate whether it'll be used as a FOSI.
  if ( params[ "stylesheetPrintEngine" ] == "fosi"			\
       && params[ "stylesheetType" ] == "fosi"				\
     ) {
    return 1;
  }

  # Stylesheet is likely to be used as an XSL stylesheet, APP template, etc.
  return 0;
}

# ---------------------------------------------------------------------
# Function:	compose :: getEffectivePrintEngine
#
# Purpose:	determines which print engine will be used with a
#		stylesheet.
#
#		This routine is expected to be used only on a client
#		or standalone machine, not on the PE server.
#
# Parameters:
#
# Result:	"app", "fosi", or "xsl-fo"
# ---------------------------------------------------------------------
function compose::getEffectivePrintEngine( doc,				\
					   stylesheet,			\
					   compType,			\
					   defaultType			\
					 ) {
  # Construct fake parameter list
  local params[];

  params[ P_COMP_TYPE		    ] = compType;
  params[ "compose.suppressErrors"  ] = 1;
  params[ P_COMP_E3COMPOSITION      ] = ( option( "peservices" ) == "on" )\
					    ? 1 : 0;
  params[ "interactive"		    ] = 0;
  params[ "pe.serverComposition"    ] = 0;
  params[ "stylesheet"		    ] = stylesheet;

  local rc = compose::setPrintParametersClient( doc, params );

  local result = defaultType;

  if ( rc == 1 ) {
    result = params[ "stylesheetPrintEngine" ];
  }

  return result;
}

# ---------------------------------------------------------------------
# Function:	compose :: setupChangeTracking
#
# Purpose:	Returns the proper value for the "changetracking"
#		parameter in content pipelines.
#
#		We return "changeshighlighted", "changesapplied" or
#		"original" as specified by the 'viewchangetracking'
#		option.
#
# Parameters:	doc:	document being composed
#
# Result:	value for "changetracking" parameter
# ---------------------------------------------------------------------
function compose::setupChangeTracking( doc ) {

  local win	= doc_window( doc );

  local viewct	= win > 0						\
    ? window_get(win, "viewchangetracking")				\
    : option("viewchangetracking");

  return viewct;
}

# ---------------------------------------------------------------------
# Function:	compose :: setupIvPvGraphicTransform
#
# Purpose:	adds conversion rules for transforming ISOview and
#		ProductView graphics to a graphicTransform parameter.
#
# Parameters:	graphicTransform:	current value of parameter
#		forWeb:			1 -> composing to web or HTML
#					0 -> composing to RTF or PDF
#
# Result:	modified graphicTransform value
# ---------------------------------------------------------------------
function compose::setupIvPvGraphicTransform( graphicTransform, forWeb ) {

  # Retrieve ISOView and Product View file formats and change ';' to ','
  local iso = option( "isoviewfileformats" );
  local pv  = option( "creoviewfileformats" );

  gsub( ';', ',', iso );
  gsub( ';', ',', pv  );

  # Determine output types
  local ivTarget = "iview";
  local pvTarget = "cview";

  if ( !forWeb ) {
    ivTarget = "eps";
    pvTarget = "png";
  }

  local result = graphicTransform;

  # Creo View takes precedence over IsoView
  if ( pv != "" ) {
    if ( result != "" ) {
      result .= "|";
    }

    result .= pv . ":" . pvTarget;
  }

  if ( iso != "" ) {
    if ( result != "" ) {
      result .= "|";
    }

    result .= iso . ':' . ivTarget;
  }

  return result;
}

# ---------------------------------------------------------------------
# Function:	compose :: setupWebGraphicTransform
#
# Purpose:	adds conversion rules suitable for web-format output
#		(compose to HTML, compose to Web) to the graphicTransform
#		parameter.
#
# Parameters:	graphicTransform:	current value of parameter
#		convertIntelligent:	1 to convert intelligent graphics
#					0 to leave them alone
#
# Result:	modified graphicTransform value
# ---------------------------------------------------------------------
function compose::setupWebGraphicTransform( graphicTransform,		\
					    convertIntelligent		\
					  ) {

  local result = graphicTransform;

  # Retrieve and append our set option
  local gwt = option( "graphicwebtransform" );

  if ( gwt != "" ) {
    if ( result != "" ) {
      result .= "|";
    }

    result .= gwt;
  }

  # If we're not converting intelligent graphics, append rules for
  # ISOView and Product View graphics
  if ( !convertIntelligent ) {
    result = compose::setupIvPvGraphicTransform( result, 1 );
  }

  # Retrieve and append default web format
  local dwf = option( "graphicdefaultwebformat" );

  if ( dwf != "" ) {
    if ( result != "" ) {
      result .= "|";
    }

    result .= "+:" . dwf;
  }

  return result;
}

# ---------------------------------------------------------------------
# Function:	compose :: profileDocHook
#
# Purpose:	supplies the document ID of an alternate profile
#		configuration file to the C layer of the product
#		if the 'profileConfigFile' parameter is set.
#
# Parameters:	ID of document being composed
#
# Result:	-1 or document of alternate PCF file
# ---------------------------------------------------------------------
function compose::profileDocHook( doc ) {
  local d	 = -1;
  local ourCount = count( g_pcfDocument );

  if ( ourCount > 0 ) {
    d = g_pcfDocument[ ourCount ];
  }

	if (d != g_pcfLastOut) {
		local msg = agettext( "Returning alternate PCF document ID '$d'." );
		info( varsub( msg ) );
		g_pcfLastOut = d;
	}

  return d;
}

# ---------------------------------------------------------------------
# Function:	compose :: pushPcf
#
# Purpose:	pushes new alternate PCF control values onto the stack
#
# Parameters:	docId:		doc ID of alternate PCF or -1
#		doClose:	1 to close alternate PCF, 0 to leave open
#
# Result:	none
# ---------------------------------------------------------------------
function compose::pushPcf( docId, doClose ) {
  g_pcfDocument[ count( g_pcfDocument ) + 1 ]	= docId;
  g_pcfClose[ count( g_pcfClose ) + 1 ]		= doClose;
}

# ---------------------------------------------------------------------
# Function:	compose :: popPcf
#
# Purpose:	deletes the most recent set of PCF control values
#		from the stack and returns them
#
# Parameters:	docId:		doc ID of alternate PCF or -1
#		doClose:	1`to close alternate PCF, 0 to leave open
#
# Result:	none
# ---------------------------------------------------------------------
function compose::popPcf( &docId, &doClose ) {

  # Get number of entries on stack
  local ourCount = count( g_pcfDocument );

  # If stack is empty, return dummy values
  if ( ourCount < 1 ) {
    docId   = -1;
    doClose = 0;
  }

  # If stack isn't empty, return real values, then pop stack
  else {
    docId   = g_pcfDocument[ ourCount ];
    doClose = g_pcfClose[    ourCount ];

    delete( g_pcfDocument[ ourCount ] );
    delete( g_pcfClose[    ourCount ] );
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: setupPcf
#
# Purpose:	determines whether the composition parameters request
#		an alternate PCF.  Sets up a callback if so.
#
# Parameters:	params:	parameter array
#
# Result:	none
# ---------------------------------------------------------------------
function compose::setupPcf( params[] ) {

  # Exit if not alternate PCF file is specified.
  local pcfPath		= params[ P_PROFILE_CONFIG_FILE ];

  if ( pcfPath == "" ) {
    pushPcf( -1, 0 );
    return;
  }

  # If document is already open, assume it's valid and don't try
  # to close it below.
  local pcfDoc   = path_doc( pcfPath );
  local closePcf = 0;

  if ( pcfDoc != -1 ) {
    local msg = agettext( "Found open document '$pcfDoc' for "	\
			  . "alternate profile configuration file "	\
			  . "'$pcfPath'."				\
			);

    info( varsub( msg ) );
  }

  # PCF document isn't open.  Try to open it.
  else {
    # 0x001:  read-only
    # 0x100:  no FOSI
    # 0x200:  open as XML
    pcfDoc = doc_open( pcfPath, 0x001 + 0x100 + 0x200 );

    # If open failed, issue a warning and proceed without any
    # override.
    if ( !doc_valid( pcfDoc ) ) {
      local msg = agettext( "Failed to open alternate profile "	\
			    . "configuration file '$pcfPath'.  Using "\
			    . "default PCF for the doctype."		\
			  );
      warning( varsub( msg ) );

      pushPcf( -1, 0 );
      return;
    }

    # Document was opened successfully.  Remember to close it later.
    else {
      closePcf = 1;

      local msg = agettext( "Opened alternate profile configuration "	\
			    . "file '$pcfPath' as document '$pcfDoc'."\
			  );
      info( varsub( msg ) );
    }
  }

  # Save the current value of g_pcfDocument.
  pushPcf( pcfDoc, closePcf );
  _profile::add_profiledochook( "compose::profileDocHook", 1 );
}

# ---------------------------------------------------------------------
# Function:	compose :: teardownPcf
#
# Purpose:	undoes the work of setupPcf:  clears the hook (if one was
#		set), closes the document (if one was opened), pops the
#		values from the stack
#
# Parameters:	none
#
# Result:	none
# ---------------------------------------------------------------------
function compose::teardownPcf( ) {

  local pcfDoc, pcfClose;

  popPcf( pcfDoc, pcfClose );

  # If we had an override, remove hook and restore global value.
  if ( pcfDoc != -1 ) {
    _profile::remove_profiledochook( "compose::profileDocHook" );

    if ( pcfClose ) {
      doc_close( pcfDoc );

      local msg = agettext( "Closed alternate profile configuration "	\
			    . "document '$pcfDoc'."			\
			  );

      info( varsub( msg ) );
    }
  }
}

# ---------------------------------------------------------------------
# Function:	compose :: setupStylesheet
#
# Purpose:	sets up stylesheet-related parameters:
#
#		params[ "stylesheet" ]:		may be modified to point
#						to a temporary XSL stylesheet.
#
#		params[ "dontScaleGraphics" ]:	set to 'true' or 'false'
#						as specified by the stylesheet
#
#		params[ "customTable.disable: ]:set to 'true' or 'false'
#						as specified by the stylesheet
#						to disable or enable custom
#						table reordering
#
#		params[ "customTable.stylesheet" ]:
#						extracted from the stylesheet
#						if needed to reorder tables
#
# Parameters:	doc:		document being composed
#		params:		parameter array
#		doExtractXsl:	1 -> extract an XSL stylesheet appropriate
#				to this operation type and modify
#				params[ "stylesheet" ] to reference it
#		useFosiExpr:	1 -> to use a special "fosi only" xpath
#				expression in determining whether our
#				stylesheet specifies reordering
#
# Result:	0:		failure, message in composer log
#		1:		success, continue with the operation
# ---------------------------------------------------------------------
function compose::setupStylesheet( doc,					\
				   params[],				\
				   doExtractXsl,			\
				   useFosiExpr=0			\
				 ) {

  # Determine the type of stylesheet we need.
  local ssType = params[ P_COMP_TYPE ];

  if ( ssType == "htmlfile" ) {
    ssType = params[ P_COMP_SUBTYPE ];

    if ( ssType == "htmlfile" ) {
      ssType = "html";
    }
  }

  debug_out( "compose::setupStylesheet:  ssType = '"			\
	     . ssType							\
	     . "' stylesheet = '"					\
	     . params[ P_STYLESHEET ]					\
	     . "' doExtractXsl = '"					\
	     . doExtractXsl						\
	     . "' useFosiExpr = '"					\
	     . useFosiExpr						\
	     . "'."							\
	   );

  # We assume that we're running a local composition operation
  # (it's OK if we're the server side of a pe-tie request) and that
  # any DITA map expansion to a resolved document for styling has
  # already taken place.

  # Start by assuming no special processing.  We don't actually
  # need to set these parameters; by default the content pipeline
  # initialization does that.  Plus, _styler.acl may set them when
  # passing in a .xsl file that nonetheless requires table reordering.
  #params[ P_DONT_SCALE_GRAPHICS  ]	= "false";
  #params[ P_CUSTOM_TABLE_DISABLE ]	= "true";

  # If our stylesheet ISN'T a .style file, then we're done.  No special
  # processing, nothing to extract.
  if ( !_ssutils::_IsStylerPath( params[ P_STYLESHEET ] ) ) {
    debug_out( "compose::setupStylesheet:  not a .style file." );
    return 1;
  }

  # Track our progress.  Once we decide we're done, we set 'result'
  # to 0 or 1,  and, maybe, 'msg' to a message to log.
  local result	= -1;
  local msg	= "";

  # If we open the stylesheet, make sure we close it again
  local doClose	= 0;

  # If the stylesheet document doesn't exist, open the stylesheet and remember
  # to close it when we're done.
  local ssDoc   = path_doc( params[ P_STYLESHEET ] );

  # If there is no document, try to open the stylesheet
  if ( !doc_valid( ssDoc ) ) {
    # 0x002:  open read/write but don't lock file;
    # 0x010:  suppress completeness check
    # 0x020:  suppress parser error messages
    # 0x100:  open as an XML document
    # 0x200:  suppress stylesheet load
    # 0x400:  suppress missing doctype prompt
    local openFlags = 0x002 | 0x010 | 0x020 | 0x100 | 0x200 | 0x400;

    ssDoc = doc_open( params[ P_STYLESHEET ], openFlags );

    # If open failed, warn the user.  Composition will probably fail
    # later on, too.
    if ( !doc_valid( ssDoc ) ) {
      local x	= params[ P_STYLESHEET ];
      msg	= varsub( agettext( "Unable to open stylesheet '$x'." ) );
      result	= 0;
    }

    # Opening stylesheet succeeded
    else {
      debug_out( "compose::setupStylesheet:  opened stylesheet as doc '"\
		 . ssDoc						\
		 . "'."							\
	       );

      # Remember to close this document when we're done with it
      doClose = 1;

      # Check to make sure that the stylesheet is the latest version.
      # If we're running as a PE subprocess, don't warn the user about
      # saving changes.
      local emitMustSaveMsg = !main::is_e3;

      local rc              = main::styler_update( ssDoc,		\
						   emitMustSaveMsg,	\
						   1,			\
						   doc			\
						 );

      debug_out( "compose::setupStylesheet:  styler_update "		\
		 . "returned '"						\
		 . rc							\
		 . "'."							\
	       );

      # -1 = user cancel, 0 = error, 1 = update succeeded, 2 = no update needed
      if ( rc < 1 ) {
	result = 0;
      }

      # SPR 2034751:  if an update was needed, don't close the document;
      # if we're composing a DITA document, we'll be back through here
      # many times, and we don't want to prompt each time.
      if ( rc == 1 ) {
	doClose = 0;
      }
    }
  }

  # From this point on, if we opened ssDoc, we must close it again before
  # returning.

  # We're done if we've set 'result'
  if ( result == -1 ) {

    # See if we should suppress graphic scaling
    local psg_value =							\
      xpath_string( '/Styler/StyleSheetInfo/@preScaleGraphics',		\
		    ssDoc						\
		  );

    if ( psg_value == 'no') {
      params[ P_DONT_SCALE_GRAPHICS ] = 'true'
    }

    debug_out( "compose::setupStylesheet: dontScaleGraphics = '"	\
	       . params[ P_DONT_SCALE_GRAPHICS ]			\
	       . "'."							\
	     );

    # See if we must invoke table reordering.  Note that we request
    # a special search expression if we're composing using the FOSI
    # engine and a FOSI (as opposed to XSL) stylesheet.
    if ( _stylerfixtables::stylesheet_requires_table_fixup( ssDoc,	\
							    useFosiExpr \
							  )		\
       ) {

      # The stylesheet does require reordering.  See if we can get
      # an XSL stylesheet to do the work.
      local reorderSS =							\
	compose::getXslFromStylerPath( params[ P_STYLESHEET ],		\
				       'tablefixXSL',			\
				       doc,				\
				       "",				\
				       useFosiExpr,			\
				       params				\
				     );

      # If extraction failed, set a warning message; DON'T force an error,
      # just set up so we'll warn the user if nothing more important
      # goes wrong.
      if ( reorderSS == "" ) {
	x	= params[ P_STYLESHEET ];
	msg	= agettext( "Unable to extract table-reordering "	\
			    . "stylesheet from '$x'.  No table "	\
			    . "reordering will be performed."		\
			  );
	msg	= varsub( msg );
      }

      # If we got a table-reordering stylesheet, remember to use it.
      else {
	params[ P_CUSTOM_TABLE_DISABLE	  ] = "false";
	params[ P_CUSTOM_TABLE_STYLESHEET ] = reorderSS;

	debug_out( "compose::setupStylesheet:  customTable.disable = '"	\
		   . params[ P_CUSTOM_TABLE_DISABLE ]			\
		   . "'."						\
		 );

	debug_out( "compose::setupStylesheet:  customTable.stylesheet = '"\
		   . params[ P_CUSTOM_TABLE_STYLESHEET ]		\
		 );
      }
    }

    # Now extract the stylesheet that will control true document formatting
    # from our .style file.
    local ssPath =							\
      compose::getXslFromStylerPath( params[ P_STYLESHEET ],		\
				     ssType,				\
				     doc,				\
				     params[ P_STYLESHEET_ENGINE ],	\
				     0,					\
				     params				\
				   );

    if ( ssPath == "" ) {
      local x = ssType;
      local z = params[ P_STYLESHEET ];

      msg = agettext( 'Failed to extract $x-producing XSL stylesheet '	\
		      . "from '$z'.  Style file may be out of date."	\
		    );

      msg    = varsub( msg );
      result = 0;
    }
    else {
      params[ P_STYLESHEET ] = ssPath;

      debug_out( "compose::setupStylesheet:  stylesheet = '"		\
		 . params[ P_STYLESHEET ]				\
		 . "'."							\
	       );

      result = 1;
    }
  }

  # If we opened the stylesheet document, then close it again
  if ( doClose ) {
    queueStylesheetClose( params, ssDoc );
  }

  # If we have a message, it's a warning if we're returning 1, and an
  # error if we're returning 0.
  if ( msg != "" ) {
    if ( result == 0 ) {
      set_errmessage( msg, params[ P_COMP_INTERACTIVE ] );
    }
    else {
      warning( msg );
    }
  }

  return result;
}

# ---------------------------------------------------------------------
# Function:	compose :: queueStylesheetClose
#
# Purpose:	remembers to close a stylesheet later
#
# Parameters:	params:		composition parameter array
#		ssDocId:	document ID of stylesheet to close
#
# Result:	none
# ---------------------------------------------------------------------
function compose::queueStylesheetClose( params[], ssDocId ) {

  # Exit if stylesheet document ID isn't valid
  if ( !doc_valid( ssDocId ) ) {
    compose::debug_out( "compose::queueStylesheetClose:  document '"	\
			. ssDocId					\
			. "' is not valid."				\
		      );
    return;
  }

  local docPath = doc_path( ssDocId );

  local ssSet[];

  # If we already have entries in our list, retrieve them
  if ( params[ P_COMP_STYLESHEETS_TO_CLOSE ] != "" ) {
    epicutil::UnserializeKeyed( params[ P_COMP_STYLESHEETS_TO_CLOSE ], ssSet );
  }

  # See if this document was already queued.
  if ( ssSet[ ssDocId] != "" ) {
    compose::debug_out( "compose::queueStylesheetClose:  document '"	\
		      . ssDocId						\
		      . "' ('"						\
		      . docPath						\
		      . "') is already queued."				\
		    );
    return;
  }

  # Remember to close THIS stylesheet.
  ssSet[ ssDocId ] = 1;

  # Stow the set in our parameter array
  params[ P_COMP_STYLESHEETS_TO_CLOSE ] = epicutil::SerializeKeyed( ssSet );

  compose::debug_out( "compose::queueStylesheetClose:  queued "		\
		      . "document '"					\
		      . ssDocId						\
		      . "' ('"						\
		      . docPath						\
		      . "')."						\
		    );
}

# ---------------------------------------------------------------------
# Function:	compose :: closeQueuedStylesheets
#
# Purpose:	closes the stylesheets queued via calls to
#		queueStylesheetClose().
#
# Parameters:	params:		composition parameter array
#
# Result:	none
# ---------------------------------------------------------------------
function compose::closeQueuedStylesheets( params[] ) {

  # Exit if no closures are queued
  if ( params[ P_COMP_STYLESHEETS_TO_CLOSE ] == "" ) {
    compose::debug_out( "compose::closeQueuedStylesheets:  empty list." );
    return;
  }

  # Get array of stylesheets to close
  local ssSet[];

  epicutil::UnserializeKeyed( params[ P_COMP_STYLESHEETS_TO_CLOSE ], ssSet );

  # Iterate over list
  local ssDocId;

  for ( ssDocId in ssSet ) {
    if ( !doc_valid( ssDocId ) ) {
      compose::debug_out( "compose::closeQueuedStylesheets:  "		\
			  . "document '"				\
			  . ssDocId					\
			  . "' is invalid."				\
			);
    }
    else {
      local docPath = doc_path( ssDocId );
      doc_close( ssDocId );

      compose::debug_out( "compose::closeQueuedStylesheets:  "		\
			  . "closed document '"				\
			  . ssDocId					\
			  . "' ('"					\
			  . docPath					\
			  . "')."					\
			);
    }
  }

  # We could delete params[ P_COMP_STYLESHEETS_TO_CLOSE ] here, but
  # leaving it alone is benign (at most, if we get called again, we'll
  # complain about a bunch of invalid documents) and it might be useful
  # for debugging.
}

# ---------------------------------------------------------------------
# Function:	WarnOnMissingCreoView
#
# Purpose:	Determines whether CreoView is likely to be needed
#		during the current composition operation and issues
#		a warning if it's not installed.
#
#		The caller is responsible for only calling this routine
#		after determining that the operation would require
#		conversion of ProductView/CreoView graphics to another
#		format, if any are present.
#
#		This routine expects to only be called when CreoView
#		is needed on the local machine.
#
# Parameters:	doc:		document being composed
#		peSide:		1 if we're the server-side of a PE
#				composition operation
#
# Result:	none
# ---------------------------------------------------------------------
function compose::warnOnMissingCreoView( doc, peSide ) {

  # See if CreoView is installed.  If it is, there's no reason to complain.
  if ( _compconfig::is_creoview_installed() ) {
   return;
  }

  # See if we're using isoview to handle .pvz and .edz files; if so, there's
  # no need for CreoView.
  local isoOption = option( "isoviewfileformats" );
  local gotPvz	 = 0;
  local gotEdz	 = 0;
  local iso[];
  local isoCount = split( isoOption, iso, ';' );
  local i;

  for ( i = 1; i <= isoCount; i += 1 ) {
    if ( iso[ i ] == "pvz" ) {
      gotPvz = 1;
    }
    else if ( iso[ i ] == "edz" ) {
      gotEdz = 1;
    }
  }

  if ( gotPvz && gotEdz ) {
    return;
  }

  # Scan our document.  If it doesn't contain any files with a 'cview' viewer,
  # no need for CreoView
  local foundPv		= 0;
  local saveDoc		= current_doc( doc );

  # Make sure that document has a position.
  if ( oid_caret() == oid_null() ) {
    goto_oid( oid_first() );
  }

  # Save the current position in the document.
  main::save_point( 2 );

  # Loop over document, stopping at each graphic element.
  goto_oid( oid_first() );

  for ( ;; ) {
    # Save our current position.
    local initialPos = oid_current_tag();

    # Move forward to the next graphic element.
    execute( "find -gr -nowrapscan" );

    # If we didn't move, there are no more graphics.  Exit loop.
    local newPos = oid_current_tag();

    if ( newPos == initialPos ) {
      break;
    }

    # If this is a ProductView/CreoView graphic, we know that the document
    # contains at least one such graphic.  One is enough, so exit the loop.
    local viewer = oid_graphic_viewer( newPos );

    if ( viewer == "cview" ) {
      foundPv = 1;
      break;
    }

    # End of loop; continue with next graphic.
  }

  # Restore point and document
  restore_point( 2 );

  current_doc( saveDoc );

  # If the document contains at least one ProductView graphic, we're
  # going to need to convert it, and conversion is likely to fail.
  if ( foundPv ) {
    local msg;

    if ( peSide ) {
      msg = "Document contains .pvz or .edz graphics that will "	\
	    . "require conversion but PTC Creo View is not installed "	\
	    . "on the PTC Arbortext Publishing Engine server.  Some graphics may be missing in "	\
	    . "the output.";
    }
    else {
      msg = "Document contains .pvz or .edz graphics that will "	\
	    . "require conversion but PTC Creo View is not installed.  Some "\
	    . "graphics may be missing in the output.";
    }

    compose::warning( agettext( msg ) );
  }
}

# ---------------------------------------------------------------------
# Initialize the compose.acl package.
# ---------------------------------------------------------------------
init();

# Local Variables:
# tab-width: 8
# End:
